# 依存パッケージとビルドの出力
node_modules/
dist/
.astro/

# 秘密の情報（APIキー、トークン、認証情報）は置かない。GitHubのSecretsに入れる（要件定義書2.7）
.env
.env.*
.dev.vars
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
credentials*.json
service-account*.json
secrets*
.wrangler/

# 原資料束は公開リポジトリに入れない（要件定義書6.4）
/bundles/
/bundle-*/

# ログ
*.log
npm-debug.log*

# OS、エディタ
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
.claude/settings.local.json

# wranglerの出力ファイル（公開の記録の元データ）
wrangler-output*.json
wrangler-output*.ndjson

# Python
__pycache__/
*.pyc
