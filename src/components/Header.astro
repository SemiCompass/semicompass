---
// ヘッダー（8.1）。濃紺の帯。左にロゴとサイト名、右に主要メニュー（config/menu.yaml の順）と検索欄。
// スマートフォン：主要メニューは「メニュー」で開閉し、検索欄は2段目に常に出す。ヘッダーは画面に張り付けない
// タブレット：検索欄の代わりに、検索のページへのリンク（虫めがねの記号と「検索」）を置く。PC：検索欄
import { loadMenu, isCurrent } from '../lib/menu';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import SearchBox from './SearchBox.astro';

const { main } = loadMenu();
const pathname = Astro.url.pathname;
---

<header class="site-header">
  <div class="container site-header__bar">
    <a class="site-header__brand" href="/">
      <Logo />
      <span class="site-header__name">SemiCompass</span>
    </a>

    <details class="site-header__fold">
      <summary class="site-header__toggle" aria-expanded="false">
        <span>メニュー</span>
        <Icon name="chevron-down" />
      </summary>
      <ul class="site-menu site-menu--fold" aria-label="主要メニュー">
        {main.map((item) => (
          <li>
            <a href={item.path} aria-current={isCurrent(item.path, pathname) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
    </details>

    <nav class="site-header__nav" aria-label="主要メニュー">
      <ul class="site-menu">
        {main.map((item) => (
          <li>
            <a href={item.path} aria-current={isCurrent(item.path, pathname) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="site-header__search">
      <SearchBox />
    </div>
    <a class="site-header__search-link" href="/search/"><Icon name="search" /><span>検索</span></a>
  </div>
</header>

<style>
  @import "../styles/breakpoints.css";

  .site-header {
    background: var(--color-brand);
    color: var(--color-on-brand);
  }
  .site-header__bar {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas: "brand fold" "search search";
    align-items: center;
    column-gap: var(--space-4);
    padding-block: 0 var(--space-3);
  }
  .site-header__brand {
    grid-area: brand;
    min-width: 0;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--header-height-sp);
    color: var(--color-on-brand);
    text-decoration: none;
  }
  .site-header__brand:visited {
    color: var(--color-on-brand);
  }
  /* スマートフォン（幅360pxでも、サイト名が切れずに収まる）：文字を、導入の大きさにする */
  .site-header__name {
    white-space: nowrap;
    font-size: var(--text-lead);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--text-lead-tracking);
  }
  .site-header__fold {
    grid-area: fold;
    justify-self: end;
    position: relative;
  }
  .site-header__toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--target-min);
    padding-inline: var(--space-3);
    border: var(--border-width) solid var(--color-on-brand);
    border-radius: var(--radius-control);
    background: transparent;
    color: var(--color-on-brand);
    white-space: nowrap;
    font-size: var(--text-dense);
    font-weight: var(--font-weight-bold);
    font-feature-settings: "palt";
    list-style: none;
  }
  .site-header__toggle::-webkit-details-marker {
    display: none;
  }
  .site-header__fold[open] > .site-menu {
    position: absolute;
    top: 100%;
    right: 0;
    z-index: 1;
    min-width: var(--menu-min-width);
    margin-block-start: var(--space-1);
    border: var(--border-width) solid var(--color-border-strong);
    background: var(--color-surface);
  }
  .site-header__nav {
    display: none;
    grid-area: nav;
  }
  /* 帯の上の検索欄：丸い形で、帯になじむ濃い面にする（運営者の見本） */
  .site-header__search :global(.search__input) {
    border-color: var(--color-brand-hover);
    border-radius: var(--radius-pill);
    background: var(--color-brand-hover);
    color: var(--color-on-brand);
  }
  .site-header__search :global(.search__input::placeholder),
  .site-header__search :global(.search__icon) {
    color: var(--color-on-brand-muted);
  }
  .site-header__search {
    grid-area: search;
  }
  .site-header__search-link {
    display: none;
  }
  .site-menu {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-menu a {
    display: flex;
    align-items: center;
    min-height: var(--target-min);
    padding-inline: var(--space-4);
    border-bottom: var(--border-width-current) solid transparent;
    color: var(--color-text);
    font-size: var(--text-dense);
    font-weight: var(--font-weight-bold);
    font-feature-settings: "palt";
    text-decoration: none;
  }
  .site-menu a:visited {
    color: var(--color-text);
  }
  .site-menu a:hover,
  .site-menu a:active {
    background: var(--color-surface-sunken);
    color: var(--color-primary-hover);
  }
  .site-menu a[aria-current="page"] {
    border-bottom-color: var(--color-accent);
    background: var(--color-primary-tint);
  }
  /* 濃紺の帯の上では、フォーカスの枠を白にする（緑の枠では帯との差が足りない） */
  .site-header :global(:focus-visible) {
    outline-color: var(--color-on-brand);
  }
  .site-header__fold[open] > .site-menu :global(:focus-visible) {
    outline-color: var(--color-focus);
  }
  /* 帯の上のメニュー（タブレット以上）：白い文字、現在地は明るい緑の線 */
  .site-header__nav .site-menu a,
  .site-header__nav .site-menu a:visited {
    color: var(--color-on-brand);
  }
  .site-header__nav .site-menu a:hover,
  .site-header__nav .site-menu a:active {
    background: var(--color-brand-hover);
    color: var(--color-on-brand);
  }
  .site-header__nav .site-menu a[aria-current="page"] {
    border-bottom-color: var(--color-brand-accent);
    background: var(--color-brand-hover);
  }

  @media (--tablet) {
    .site-header__bar {
      grid-template-columns: auto 1fr auto;
      grid-template-areas: "brand nav search";
      padding-block: 0;
    }
    .site-header__brand {
      min-height: var(--header-height);
    }
    .site-header__name {
      font-size: var(--text-h3);
      letter-spacing: var(--text-h3-tracking);
    }
    .site-header__fold {
      display: none;
    }
    .site-header__nav {
      display: block;
      justify-self: end;
    }
    .site-menu {
      flex-direction: row;
    }
    .site-menu a {
      min-height: var(--header-height);
      padding-inline: var(--space-4);
    }
    /* タブレット：検索欄を出さず、検索のページへのリンクにする（8.1） */
    .site-header__search {
      display: none;
    }
    .site-header__search-link,
    .site-header__search-link:visited {
      display: inline-flex;
      grid-area: search;
      justify-self: end;
      align-items: center;
      gap: var(--space-2);
      min-height: var(--target-min);
      padding-inline: var(--space-4);
      border-radius: var(--radius-pill);
      background: var(--color-brand-hover);
      color: var(--color-on-brand);
      font-size: var(--text-dense);
      font-weight: var(--font-weight-bold);
      text-decoration: none;
    }
  }
  @media (--pc) {
    .site-header__bar {
      grid-template-columns: auto 1fr minmax(var(--search-width-min), var(--search-width-max));
    }
    .site-header__search {
      display: block;
    }
    .site-header__search-link,
    .site-header__search-link:visited {
      display: none;
    }
  }
</style>

<script>
  import '../scripts/menu';
</script>
