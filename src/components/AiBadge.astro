---
// AI作成の表示（8.9、UI-06）：記号＋文言。説明のページ（/editorial-policy/）へのリンク
//   運営者が確認したあと（draft でない）：「AIが下書きし、運営者が確認しました」
//   確認の前（draft: true）：「AIが下書きしました（運営者の確認前）」
import Icon from './Icon.astro';

interface Props {
  draft?: boolean;
}
const { draft = false } = Astro.props;
---

<span class="ai-badge">
  <Icon name="ai" />
  <span>{draft ? 'AIが下書きしました（運営者の確認前）' : 'AIが下書きし、運営者が確認しました'}（<a href="/editorial-policy/">編集方針</a>）</span>
</span>

<style>
  .ai-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    color: var(--color-text-muted);
    font-size: var(--text-small);
    line-height: var(--text-small-leading);
    letter-spacing: var(--text-small-tracking);
  }
</style>
