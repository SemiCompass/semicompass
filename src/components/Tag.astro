---
// タグ（8.11）：工程、分類、企業。リンクにし、色で種類を分けない（種類は前の文字「工程：」などで示す）。
// 丸い形、薄い灰色の面、枠なし、補足の大きさ（12px）、高さ26px
interface Props {
  href: string;
  kind: string; // 種類の名前（例：工程、分類、企業）
}
const { href, kind } = Astro.props;
---

<a class="tag" href={href}><span class="tag__kind">{kind}：</span><span class="tag__name"><slot /></span></a>

<style>
  .tag {
    display: inline-flex;
    align-items: center;
    min-height: var(--tag-height-sm);
    padding-inline: var(--space-3);
    border-radius: var(--radius-pill);
    background: var(--color-surface-sunken);
    color: var(--color-text);
    font-size: var(--text-caption);
    line-height: var(--text-caption-leading);
    letter-spacing: var(--text-small-tracking);
    text-decoration: none;
  }
  .tag__kind {
    color: var(--color-text-muted);
  }
  .tag:visited {
    color: var(--color-text);
  }
  .tag:hover,
  .tag:active {
    background: var(--color-primary-tint);
    color: var(--color-primary-hover);
  }
  /* タッチの画面では、押せる範囲を44px以上に広げる（8.11） */
  @media (pointer: coarse) {
    .tag {
      min-height: var(--target-min);
    }
  }
</style>
