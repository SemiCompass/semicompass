---
// 半導体を学ぶの一覧（/learn/）の1つの段（基礎編、半導体の物理）：段の中見出しと説明、対象・前提知識・読む順、分野の入口の並び（仕様書 8.18）。
// 単元のない分野・カードは、リンクにせず、控えめな形で「準備中」と示す（押す前に読めるかが分かるようにする）
import { TIER_GUIDE } from '../lib/content';
import { fieldName, type TierIndex } from '../lib/learn';

interface Props {
  entry: TierIndex;
}
const { tier, fields } = Astro.props.entry;
const id = `tier-${tier.slug}`;
const guide = TIER_GUIDE[tier.slug];
---

<section aria-labelledby={id} class="learn-tier">
  <h2 id={id}>{tier.title}</h2>
  <p class="measure">{tier.summary}</p>
  <dl class="learn-tier__guide">
    <div><dt>対象</dt><dd>{guide.audience}</dd></div>
    <div><dt>前提知識</dt><dd>{guide.prerequisite}</dd></div>
    <div><dt>読む順</dt><dd>{guide.order}</dd></div>
  </dl>
  <ul class="learn-fields__list">
    {fields.map(({ field, units }) => (
      <li>
        {units.length > 0 ? (
          <a class="learn-field-entry" href={`/learn/${field.slug}/`}>
            <span class="learn-field-entry__title">{fieldName(field)}</span>
            <span class="learn-field-entry__text">{field.summary}</span>
            <span class="learn-field-entry__count">{units.length}ページ</span>
          </a>
        ) : (
          <div class="learn-field-entry learn-field-entry--pending">
            <span class="learn-field-entry__title">{fieldName(field)}<span class="learn-field-entry__pending">（準備中）</span></span>
            <span class="learn-field-entry__text">{field.summary}</span>
          </div>
        )}
      </li>
    ))}
  </ul>
</section>

<style>
  @import "../styles/breakpoints.css";
  .learn-tier {
    margin-block-start: var(--space-6);
  }
  .learn-tier__guide {
    max-width: var(--content-max-width);
    margin: var(--space-2) 0 0;
    font-size: var(--text-small);
    line-height: var(--text-small-leading);
    letter-spacing: var(--text-small-tracking);
  }
  .learn-tier__guide div {
    display: flex;
    gap: var(--space-2);
  }
  .learn-tier__guide dt {
    flex: none;
    font-weight: var(--font-weight-bold);
  }
  .learn-tier__guide dd {
    margin: 0;
    color: var(--color-text-muted);
  }
  .learn-fields__list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-3);
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
  }
  @media (--tablet) {
    .learn-fields__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (--pc) {
    .learn-fields__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .learn-fields__list li {
    display: flex;
  }
  .learn-field-entry {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    width: 100%;
    min-height: var(--target-min);
    padding: var(--space-3);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface-sunken);
    color: var(--color-text);
    text-decoration: none;
  }
  a.learn-field-entry:hover {
    border-color: var(--color-primary);
    background: var(--color-primary-tint);
  }
  .learn-field-entry__title {
    color: var(--color-primary);
    font-size: var(--text-lead);
    font-weight: var(--font-weight-bold);
    line-height: var(--text-lead-leading);
    letter-spacing: var(--text-lead-tracking);
  }
  .learn-field-entry__text,
  .learn-field-entry__count {
    color: var(--color-text-muted);
    font-size: var(--text-small);
    line-height: var(--text-small-leading);
    letter-spacing: var(--text-small-tracking);
  }
  /* ページの数は、カードの下端にそろえる */
  .learn-field-entry__count {
    margin-block-start: auto;
    padding-block-start: var(--space-1);
  }
  /* 準備中：リンクにせず、白い面と補助の色で控えめに示す */
  .learn-field-entry--pending {
    background: var(--color-surface);
  }
  .learn-field-entry--pending .learn-field-entry__title {
    color: var(--color-text-muted);
  }
  .learn-field-entry__pending {
    font-size: var(--text-small);
    font-weight: var(--font-weight-normal);
  }
</style>
