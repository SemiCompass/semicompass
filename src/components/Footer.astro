---
// フッター（8.13）：上段は、左にロゴとサイト名とデータの出典の説明、右にリンクの3つのまとまり（探す、このサイトについて、お問い合わせ）。
// 運営者のnoteは「お問い合わせ」の最後。下段に著作権の表示と、ご利用にあたって（免責事項など）とCookieの設定。
// まとまりの項目と順番は config/menu.yaml
import ExternalLink from './ExternalLink.astro';
import Logo from './Logo.astro';
import { loadMenu } from '../lib/menu';

const { footer, note } = loadMenu();
const groups = footer.filter((g) => g.title !== 'ご利用にあたって');
const legal = footer.filter((g) => g.title === 'ご利用にあたって');
const { analytics = false } = Astro.props as { analytics?: boolean };
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__top">
      <div class="site-footer__about">
        <p class="site-footer__name"><Logo /><span>SemiCompass</span></p>
        <p class="site-footer__note">業績などの数値の出典は、EDINET（金融庁）などの公開資料で、各ページに示しています。</p>
      </div>
      <nav class="site-footer__nav" aria-label="フッター">
        {groups.map((g, i) => (
          <div class="site-footer__group">
            <p class="site-footer__group-title" id={`footer-group-${i}`}>{g.title}</p>
            <ul class="site-footer__links site-footer__links--group" aria-labelledby={`footer-group-${i}`}>
              {g.links.map((link) => (
                <li><a href={link.path}>{link.label}</a></li>
              ))}
              {i === groups.length - 1 && <li><ExternalLink href={note.url}>{note.label}</ExternalLink></li>}
            </ul>
          </div>
        ))}
      </nav>
    </div>
    <div class="site-footer__bottom">
      <p class="site-footer__note"><small>© SemiCompass</small></p>
      <ul class="site-footer__links site-footer__links--legal" aria-label="ご利用にあたって">
        {legal.flatMap((g) => g.links).map((link) => (
          <li><a href={link.path}>{link.label}</a></li>
        ))}
        {analytics && <li><button type="button" class="site-footer__consent" data-consent-open>Cookieの設定</button></li>}
      </ul>
    </div>
  </div>
</footer>

<style>
  @import "../styles/breakpoints.css";
  .site-footer {
    margin-block-start: var(--space-8);
    padding-block: var(--space-7) var(--space-6);
    border-top: var(--border-width) solid var(--color-border);
    background: var(--color-surface-sunken);
    color: var(--color-text-muted);
    font-size: var(--text-small);
    line-height: var(--text-small-leading);
  }
  .site-footer__top {
    display: grid;
    gap: var(--space-6);
  }
  .site-footer__name {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    color: var(--color-text);
    font-size: var(--text-dense);
    font-weight: var(--font-weight-bold);
  }
  /* ロゴは、白い帯の外では濃紺の線にする（針の上半分は明るい緑のまま） */
  .site-footer__name :global(.logo) {
    width: var(--logo-size-sp);
    height: var(--logo-size-sp);
    color: var(--color-brand);
  }
  .site-footer__note {
    margin: var(--space-2) 0 0;
    color: var(--color-text-muted);
  }
  .site-footer__nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
  }
  .site-footer__group-title {
    margin: 0 0 var(--space-1);
    color: var(--color-text);
    font-weight: var(--font-weight-bold);
  }
  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-footer__links--group {
    flex-direction: column;
  }
  .site-footer__links li {
    padding-block: var(--space-1);
  }
  /* 押せる範囲は、行の間を広げず、透明な ::after で高さを取る（8.5） */
  .site-footer__links a {
    position: relative;
    color: var(--color-text-muted);
    text-decoration: none;
  }
  .site-footer__links a::after {
    position: absolute;
    top: 50%;
    right: 0;
    left: 0;
    height: var(--target-min);
    content: "";
    transform: translateY(-50%);
  }
  .site-footer__links :global(a) {
    color: var(--color-text-muted);
    text-decoration: none;
  }
  .site-footer__links a:hover,
  .site-footer__links :global(a:hover) {
    color: var(--color-primary);
    text-decoration: underline;
  }
  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-2) var(--space-5);
    margin-block-start: var(--space-6);
    padding-block-start: var(--space-4);
    border-top: var(--border-width) solid var(--color-border);
  }
  .site-footer__bottom .site-footer__note {
    margin: 0;
  }
  .site-footer__consent {
    min-height: var(--target-min);
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-primary);
    font: inherit;
    text-decoration: underline;
    cursor: pointer;
  }
  @media (--tablet) {
    .site-footer__nav {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (--pc) {
    .site-footer__top {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    }
  }
</style>
