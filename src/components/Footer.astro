---
// フッター（8.13、運営者の見本に合わせた改訂案）：上段にサイト名とデータの出典の説明、中段にサイトについて・質問のリンクと運営者のnote、
// 下段に著作権の表示と、ご利用にあたって（免責事項など）とCookieの設定。リンクは1行に並べ、狭い幅では折り返す
import ExternalLink from './ExternalLink.astro';
import { loadMenu } from '../lib/menu';

const { footer, note } = loadMenu();
const { analytics = false } = Astro.props as { analytics?: boolean };
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__top">
      <p class="site-footer__name">SemiCompass</p>
      <p class="site-footer__note">業績などの数値の出典は、EDINET（金融庁）などの公開資料で、各ページに示しています。</p>
    </div>
    <nav class="site-footer__nav" aria-label="フッター">
      <ul class="site-footer__links">
        {footer.filter((g) => g.title !== 'ご利用にあたって').flatMap((g) => g.links).map((link) => (
          <li><a href={link.path}>{link.label}</a></li>
        ))}
        <li><ExternalLink href={note.url}>{note.label}</ExternalLink></li>
      </ul>
    </nav>
    <div class="site-footer__bottom">
      <p class="site-footer__note"><small>© SemiCompass</small></p>
      <ul class="site-footer__links site-footer__links--legal" aria-label="ご利用にあたって">
        {footer.filter((g) => g.title === 'ご利用にあたって').flatMap((g) => g.links).map((link) => (
          <li><a href={link.path}>{link.label}</a></li>
        ))}
        {analytics && <li><button type="button" class="site-footer__consent" data-consent-open>Cookieの設定</button></li>}
      </ul>
    </div>
  </div>
</footer>

<style>
  @import "../styles/breakpoints.css";
  .site-footer {
    margin-block-start: var(--space-8);
    padding-block: var(--space-7) var(--space-6);
    border-top: var(--border-width) solid var(--color-border);
    background: var(--color-surface-sunken);
    font-size: var(--text-small);
    line-height: var(--text-small-leading);
  }
  .site-footer__name {
    margin: 0;
    font-weight: var(--font-weight-bold);
  }
  .site-footer__note {
    margin: var(--space-1) 0 0;
    color: var(--color-text-muted);
  }
  .site-footer__nav {
    margin-block-start: var(--space-5);
  }
  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-footer__links li {
    padding-block: var(--space-2);
  }
  /* 押せる範囲は、行の間を広げず、透明な ::after で高さを取る（8.5） */
  .site-footer__links a {
    position: relative;
    color: var(--color-text-muted);
    text-decoration: none;
  }
  .site-footer__links a::after {
    position: absolute;
    top: 50%;
    right: 0;
    left: 0;
    height: var(--target-min);
    content: "";
    transform: translateY(-50%);
  }
  .site-footer__links :global(a) {
    color: var(--color-text-muted);
    text-decoration: none;
  }
  .site-footer__links a:hover,
  .site-footer__links :global(a:hover) {
    color: var(--color-primary);
    text-decoration: underline;
  }
  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-2) var(--space-5);
    margin-block-start: var(--space-4);
    padding-block-start: var(--space-3);
    border-top: var(--border-width) solid var(--color-border);
  }
  .site-footer__bottom .site-footer__note {
    margin: 0;
  }
  .site-footer__consent {
    min-height: var(--target-min);
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-primary);
    font: inherit;
    text-decoration: underline;
    cursor: pointer;
  }
</style>
