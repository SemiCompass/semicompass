---
// フッター（8.13）：固定ページ、よくある質問、訂正一覧、公開範囲と今後の予定へのリンクを、2〜4列で並べる（スマートフォンは1列）。最下段に、サイト名、著作権の表示、データの出典の説明
import { loadMenu } from '../lib/menu';

const { footer } = loadMenu();
---

<footer class="site-footer">
  <div class="container">
    <nav class="site-footer__nav" aria-label="フッター">
      {footer.map((group) => (
        <section class="site-footer__group">
          <h2 class="site-footer__title">{group.title}</h2>
          <ul class="site-footer__links">
            {group.links.map((link) => (
              <li><a href={link.path}>{link.label}</a></li>
            ))}
          </ul>
        </section>
      ))}
    </nav>
    <div class="site-footer__bottom">
      <p class="site-footer__name">SemiCompass</p>
      <p class="site-footer__note">業績などの数値の出典は、EDINET（金融庁）などの公開資料で、各ページに示しています。</p>
      <p class="site-footer__note"><small>© SemiCompass</small></p>
    </div>
  </div>
</footer>

<style>
  @import "../styles/breakpoints.css";

  .site-footer {
    margin-block-start: var(--space-8);
    padding-block: var(--space-6);
    border-top: var(--border-width) solid var(--color-border);
    background: var(--color-surface-sunken);
  }
  .site-footer__nav {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5) var(--space-6);
  }
  .site-footer__title {
    margin: 0 0 var(--space-2);
    font-size: var(--text-dense);
    line-height: var(--text-dense-leading);
    letter-spacing: var(--text-dense-tracking);
  }
  .site-footer__links {
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-dense);
    line-height: var(--text-dense-leading);
    letter-spacing: var(--text-dense-tracking);
  }
  /* 押せる範囲44pxは、::after の透明な範囲で取る。見た目の行の間隔は、詰める（DS-07） */
  .site-footer__links a {
    position: relative;
    display: inline-block;
    padding-block: var(--space-1);
  }
  .site-footer__links a::after {
    content: "";
    position: absolute;
    inset-inline: 0;
    top: 50%;
    height: var(--target-min);
    transform: translateY(-50%);
  }
  .site-footer__bottom {
    margin-block-start: var(--space-6);
    padding-block-start: var(--space-4);
    border-top: var(--border-width) solid var(--color-border);
    color: var(--color-text-muted);
    font-size: var(--text-small);
    line-height: var(--text-small-leading);
    letter-spacing: var(--text-small-tracking);
  }
  .site-footer__bottom p {
    margin-block: 0 var(--space-2);
  }
  .site-footer__name {
    color: var(--color-text);
    font-weight: var(--font-weight-bold);
  }

  @media (--tablet) {
    .site-footer__nav {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (--pc) {
    .site-footer__nav {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
