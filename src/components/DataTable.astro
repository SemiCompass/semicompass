---
// 表（8.7）：上下の罫線だけ（縦の罫線なし）。見出し行は surface-sunken、その下は border-strong の罫線。
// 数値の列は右揃え・等幅の数字、文字の列は左揃え。列の見出しに単位を書く。表の下の出典は、SourceLine を続けて置く。
// 幅が足りないときは、表を囲む枠の中だけで横にスクロールし、最初の列を左に固定する。並べ替えの列は、記号と aria-sort で状態を示す
import Icon from './Icon.astro';

interface Column {
  key: string;
  label: string; // 単位を含める（例：売上高（億円））
  numeric?: boolean;
  wrap?: boolean; // 長い文字の列：折り返す（数値の列は、折り返さない）
  sort?: 'ascending' | 'descending' | 'none'; // 並べ替えができる列。今の状態
  sortKey?: string; // スクリプトで並べ替える列の名前（行の data-sort-{名前}）。ある列は、見出しを押して並べ替えられる
}
interface Props {
  caption: string;
  columns: Column[];
  rows: Record<string, string>[]; // 最初の列の値は、行の __href があれば、リンクにする
  rowData?: Record<string, string>[]; // 行ごとの data-* 属性（絞り込みと並べ替えに使う）
  emptyMessage?: string;
  wideFirst?: boolean; // 最初の列を、広い幅まで広げる（企業の表など）
}
const { caption, columns, rows, rowData = [], emptyMessage = '該当するデータはありません', wideFirst = false } = Astro.props;
---

<div class="table-scroll" role="region" aria-label={`${caption}（横にスクロールできます）`} tabindex="0">
  <table class:list={['data-table', wideFirst && 'data-table--wide-first']}>
    <caption class="visually-hidden">{caption}</caption>
    <thead>
      <tr>
        {columns.map((c, i) => (
          <th
            scope="col"
            class:list={[c.numeric ? 'is-numeric' : 'is-text', i === 0 ? 'is-first' : undefined, c.wrap && 'is-wrap']}
            aria-sort={c.sort}
            data-sort-key={c.sortKey}
          >
            <span class="data-table__label">{c.label}</span>
            {c.sort && (
              <>
                <Icon class="data-table__sort data-table__sort--none" name="sort" />
                <Icon class="data-table__sort data-table__sort--ascending" name="sort-up" />
                <Icon class="data-table__sort data-table__sort--descending" name="sort-down" />
              </>
            )}
          </th>
        ))}
      </tr>
    </thead>
    <tbody>
      {rows.length === 0 && (
        <tr><td colspan={columns.length} class="data-table__empty">{emptyMessage}</td></tr>
      )}
      {rows.map((row, rowIndex) => (
        <tr {...(rowData[rowIndex] ?? {})}>
          {columns.map((c, i) => (
            i === 0
              ? <th scope="row" class="is-first is-text">{row.__href ? <a href={row.__href}>{row[c.key]}</a> : row[c.key]}</th>
              : <td class:list={[c.numeric ? 'is-numeric' : 'is-text', c.wrap && 'is-wrap']}>{row[c.key]}</td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>
<p class="table-scroll-note" aria-hidden="true">横にスクロールできます</p>

<style>
  @import "../styles/breakpoints.css";

  .table-scroll {
    overflow-x: auto;
    border-right: var(--border-width) solid var(--color-border);
  }
  .data-table {
    width: 100%;
    border-collapse: collapse;
    border-top: var(--border-width) solid var(--color-border-strong);
    border-bottom: var(--border-width) solid var(--color-border-strong);
    background: var(--color-surface);
    font-size: var(--text-dense);
    line-height: var(--text-dense-leading);
    letter-spacing: var(--text-dense-tracking);
    font-variant-numeric: tabular-nums;
  }
  .data-table th,
  .data-table td {
    padding: var(--space-2) var(--space-3);
    border-bottom: var(--border-width) solid var(--color-border);
    font-feature-settings: normal;
    white-space: nowrap;
  }
  .data-table thead th {
    border-bottom: var(--border-width) solid var(--color-border-strong);
    background: var(--color-surface-sunken);
    font-feature-settings: "palt";
  }
  /* 最初の列（企業名など）：幅の範囲を持ち、長い名前は折り返す。数値の列は、折り返さない */
  .data-table .is-first {
    position: sticky;
    left: 0;
    min-width: var(--table-first-column-min);
    max-width: var(--table-first-column-max);
    white-space: normal;
    overflow-wrap: anywhere;
    background: var(--color-surface);
    text-align: left;
  }
  .data-table thead .is-first {
    background: var(--color-surface-sunken);
  }
  .data-table--wide-first .is-first {
    max-width: var(--table-first-column-wide);
  }
  .data-table .is-wrap {
    min-width: var(--table-wrap-column-min);
    white-space: normal;
    overflow-wrap: anywhere;
  }
  .data-table .is-text {
    text-align: left;
  }
  .data-table .is-numeric {
    text-align: right;
  }
  .data-table tbody tr:hover > * {
    background: var(--color-surface-sunken);
  }
  .data-table tbody th {
    font-weight: var(--font-weight-normal);
  }
  .data-table :global(.data-table__sort) {
    margin-inline-start: var(--space-1);
    color: var(--color-text-muted);
    vertical-align: var(--icon-inline-offset);
  }
  /* 並べ替えの記号：今の状態（aria-sort）の1つだけを見せる */
  .data-table th[aria-sort="none"] :global(.data-table__sort--ascending),
  .data-table th[aria-sort="none"] :global(.data-table__sort--descending),
  .data-table th[aria-sort="ascending"] :global(.data-table__sort--none),
  .data-table th[aria-sort="ascending"] :global(.data-table__sort--descending),
  .data-table th[aria-sort="descending"] :global(.data-table__sort--none),
  .data-table th[aria-sort="descending"] :global(.data-table__sort--ascending) {
    display: none;
  }
  .data-table :global(.data-table__sort-button) {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }
  .data-table__empty {
    color: var(--color-text-muted);
    text-align: left;
  }
  .table-scroll-note {
    margin-block: var(--space-2) 0;
    color: var(--color-text-muted);
    font-size: var(--text-small);
    line-height: var(--text-small-leading);
    letter-spacing: var(--text-small-tracking);
  }
  @media (--pc) {
    .table-scroll-note {
      display: none;
    }
  }
</style>
