---
// トップページの入口の絵（仕様書 7章）：行き先を表す線の図。線は --color-primary、絵の中の小さな印だけ琥珀（4.4）。
// 見出しと必ず組にし、読み上げない（aria-hidden）
interface Props {
  name: 'learn' | 'process' | 'news' | 'company';
}
const { name } = Astro.props;
---

<svg class="entry-pic" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === 'learn' && (
    <>
      <path d="M6 12c6-2 12-2 18 2 6-4 12-4 18-2v24c-6-2-12-2-18 2-6-4-12-4-18-2z" />
      <path d="M24 14v24M10 29h9" />
      <rect x="29" y="18" width="8" height="8" rx="1" />
      <path d="M31 16v2M35 16v2M31 26v2M35 26v2" />
      <circle class="entry-pic__dot" cx="14" cy="22" r="2.5" />
    </>
  )}
  {name === 'process' && (
    <>
      <circle cx="10" cy="24" r="6" />
      <path d="M10 18v3M16 24h3M31 24h5M21 22h8M21 26h5" />
      <rect x="19" y="18" width="12" height="12" rx="1" />
      <rect x="36" y="20" width="8" height="8" rx="1" />
      <path d="M6 38h36" stroke-dasharray="2 3" />
      <circle class="entry-pic__dot" cx="40" cy="24" r="1.6" />
    </>
  )}
  {name === 'news' && (
    <>
      <rect x="8" y="8" width="28" height="32" rx="2" />
      <path d="M36 16h4v20a4 4 0 0 1-4 4M13 15h18M13 21h8M13 27h18M13 33h12" />
      <rect class="entry-pic__box" x="24" y="20" width="7" height="5" />
    </>
  )}
  {name === 'company' && (
    <>
      <path d="M6 40h36M28 40V30M34 40V24M40 40V18M13 19h2M17 19h2M13 24h2M17 24h2M13 29h2M17 29h2" />
      <rect x="9" y="14" width="14" height="26" />
      <circle class="entry-pic__dot" cx="40" cy="12" r="2.2" />
    </>
  )}
</svg>

<style>
  .entry-pic {
    width: var(--icon-entry);
    height: var(--icon-entry);
    color: var(--color-primary);
    stroke-width: var(--icon-stroke);
  }
  .entry-pic__dot {
    fill: var(--color-highlight);
    stroke: none;
  }
  .entry-pic__box {
    fill: var(--color-highlight-tint);
    stroke: var(--color-highlight);
  }
</style>
