---
// 本文の1段落：文節の切れ目（<wbr>）、数値と単位の折り返しなし、出典の番号 [S1] を上付きの番号のリンクにする
import { pieces } from '../lib/phrase';
import Citation from './Citation.astro';

interface Props {
  text: string;
}
const parts = pieces(Astro.props.text);
---

{parts.map((piece) =>
  piece.kind === 'citation' ? (
    <Citation number={piece.number} />
  ) : piece.kind === 'number' ? (
    <span class="nowrap">{piece.text}</span>
  ) : (
    piece.phrases.map((part, index) => (index > 0 ? [<wbr />, part] : part))
  ),
)}
