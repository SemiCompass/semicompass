---
// 状態の表示（8.12、DS-06）：読み込み中、データがない、エラー。
//   loading  本文の位置に「読み込んでいます」の文字だけ。回る印は使わない
//   empty    枠 border の中に、何がないかと、代わりの行き先
//   error    誤りの見た目（8.9）。何が起きたかと、次にできること
// 休止中は、PendingNotice（kind="paused"）を使う
import Notice from './Notice.astro';

interface Props {
  kind: 'loading' | 'empty' | 'error';
  message?: string;
  actionLabel?: string;
  actionHref?: string;
}
const { kind, message, actionLabel, actionHref } = Astro.props;
---

{kind === 'loading' && <p class="state state--loading" role="status">{message ?? '読み込んでいます'}</p>}
{kind === 'empty' && (
  <div class="state state--empty">
    <p>{message}</p>
    {actionHref && actionLabel && <p><a href={actionHref}>{actionLabel}</a></p>}
  </div>
)}
{kind === 'error' && (
  <Notice kind="error" title={message}>
    <slot />
    {actionHref && actionLabel && <p><a href={actionHref}>{actionLabel}</a></p>}
  </Notice>
)}

<style>
  .state {
    margin-block: var(--space-5);
    font-size: var(--text-dense);
    line-height: var(--text-dense-leading);
    letter-spacing: var(--text-dense-tracking);
  }
  .state--loading {
    color: var(--color-text-muted);
  }
  .state--empty {
    padding: var(--space-5);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-none);
  }
  .state--empty > :global(p) {
    margin-block: 0 var(--space-2);
  }
  .state--empty > :global(p:last-child) {
    margin-block-end: 0;
  }
</style>
