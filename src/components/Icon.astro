---
// 意味のある図と記号だけ（仕様書 7章）。線の太さは --icon-stroke にそろえ、文字と同じ色にする。装飾だけのアイコンは作らない
type Name = 'search' | 'external' | 'chevron' | 'chevron-down' | 'warning' | 'error' | 'note' | 'ai' | 'sort' | 'sort-up' | 'sort-down'
  | 'book' | 'flow' | 'newspaper' | 'building' // トップページの入口の記号（行き先を表す線の図。見出しと組にする）
  | 'check'; // 理解度チェックの正解の印
interface Props {
  name: Name;
  class?: string;
}
const { name, class: className } = Astro.props;
const paths: Record<Name, string> = {
  search: 'M10.5 4a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13Zm4.8 11.3L20 20',
  external: 'M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5',
  chevron: 'M9 5l7 7-7 7',
  'chevron-down': 'M5 9l7 7 7-7',
  warning: 'M12 4l9 16H3L12 4Zm0 6v5m0 3v.01',
  error: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Zm0 5v5m0 3v.01',
  note: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Zm0 8v6m0-9v.01',
  ai: 'M5 5h14v14H5V5Zm4 4h6v6H9V9Z',
  sort: 'M8 9l4-4 4 4M8 15l4 4 4-4',
  'sort-up': 'M8 15l4-4 4 4',
  'sort-down': 'M8 9l4 4 4-4',
  check: 'M5 12.5l4.5 4.5L19 7.5',
  book: 'M12 6.5C10 5 7 4.5 3 5v13c4-.5 7 0 9 1.5 2-1.5 5-2 9-1.5V5c-4-.5-7 0-9 1.5Zm0 0v13',
  flow: 'M2.5 8.5h6v7h-6v-7Zm13 0h6v7h-6v-7ZM8.5 12h7m-2.5-2.5L15.5 12 13 14.5',
  newspaper: 'M4 5h12v14H6a2 2 0 0 1-2-2V5Zm12 4h4v8a2 2 0 0 1-2 2h-2M7 9h6M7 12h6M7 15h4',
  building: 'M3 20h18M5 20V4h9v16m0-11h5v11M8 8h3m-3 4h3m-3 4h3',
};
const turn = name === 'chevron' ? 'icon-turn' : name === 'chevron-down' ? 'icon-flip' : '';
---

<svg
  class:list={['icon', turn, className]}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path d={paths[name]} vector-effect="non-scaling-stroke"></path>
</svg>

<style>
  .icon {
    flex: none;
    width: var(--icon-size);
    height: var(--icon-size);
    stroke-width: var(--icon-stroke);
  }
</style>
