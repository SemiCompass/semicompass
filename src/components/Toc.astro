---
// ページ内の目次（8.4）：項目は中見出し（##）だけ。
//   PC：右の列に置き、スクロールしても見える位置に張り付ける（sticky）。読んでいる見出しの項目に、左の琥珀色の線を付ける
//   スマートフォンとタブレット：大見出しの後に、開閉できる「このページの目次」として置く（初めは閉じる）
// 同じ内容を2つの形で出し、幅に合わせて、どちらかだけを見せる
import Icon from './Icon.astro';

interface Item {
  id: string; // 見出しの id
  label: string;
}
interface Props {
  items: Item[];
  variant: 'fold' | 'side';
}
const { items, variant } = Astro.props;
---

{variant === 'fold' && (
  <details class="toc toc--fold">
    <summary class="toc__summary"><Icon name="chevron" /><span>このページの目次</span></summary>
    <ol class="toc__list">
      {items.map((item) => <li><a href={`#${item.id}`}>{item.label}</a></li>)}
    </ol>
  </details>
)}
{variant === 'side' && (
  <nav class="toc toc--side" aria-label="このページの目次" data-toc>
    <p class="toc__title">このページの目次</p>
    <ol class="toc__list">
      {items.map((item) => <li><a href={`#${item.id}`}>{item.label}</a></li>)}
    </ol>
  </nav>
)}

<style>
  @import "../styles/breakpoints.css";

  .toc__list {
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-dense);
    line-height: var(--text-dense-leading);
    letter-spacing: var(--text-dense-tracking);
  }
  .toc__list a {
    display: flex;
    align-items: center;
    min-height: var(--target-min);
    padding-inline: var(--space-3);
    border-left: var(--border-width-accent) solid transparent;
    text-decoration: none;
  }
  .toc--fold {
    max-width: var(--content-max-width);
    margin-block: var(--space-5);
    border: var(--border-width) solid var(--color-border);
    background: var(--color-surface);
  }
  .toc__summary {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--target-min);
    padding-inline: var(--space-3);
    font-size: var(--text-dense);
    font-weight: var(--font-weight-bold);
    list-style: none;
  }
  .toc__summary::-webkit-details-marker {
    display: none;
  }
  .toc--side {
    display: none;
  }
  .toc__title {
    margin: 0 0 var(--space-2);
    padding-inline: var(--space-3);
    font-size: var(--text-dense);
    font-weight: var(--font-weight-bold);
    line-height: var(--text-dense-leading);
  }
  /* 現在読んでいる見出し（src/scripts/toc.ts が aria-current="location" を付ける）：琥珀色の線と太字 */
  .toc__list a[aria-current="location"] {
    border-left-color: var(--color-accent);
    font-weight: var(--font-weight-bold);
  }

  @media (--pc) {
    .toc--fold {
      display: none;
    }
    .toc--side {
      display: block;
      position: sticky;
      top: var(--toc-sticky-top);
    }
  }
</style>

<script>
  import '../scripts/toc';
</script>
