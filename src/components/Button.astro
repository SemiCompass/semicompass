---
// リンクとボタン（8.5、11章）。
//   primary    背景 primary、白い文字。1つの画面に1つまで
//   secondary  背景 surface、枠 border-strong、文字 primary
// href があれば <a>、なければ <button>。使えないとき（disabled）は、枠を破線にし、理由（reason）を近くに書く
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary';
  disabled?: boolean;
  reason?: string;
  type?: 'button' | 'submit';
  id?: string; // 理由の文と結ぶための名前（1ページの中で重ならない値）
}
const { href, variant = 'secondary', disabled = false, reason, type = 'button', id = 'button' } = Astro.props;
const reasonId = reason ? `${id}-reason` : undefined;
---

<span class="button-wrap">
  {href && !disabled ? (
    <a class:list={['button', `button--${variant}`]} href={href}><slot /></a>
  ) : (
    <button
      class:list={['button', `button--${variant}`]}
      type={type}
      disabled={disabled}
      aria-describedby={disabled ? reasonId : undefined}
    ><slot /></button>
  )}
  {disabled && reason && <span class="button-wrap__reason" id={reasonId}>{reason}</span>}
</span>

<style>
  .button-wrap {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-1);
  }
  .button-wrap__reason {
    color: var(--color-text-muted);
    font-size: var(--text-small);
    line-height: var(--text-small-leading);
    letter-spacing: var(--text-small-tracking);
  }
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: var(--control-height);
    padding-block: var(--space-3);
    padding-inline: var(--space-5);
    border: var(--border-width) solid transparent;
    border-radius: var(--radius-control);
    font: inherit;
    font-size: var(--text-dense);
    font-weight: var(--font-weight-bold);
    line-height: var(--text-dense-leading);
    letter-spacing: var(--text-dense-tracking);
    font-feature-settings: "palt";
    text-decoration: none;
    cursor: pointer;
  }
  .button--primary,
  .button--primary:visited {
    border-color: var(--color-primary);
    background: var(--color-primary);
    color: var(--color-primary-contrast);
  }
  .button--primary:hover,
  .button--primary:active {
    border-color: var(--color-primary-hover);
    background: var(--color-primary-hover);
    color: var(--color-primary-contrast);
  }
  .button--secondary,
  .button--secondary:visited {
    border-color: var(--color-border-strong);
    background: var(--color-surface);
    color: var(--color-primary);
  }
  .button--secondary:hover,
  .button--secondary:active {
    color: var(--color-primary-hover);
  }
  .button:disabled {
    border: var(--border-width) dashed var(--color-border-strong);
    background: var(--color-surface);
    color: var(--color-text-muted);
  }
</style>
