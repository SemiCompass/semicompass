---
// 工程の一覧とサプライチェーンマップ（/processes/。FR-102 MVP）：data/supply-chain.yaml の工程を段階ごとに並べた静的な図（SVG）と、
// 段階ごとの工程の一覧（名前、一文の説明、企業の表）。図の各工程は、同じページの見出し（#p-{工程}）へ移動できる。旧 /supply-chain/ は、ここへ転送する。
import { BUILD_ENV } from 'astro:env/server';
import FacilitiesBand from '../../components/FacilitiesBand.astro';
import Icon from '../../components/Icon.astro';
import SourceLine from '../../components/SourceLine.astro';
import StateMessage from '../../components/StateMessage.astro';
import SupplyMapSvg from '../../components/SupplyMapSvg.astro';
import Page from '../../layouts/Page.astro';
import { companyRows, loadCompanies, loadSupply } from '../../lib/companies';
import { buildSupplyMap, orderedStages, type MapProcess, type MapStage } from '../../lib/supplyMap';

const supply = loadSupply() as unknown as { categories: MapStage[]; processes: (MapProcess & { short_description?: string })[] };
const rows = companyRows(BUILD_ENV === 'preview');
const counts: Record<string, number> = {};
for (const r of rows) for (const p of r.company.processes) counts[p] = (counts[p] ?? 0) + 1;
const compact = buildSupplyMap(supply.categories, supply.processes, counts, 'compact');
const wide = buildSupplyMap(supply.categories, supply.processes, counts, 'wide');
const stages = orderedStages(supply.categories, supply.processes);
const decided = loadCompanies()
  .map((c) => (c as unknown as { selection?: { decided_on?: string } }).selection?.decided_on ?? '')
  .sort()
  .pop() ?? '';
const toc = [
  { id: 'supply-map-title', label: '工程の全体図' },
  ...stages.map((s) => ({ id: `stage-${s.stage.slug}`, label: s.stage.name })),
];
// 工程ごとの企業は、企業名だけを横に折り返して並べる（縦の長さを抑える。証券コード・企業区分・掲載の状態は、比べる一覧のページで見る）
const tableFor = (slug: string) =>
  rows
    .filter((r) => r.company.processes.includes(slug))
    .map((r) => ({
      href: `/companies/${r.company.slug}/`,
      name: r.company.short_names[0] ?? r.company.name,
    }));
---

<Page
  title="半導体製造工程の一覧と関連企業のマップ｜SemiCompass"
  heading="工程の一覧とサプライチェーンマップ"
  description="半導体ができるまでの工程の一覧と、全体を1枚で見渡せる図。前工程・後工程などの工程ごとに、説明と、関わる企業を確かめられます。"
  breadcrumbs={[{ label: 'ホーム', href: '/' }, { label: '工程' }]}
  toc={toc}
  updatedAt={decided || undefined}
  wide
>
  <p class="measure">半導体ができるまでの主な工程と、各工程に関わる企業を一覧できます。</p>
  <ul class="measure supply-guide">
    <li>図の箱を選ぶと、同じページの下にある、その工程の説明と企業へ移動します。右の数は、掲載している企業の数です。</li>
    <li>各工程の「工程の解説」で解説のページを、「売上高などを比べる一覧」で企業の比較を開けます。</li>
    <li>前工程は、ウェーハの上に回路を作る工程です。後工程は、ウェーハを切り分け、チップとして使える形にする工程です。</li>
  </ul>
  <figure class="supply-map" aria-labelledby="supply-map-title">
    <h2 id="supply-map-title">工程の全体図</h2>
    <p class="supply-map__meta">矢印は、おおまかな流れを示します。実際の製造では、同じ工程を何度も繰り返す場合があります。</p>
    <div class="supply-map__plot">
      <SupplyMapSvg model={compact} title="半導体の工程の全体図" />
      <SupplyMapSvg model={wide} title="半導体の工程の全体図" />
      <FacilitiesBand />
    </div>
    <SourceLine title="企業マスタと工程の分類（掲載企業リスト）" publisher="SemiCompass" accessedOn={decided} />
  </figure>

  <h2 id="process-tables">工程ごとの企業</h2>
  <p class="measure">
    企業の数は、企業マスタでその工程に結び付けている企業の数です。1社が複数の工程に入る場合があります。企業名は証券コード順です。工程の分類と掲載の基準は、<a href="/editorial-policy/">編集方針</a>で説明しています。
  </p>
  <p class="supply-tools" data-expand-tools hidden>
    <button type="button" class="supply-tools__button" data-expand="open">企業をすべて開く</button>
    <button type="button" class="supply-tools__button" data-expand="close">企業をすべて閉じる</button>
  </p>
  {stages.map((s) => (
    <section aria-labelledby={`stage-${s.stage.slug}`} class="supply-stage">
      <h3 id={`stage-${s.stage.slug}`}>{s.stage.name}</h3>
      {s.items.map((p) => {
        const data = tableFor(p.slug);
        return (
          <section class="supply-process" aria-labelledby={`p-${p.slug}`}>
            <h4 id={`p-${p.slug}`} tabindex="-1">{p.name}</h4>
            {p.short_description && <p class="measure">{p.short_description}</p>}
            {data.length > 0 ? (
              <details class="supply-process__companies">
                <summary><Icon name="chevron" /><Icon name="building" /><span>企業を見る（{data.length}社）</span></summary>
                <ul class="supply-chips" aria-label={`${p.name}の企業`}>
                  {data.map((c) => <li><a href={c.href}>{c.name}</a></li>)}
                </ul>
              </details>
            ) : (
              <StateMessage kind="empty" message="この工程に結び付けた企業は、まだ掲載していません。" />
            )}
            <p class="supply-process__links">
              <a href={`/processes/${p.slug}/`}><Icon name="book" /><span>工程の解説</span></a>
              <a href={`/companies/process/${p.slug}/`}><Icon name="chart" /><span>売上高などを比べる一覧</span></a>
            </p>
          </section>
        );
      })}
      <p class="supply-stage__back"><a href="#supply-map-title"><Icon name="up" /><span>図に戻る</span></a></p>
    </section>
  ))}
</Page>

<style>
  @import "../../styles/breakpoints.css";

  .supply-map {
    margin: var(--space-5) 0 var(--space-7);
  }
  .supply-map__meta {
    margin-block: 0 var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--text-small);
    line-height: var(--text-small-leading);
    letter-spacing: var(--text-small-tracking);
  }
  /* 工場設備の帯の幅を、全体図の幅に揃える（列の幅は、全体図の幅で決まる） */
  .supply-map__plot {
    display: grid;
    justify-content: start;
    overflow-x: auto;
    padding-block: var(--space-2);
  }
  .supply-map__plot :global(.map-svg) {
    display: block;
  }
  .supply-map__plot :global(.map-svg--wide) {
    display: none;
  }
  .supply-process {
    margin-block: var(--space-5) var(--space-6);
  }
  .supply-process h4 {
    margin-block: 0 var(--space-2);
    font-size: var(--text-lead);
    line-height: var(--text-lead-leading);
    letter-spacing: var(--text-lead-tracking);
  }
  .supply-guide {
    margin-block: var(--space-3);
    padding-inline-start: var(--space-5);
  }
  .supply-guide li + li {
    margin-block-start: var(--space-1);
  }
  .supply-tools {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin-block: var(--space-3);
  }
  .supply-tools[hidden] {
    display: none;
  }
  .supply-tools__button {
    min-height: var(--target-min);
    padding-inline: var(--space-3);
    border: var(--border-width) solid var(--color-border-strong);
    border-radius: var(--radius-control);
    background: var(--color-surface);
    color: var(--color-primary);
    font: inherit;
    font-size: var(--text-dense);
    cursor: pointer;
  }
  .supply-process__companies summary {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--target-min);
    color: var(--color-primary);
    font-size: var(--text-dense);
    font-weight: var(--font-weight-bold);
    list-style: none;
    cursor: pointer;
  }
  .supply-process__companies summary::-webkit-details-marker {
    display: none;
  }
  .supply-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-2) 0 0;
    padding: 0;
    list-style: none;
  }
  .supply-chips a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tag-height);
    padding-inline: var(--space-3);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-control);
    background: var(--color-surface);
    font-size: var(--text-dense);
    line-height: var(--text-dense-leading);
    text-decoration: none;
  }
  .supply-chips a:hover,
  .supply-chips a:active {
    background: var(--color-surface-sunken);
  }
  .supply-stage {
    margin-block-end: var(--space-7);
    padding-block-end: var(--space-3);
    border-bottom: var(--border-width) solid var(--color-border);
  }
  .supply-stage__back {
    margin-block: var(--space-2) 0;
    font-size: var(--text-dense);
  }
  .supply-stage__back a,
  .supply-process__links a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--target-min);
  }
  @media (pointer: coarse) {
    .supply-chips a {
      min-height: var(--target-min);
    }
  }
  .supply-process__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin-block: var(--space-3) 0;
    font-size: var(--text-dense);
  }
  @media (--tablet) {
    .supply-map__plot :global(.map-svg--compact) {
      display: none;
    }
    .supply-map__plot :global(.map-svg--wide) {
      display: block;
    }
  }
</style>

<script>
  import '../../scripts/process-index';
</script>
