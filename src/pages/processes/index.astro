---
// 工程の一覧（/processes/）：data/supply-chain.yaml の工程を、段階ごとの見出しで、定義の一覧（名前、一文の説明）として並べる（カードにしない）
import Page from '../../layouts/Page.astro';
import { loadSupply } from '../../lib/companies';

const supply = loadSupply() as ReturnType<typeof loadSupply> & { processes: { slug: string; name: string; stage: string; order: number; short_description?: string }[] };
const stages = [...new Set(supply.processes.map((p) => p.stage))]
  .map((slug) => ({ slug, name: supply.categories.find((c) => c.slug === slug)?.name ?? slug,
    items: supply.processes.filter((p) => p.stage === slug).sort((a, b) => a.order - b.order) }))
  .sort((a, b) => a.items[0].order - b.items[0].order);
---

<Page
  title="工程の一覧｜SemiCompass"
  heading="工程の一覧"
  description="半導体ができるまでの工程の一覧。工程ごとに、関わる企業を確かめられます。"
  breadcrumbs={[{ label: 'ホーム', href: '/' }, { label: '工程' }]}
  wide
>
  <p class="measure">半導体は、設計から前工程、後工程までの多くの工程を経て作られます。工程の名前を選ぶと、その工程の説明と、関わる企業の一覧を見られます。</p>
  {stages.map((stage) => (
    <section aria-labelledby={`stage-${stage.slug}`}>
      <h2 id={`stage-${stage.slug}`}>{stage.name}</h2>
      <dl class="process-list">
        {stage.items.map((p) => (
          <>
            <dt><a href={`/processes/${p.slug}/`}>{p.name}</a></dt>
            <dd>{p.short_description}</dd>
          </>
        ))}
      </dl>
    </section>
  ))}
</Page>

<style>
  .process-list {
    max-width: var(--content-max-width);
    margin: 0;
  }
  .process-list dt {
    margin-block-start: var(--space-4);
    font-weight: var(--font-weight-bold);
  }
  .process-list dd {
    margin: 0 0 var(--space-3);
    font-size: var(--text-dense);
    line-height: var(--text-dense-leading);
  }
</style>
