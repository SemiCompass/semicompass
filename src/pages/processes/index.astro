---
// 工程の一覧とサプライチェーンマップ（/processes/。FR-102 MVP、仕様書 9.4）：工程の流れの図（トップと同じ部品。工程の行は、同じページの #p-{工程} へ移動）と、
// 段階ごとの工程の一覧（左に名前・一文の説明・2つのリンク、右にその工程の企業名のチップ）。企業名は開閉にせず、常に見せる。旧 /supply-chain/ は、ここへ転送する。
import { BUILD_ENV } from 'astro:env/server';
import Icon from '../../components/Icon.astro';
import ProcessFlow from '../../components/ProcessFlow.astro';
import SourceLine from '../../components/SourceLine.astro';
import StateMessage from '../../components/StateMessage.astro';
import Page from '../../layouts/Page.astro';
import { companyRows, loadCompanies, loadSupply } from '../../lib/companies';
import { orderedStages, type MapProcess, type MapStage } from '../../lib/supplyMap';

const supply = loadSupply() as unknown as { categories: MapStage[]; processes: (MapProcess & { short_description?: string })[] };
const rows = companyRows(BUILD_ENV === 'preview');
const stages = orderedStages(supply.categories, supply.processes);
const decided = loadCompanies()
  .map((c) => (c as unknown as { selection?: { decided_on?: string } }).selection?.decided_on ?? '')
  .sort()
  .pop() ?? '';
const toc = [
  { id: 'supply-map-title', label: '工程の全体図' },
  ...stages.map((s) => ({ id: `stage-${s.stage.slug}`, label: s.stage.name })),
];
// 段階の色（仕様書 4.5。色だけで区別せず、段階の名前を書く）
const stageColor: Record<string, string> = { design: 'neutral', materials: 'materials', 'front-end': 'front', 'back-end': 'back' };
// 工程ごとの企業：企業名だけを、証券コード順のチップで並べる。詳しいページのある企業は太字
const companiesOf = (slug: string) =>
  rows
    .filter((r) => r.company.processes.includes(slug))
    .map((r) => ({ href: `/companies/${r.company.slug}/`, name: r.company.short_names[0] ?? r.company.name, detailed: r.detailed }));
---

<Page
  title="半導体製造工程の一覧と関連企業のマップ｜SemiCompass"
  heading="工程の一覧とサプライチェーンマップ"
  description="半導体ができるまでの工程の一覧と、全体を1枚で見渡せる図。前工程・後工程などの工程ごとに、説明と、関わる企業を確かめられます。"
  breadcrumbs={[{ label: 'ホーム', href: '/' }, { label: '工程' }]}
  toc={toc}
  updatedAt={decided || undefined}
  wide
>
  <p class="lead measure">半導体ができるまでの主な工程と、各工程に関わる企業を一覧できます。図の工程を選ぶと、下の説明へ移動します。</p>

  <section class="supply-map" aria-labelledby="supply-map-title">
    <h2 id="supply-map-title">工程の全体図</h2>
    <p class="supply-map__meta">矢印は、おおまかな流れを示します。実際の製造では、同じ工程を何度も繰り返す場合があります。右の数は、その工程に関わる掲載企業の数です。</p>
    <ProcessFlow linkTo="anchor" />
    <SourceLine title="企業マスタと工程の分類（掲載企業リスト）" publisher="SemiCompass" accessedOn={decided} />
  </section>

  {stages.map((s) => (
    <section aria-labelledby={`stage-${s.stage.slug}`} class:list={['supply-stage', `supply-stage--${stageColor[s.stage.slug] ?? 'neutral'}`]}>
      <h2 id={`stage-${s.stage.slug}`} class="supply-stage__title">
        <span class="supply-stage__mark" aria-hidden="true"></span>{s.stage.name}<span class="supply-stage__count">{s.items.length}工程</span>
      </h2>
      {s.items.map((p) => {
        const list = companiesOf(p.slug);
        return (
          <section class="supply-process" aria-labelledby={`p-${p.slug}`}>
            <div class="supply-process__main">
              <h3 id={`p-${p.slug}`} tabindex="-1">{p.name}<span class="supply-process__n">{list.length}社</span></h3>
              {p.short_description && <p class="supply-process__desc">{p.short_description}</p>}
              <p class="supply-process__links">
                <a href={`/processes/${p.slug}/`}><Icon name="book" /><span>工程の解説</span></a>
                <a href={`/companies/process/${p.slug}/`}><Icon name="chart" /><span>売上高などを比べる</span></a>
              </p>
            </div>
            {list.length > 0 ? (
              <ul class="supply-chips" aria-label={`${p.name}の企業`}>
                {list.map((c) => <li><a class:list={{ 'is-detailed': c.detailed }} href={c.href}>{c.name}</a></li>)}
              </ul>
            ) : (
              <StateMessage kind="empty" message="この工程に結び付けた企業は、まだ掲載していません。" />
            )}
          </section>
        );
      })}
    </section>
  ))}

  <aside class="supply-notes" aria-labelledby="supply-notes-title">
    <p class="supply-notes__title" id="supply-notes-title">企業名の見方</p>
    <ul>
      <li>企業名は証券コード順です。太字の企業は、詳しいページがあります。</li>
      <li>企業の数は、企業マスタでその工程に結び付けている企業の数です。1社が複数の工程に入る場合があります。</li>
      <li>工程の分類と掲載の基準は、<a href="/editorial-policy/">編集方針</a>で説明しています。</li>
    </ul>
  </aside>
</Page>

<style>
  @import "../../styles/breakpoints.css";

  .supply-map {
    margin: var(--space-6) 0 0;
  }
  .supply-map__meta {
    max-width: var(--content-max-width);
    margin-block: 0 var(--space-4);
    color: var(--color-text-muted);
    font-size: var(--text-small);
    line-height: var(--text-small-leading);
    letter-spacing: var(--text-small-tracking);
  }
  /* 段階のまとまり：段階の色の四角と名前、右端に工程の数。下に段階の色の2pxの線 */
  .supply-stage {
    margin-block-start: var(--space-8);
  }
  .supply-stage--neutral {
    --stage-ink: var(--color-text);
  }
  .supply-stage--materials {
    --stage-ink: var(--color-stage-materials);
  }
  .supply-stage--front {
    --stage-ink: var(--color-stage-front);
  }
  .supply-stage--back {
    --stage-ink: var(--color-stage-back);
  }
  .supply-stage__title {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin: 0;
    padding-block-end: var(--space-3);
    border-bottom: var(--quiz-border-current) solid var(--stage-ink);
  }
  .supply-stage__mark {
    width: var(--space-4);
    height: var(--space-4);
    border-radius: var(--radius-control);
    background: var(--stage-ink);
  }
  .supply-stage__count {
    margin-inline-start: auto;
    color: var(--color-text-muted);
    font-size: var(--text-small);
    font-weight: var(--font-weight-normal);
  }
  /* 工程：左に名前・説明・リンク、右に企業名のチップ（タブレット以下は1列） */
  .supply-process {
    display: grid;
    gap: var(--space-3) var(--space-6);
    padding-block: var(--space-5);
    border-bottom: var(--border-width) solid var(--color-border);
  }
  .supply-process h3 {
    margin: 0;
    font-size: var(--text-h3);
    line-height: var(--text-h3-leading);
  }
  .supply-process__n {
    margin-inline-start: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-small);
    font-weight: var(--font-weight-normal);
    font-variant-numeric: tabular-nums;
  }
  .supply-process__desc {
    margin: var(--space-1) 0 0;
    color: var(--color-text-muted);
    font-size: var(--text-dense);
    line-height: var(--text-lead-leading);
  }
  .supply-process__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-4);
    margin: var(--space-2) 0 0;
    font-size: var(--text-small);
    font-weight: var(--font-weight-bold);
  }
  .supply-process__links a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: var(--target-min);
    text-decoration: none;
  }
  .supply-process__links a:hover {
    text-decoration: underline;
  }
  .supply-chips {
    display: flex;
    flex-wrap: wrap;
    align-content: flex-start;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .supply-chips a,
  .supply-chips a:visited {
    display: inline-flex;
    align-items: center;
    min-height: var(--tag-height);
    padding-inline: var(--space-3);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-control);
    background: var(--color-surface);
    color: var(--color-text);
    font-size: var(--text-small);
    line-height: var(--text-small-leading);
    text-decoration: none;
  }
  .supply-chips a.is-detailed {
    font-weight: var(--font-weight-bold);
  }
  .supply-chips a:hover,
  .supply-chips a:active {
    border-color: var(--color-primary);
    background: var(--color-primary-tint);
    color: var(--color-primary-hover);
  }
  @media (pointer: coarse) {
    .supply-chips a {
      min-height: var(--target-min);
    }
  }
  .supply-notes {
    max-width: var(--content-max-width);
    margin-block-start: var(--space-7);
    padding: var(--space-4) var(--space-5);
    background: var(--color-surface-sunken);
    font-size: var(--text-small);
    line-height: var(--text-small-leading);
  }
  .supply-notes__title {
    margin: 0 0 var(--space-1);
    font-weight: var(--font-weight-bold);
  }
  .supply-notes ul {
    margin: 0;
    padding-inline-start: var(--space-5);
    color: var(--color-text-muted);
  }
  @media (--pc) {
    .supply-process {
      grid-template-columns: var(--process-main-width) minmax(0, 1fr);
    }
  }
</style>
