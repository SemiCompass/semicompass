---
// 企業一覧（/companies/。仕様書 9.3）：表（8.7）。段階の絞り込みと「詳しいページのある企業だけ」、件数、並べ替え。カードの格子にしない
import { BUILD_ENV } from 'astro:env/server';
import CompanyTable from '../../components/CompanyTable.astro';
import Page from '../../layouts/Page.astro';
import { companyRows, loadSupply } from '../../lib/companies';

const supply = loadSupply();
const rows = companyRows(BUILD_ENV === 'preview');
const detailedCount = rows.filter((r) => r.detailed).length;
---

<Page
  title="企業一覧｜SemiCompass"
  heading="企業一覧"
  description="半導体に関わる日本の企業の一覧。工程、売上高、半導体関連の比率、営業利益率、平均年間給与を、表で比べられます。"
  breadcrumbs={[{ label: 'ホーム', href: '/' }, { label: '企業' }]}
  wide
>
  <p class="lead measure">半導体に関わる日本の企業を、工程と業績の数字で比べられます。詳しい内容を公開している企業は{detailedCount}社で、そのほかは準備中です。数値は最新の通期・連結です。</p>
  <CompanyTable rows={rows} caption="企業の一覧" processes={supply.processes}>
    <p class="measure"><a href="/processes/">工程ごとの一覧のページ</a>から、工程を選んで企業を見ることもできます。</p>
  </CompanyTable>
</Page>
