---
// 企業ページ（/companies/{slug}/。要件定義書 3.4、仕様書 9.2）。
//   詳細掲載：見出し → この会社のポイント → 目次 → 事業概要・工程上の位置づけ → 業績 → IR重要ポイント → 働く環境 → ニュース → 資料 → 出典・関連
//   Coming Soon：見出し、Coming Soon の表示、公開範囲と今後の予定へのリンク、同じ工程の詳細掲載の企業へのリンクだけ。検索に登録させない
// content/companies/{slug}.md が draft: true の企業は、本番のビルドでは Coming Soon、プレビューのビルド（BUILD_ENV=preview）でだけ詳細掲載（確認のため）
import { BUILD_DATE, BUILD_ENV } from 'astro:env/server';
import Chart from '../../components/Chart.astro';
import ExternalLink from '../../components/ExternalLink.astro';
import CompanyHead from '../../components/CompanyHead.astro';
import KeyPoints from '../../components/KeyPoints.astro';
import FigureNotes from '../../components/FigureNotes.astro';
import Notice from '../../components/Notice.astro';
import Phrase from '../../components/Phrase.astro';
import RichText from '../../components/RichText.astro';
import SourceLine from '../../components/SourceLine.astro';
import SourceList from '../../components/SourceList.astro';
import AdSlot from '../../components/AdSlot.astro';
import PageFeedback from '../../components/PageFeedback.astro';
import StateMessage from '../../components/StateMessage.astro';
import Tag from '../../components/Tag.astro';
import DataTable from '../../components/DataTable.astro';
import Page from '../../layouts/Page.astro';
import { buildDate } from '../../lib/buildDate';
import { millionToOku } from '../../lib/format';
import { chartBehind, irPeriodLabel, irStatus, loadIrPoints, loadOperationsDays, shiftCitations } from '../../lib/irPoints';
import {
  annualRows, companyRows, dateLabel, employeeSpec, formatNumber, formatOku, isDetailed, loadAuto, loadChartColors, loadCompanies, salesOperatingSpec,
  loadOverview, loadSegmentMap, loadSupply, periodLabel, periodRange, regionSpec, segmentSpec,
  type Company,
} from '../../lib/companies';

const preview = BUILD_ENV === 'preview';

export function getStaticPaths() {
  return loadCompanies().map((company) => ({ params: { slug: company.slug }, props: { company } }));
}

const { company } = Astro.props as { company: Company };
const overview = loadOverview(company.slug);
const auto = loadAuto(company.slug);
const detailed = isDetailed(company, overview, auto, preview);
const supply = loadSupply();
const all = loadCompanies();
const processName = (slug: string) => supply.processes.find((p) => p.slug === slug)?.name ?? slug;
const categoryName = (slug: string) => supply.categories.find((c) => c.slug === slug)?.name ?? slug;
const typeLabel: Record<string, string> = { domestic_listed: '国内上場企業', conglomerate: '総合メーカー', foreign_subsidiary: '外資系日本法人' };
const sameProcess = all.filter(
  (c) => c.slug !== company.slug && c.processes.some((p) => company.processes.includes(p)),
);
const title = `${company.name}｜SemiCompass`;
const breadcrumbs = [{ label: 'ホーム', href: '/' }, { label: '企業', href: '/companies/' }, { label: company.name }];

// ---- 詳細掲載の材料（数値はすべて data/auto などのファイルから） ----
const colors = loadChartColors();
const rows = auto ? annualRows(auto) : [];
const latest = rows[rows.length - 1];
const filing = auto && latest ? auto.filings.find((f) => f.doc_id === latest.doc_id) : undefined;
const source = {
  title: latest ? `有価証券報告書（${periodLabel(latest.fiscal_period_end)}）` : '有価証券報告書',
  publisher: 'EDINET',
  accessedOn: auto ? auto.updated_at.slice(0, 10) : '',
};
const salesOperating = salesOperatingSpec(rows, colors.metrics);
const segmentMap = loadSegmentMap(company.slug);
const segment = segmentMap && latest ? segmentSpec(rows, segmentMap, colors, periodLabel(latest.fiscal_period_end)) : null;
const region = regionSpec(rows, colors);
const employees = auto ? employeeSpec(auto, colors) : null;
const standards = [...new Set(rows.map((r) => r.accounting_standard))];
const standardName: Record<string, string> = { jgaap: '日本基準', ifrs: 'IFRS', usgaap: '米国基準' };
const latestEmployee = employees ? employees.rows[employees.rows.length - 1] : undefined;
const nonConsolidated = latestEmployee?.non_consolidated;

// 主要な数値の帯（8.8）：売上高、営業利益、営業利益率、平均年間給与。売上高と営業利益は前期比と直近6期の推移の線
const prev = rows[rows.length - 2];
const okuOf = (v: number | null | undefined) => (v == null ? null : millionToOku(v));
const signed = (v: number) => `${v >= 0 ? '+' : '−'}${formatNumber(Math.abs(v), 1)}%`;
const change = (cur: number | null, before: number | null) =>
  cur != null && before != null && before > 0 ? (cur / before - 1) * 100 : null;
const marginOf = (r?: (typeof rows)[number]) =>
  r && r.net_sales.value != null && r.operating_income.value != null && r.net_sales.value > 0 ? (r.operating_income.value / r.net_sales.value) * 100 : null;
const mineRow = companyRows(preview).find((r) => r.company.slug === company.slug);
const metricOf = (label: string, key: 'net_sales' | 'operating_income') => {
  const cur = okuOf(latest?.[key].value);
  if (cur == null) return [];
  const ch = change(cur, okuOf(prev?.[key].value));
  return [{
    label, value: formatNumber(cur, 0), unit: '億円',
    note: ch == null ? undefined : `前期比 ${signed(ch)}`, trend: ch == null ? undefined : ch >= 0 ? ('up' as const) : ('down' as const),
    spark: rows.slice(-6).map((r) => okuOf(r[key].value)).filter((v): v is number => v != null),
  }];
};
const margin = marginOf(latest);
const prevMargin = marginOf(prev);
const metrics = [
  ...metricOf('売上高', 'net_sales'),
  ...metricOf('営業利益', 'operating_income'),
  ...(margin != null ? [{ label: '営業利益率', value: formatNumber(margin, 1), unit: '%', note: prevMargin != null ? `前期 ${formatNumber(prevMargin, 1)}%` : undefined }] : []),
  ...(mineRow?.salary != null
    ? [{ label: '平均年間給与', value: formatNumber(mineRow.salary, 0), unit: '万円',
        note: nonConsolidated?.average_age?.value != null ? `提出会社・平均${formatNumber(nonConsolidated.average_age.value, 1)}歳` : '提出会社' }]
    : []),
];

// 同じ工程の企業と比べる（9.2）：主な工程（processes の最初）の掲載企業のうち、詳しいページがあり売上高のある企業を、売上高の大きい順に
const mainProcess = company.processes[0];
const peersAll = mainProcess ? companyRows(preview).filter((r) => r.company.processes.includes(mainProcess)) : [];
const peers = peersAll.filter((r) => r.detailed && r.sales != null).sort((a, b) => (b.sales ?? 0) - (a.sales ?? 0));
const peerMax = Math.max(0, ...peers.map((r) => r.sales ?? 0));

const toc = [
  { id: 'overview', label: '事業概要' },
  { id: 'process-position', label: '工程上の位置づけ' },
  { id: 'performance', label: '業績' },
  ...(peers.length > 1 ? [{ id: 'peers', label: '同じ工程の企業と比べる' }] : []),
  { id: 'ir-points', label: 'IR重要ポイント' },
  { id: 'work', label: '働く環境' },
  { id: 'news', label: 'ニュース' },
  { id: 'documents', label: '資料' },
  { id: 'sources-heading', label: '出典・関連' },
];

// 出典の一覧：事業概要の sources（S1 など）に、業績の元の書類がなければ足す
const sources = overview
  ? overview.front.sources.map((s) => ({
      number: Number(s.id.slice(1)), title: s.title, publisher: s.publisher, url: s.url, publishedOn: s.published_on,
      accessedOn: s.accessed_on, pages: s.pages, edinet: s.url.includes('edinet'),
    }))
  : [];
if (filing && !overview?.front.sources.some((s) => s.doc_id === filing.doc_id)) {
  sources.push({ number: Math.max(0, ...sources.map((s) => s.number)) + 1, title: source.title, publisher: 'EDINET', url: filing.url,
    publishedOn: filing.submitted_at.slice(0, 10), accessedOn: source.accessedOn, pages: undefined, edinet: true });
}
// IR重要ポイント（FR-307）と、最新の決算の反映（CT-03）。出典は、ページの出典の一覧の続きの番号にする
const irPoints = company.type === 'foreign_subsidiary' ? [] : loadIrPoints(company.slug, preview);
const ir = irStatus(auto?.announcements ?? [], irPoints, buildDate(BUILD_DATE), loadOperationsDays());
const irOffset = Math.max(0, ...sources.map((s) => s.number));
const irSections = ir.point
  ? ir.point.sections.filter((s) => s.heading).map((s) => ({ heading: s.heading, paragraphs: s.paragraphs.map((p) => shiftCitations(p, irOffset)) }))
  : [];
if (ir.point) {
  for (const s of ir.point.front.sources) {
    sources.push({ number: Number(s.id.slice(1)) + irOffset, title: s.title, publisher: s.publisher, url: s.url, publishedOn: s.published_on,
      accessedOn: s.accessed_on, pages: s.pages, edinet: (s.url ?? '').includes('edinet') });
  }
}
const irTanshin = ir.latest?.documents.find((d) => d.type === 'tanshin');
const irBehind = ir.point ? chartBehind(ir.point, auto?.financials ?? []) : false;
const headingIds: Record<string, string> = { 事業概要: 'overview', 工程上の位置づけ: 'process-position' };
---

{detailed && overview ? (
  <Page
    title={title}
    heading={company.name}
    description={`${company.name}の事業概要、工程上の位置づけ、業績。${company.tagline}。`}
    breadcrumbs={breadcrumbs}
    toc={toc}
    publishedAt={overview.front.published_at}
    updatedAt={overview.front.updated_at}
    schemaType="Article"
    noindex={overview.front.draft === true}
  >
    <CompanyHead slot="head" company={company} typeLabel={typeLabel[company.type] ?? company.type} publishedAt={overview.front.published_at} updatedAt={overview.front.updated_at} author="hysd（SemiCompass運営者）" />
    <Fragment slot="lead">
      {latest && metrics.length > 0 && (
        <KeyPoints metrics={metrics} caption={`${periodLabel(latest.fiscal_period_end)}・連結。出典：${source.title}、EDINET。${dateLabel(source.accessedOn)}確認`} />
      )}
      {overview.front.draft && (
        <Notice kind="warning" title="下書きです（プレビューだけに表示しています）">
          <p>この企業ページは、運営者の確認の前の下書きです。本番のサイトでは、Coming Soon として表示されます。</p>
        </Notice>
      )}
    </Fragment>

    {overview.sections.map((section) => (
      <section aria-labelledby={headingIds[section.heading]}>
        <h2 id={headingIds[section.heading] ?? section.heading}><Phrase text={section.heading} /></h2>
        {section.paragraphs.map((paragraph) => <p><RichText text={paragraph} /></p>)}
      </section>
    ))}

    <section aria-labelledby="performance">
      <h2 id="performance"><Phrase text="業績" /></h2>
      {standards.length > 1 && (
        <Notice kind="note" title="会計基準の切り替え">
          <p>期によって会計基準が違います（{standards.map((s) => standardName[s] ?? s).join('、')}）。違う基準の期を、単純には比べられません。</p>
        </Notice>
      )}
      {salesOperating ? (
        <Chart id="sales" title={salesOperating.series.length > 1 ? '売上高と営業利益の推移' : '売上高の推移'} unit="億円" period={periodRange(rows)} spec={salesOperating} source={source} />
      ) : (
        <StateMessage kind="empty" message="売上高のデータがありません。" />
      )}
      <>
        {segment?.spec ? (
          <Chart id="segment" title="セグメント別の売上の推移" unit="億円" period={periodRange(rows.filter((r) => r.segments.length > 0))} spec={segment.spec} source={source} />
        ) : segment?.single ? (
          <>
            <h3>セグメント別の売上</h3>
            <p>報告セグメントは「{segment.single.name}」の1つです（全社の売上が半導体関連）。</p>
            {segment.single.source && (
              <SourceLine
                title={`${segment.single.source.title}（${segment.single.source.pages}）`}
                publisher={segment.single.source.publisher}
                accessedOn={segment.single.source.accessedOn}
              />
            )}
          </>
        ) : (
          <>
            <h3>セグメント別の売上</h3>
            <StateMessage
              kind="empty"
              message={segment?.reason ?? 'セグメントの区分が未確認のため、セグメント別の売上のグラフは、まだありません。'}
              actionLabel="売上高の推移を見る"
              actionHref="#performance"
            />
          </>
        )}
      </>
      {region ? (
        <Chart id="region" title="地域別の売上" unit="億円" period={region.period} spec={region.spec} source={source} />
      ) : (
        <>
          <h3>地域別の売上</h3>
          <StateMessage kind="empty" message="地域別の売上は、まだ取り込んでいません。" />
        </>
      )}
    </section>
    <AdSlot page="company" position="after-financials" />

    {peers.length > 1 && (
      <section aria-labelledby="peers">
        <h2 id="peers"><Phrase text="同じ工程の企業と比べる" /></h2>
        <p class="peers-cap">売上高（億円、最新の通期・連結）。工程：{processName(mainProcess)}。</p>
        <ol class="peers">
          {peers.map((r) => (
            <li class:list={['peers__row', { 'peers__row--me': r.company.slug === company.slug }]}>
              <span class="peers__name">{r.company.slug === company.slug ? (r.company.short_names[0] ?? r.company.name) : <a href={`/companies/${r.company.slug}/`}>{r.company.short_names[0] ?? r.company.name}</a>}</span>
              <svg class="peers__bar" viewBox="0 0 100 8" preserveAspectRatio="none" aria-hidden="true" focusable="false"><rect class="peers__track" width="100" height="8" /><rect class="peers__fill" width={Math.max(2, ((r.sales ?? 0) / peerMax) * 100).toFixed(1)} height="8" /></svg>
              <span class="peers__value">{formatNumber(r.sales ?? 0, 1)}</span>
            </li>
          ))}
        </ol>
        <p class="peers-cap">{processName(mainProcess)}の掲載企業{peersAll.length}社のうち、詳しいページのある{peers.length}社。<a href={`/companies/process/${mainProcess}/`}>一覧のページで比べる</a></p>
      </section>
    )}

    <section aria-labelledby="ir-points">
      <h2 id="ir-points"><Phrase text="IR重要ポイント" /></h2>
      {ir.stale && ir.latest && (
        <Notice kind="warning">
          <p>最新の決算は未反映です（決算発表：{dateLabel(ir.latest.announced_on)}）。{irTanshin && <ExternalLink href={irTanshin.url}>決算短信を見る</ExternalLink>}</p>
        </Notice>
      )}
      {ir.point ? (
        <>
          <p class="ir-meta">対象：{irPeriodLabel(ir.point.front.fiscal_period_end, ir.point.front.quarter)}（決算発表 {dateLabel(ir.point.front.announced_on)}）・作成日：{dateLabel(ir.point.front.updated_at ?? ir.point.front.published_at)}</p>
          {irSections.map((section) => (
            <>
              <h3>{section.heading}</h3>
              {section.paragraphs.map((paragraph) => <p><RichText text={paragraph} /></p>)}
            </>
          ))}
          {irBehind && (
            <Notice kind="note">
              <p>{ir.point.front.uses_quarterly_figures ? '業績の要点の四半期の数値は、決算短信によります。' : ''}業績のグラフは、有価証券報告書・半期報告書の数値で、この決算の期はまだ含みません。{ir.point.front.sources[0]?.url && <ExternalLink href={ir.point.front.sources[0].url}>決算短信を見る</ExternalLink>}</p>
            </Notice>
          )}
          <p class="ir-meta">元にした資料：{ir.point.front.sources.map((s) => s.title).join('、')}（出典の一覧を参照）</p>
        </>
      ) : (
        <StateMessage kind="empty" message="IR重要ポイントは、まだありません。" actionLabel={company.ir_url ? '会社のIRページを見る' : undefined} actionHref={company.ir_url} />
      )}
    </section>

    <section aria-labelledby="work">
      <h2 id="work"><Phrase text="働く環境" /></h2>
      {employees && latestEmployee ? (
        <>
          <Chart id="employees" title={`従業員数の推移（${employees.scope}）`} unit="人" period={periodRange(employees.rows)} spec={employees.spec} source={source} />
          {nonConsolidated && (
            <DataTable
              caption="提出会社単体の従業員の状況"
              columns={[{ key: 'item', label: `項目（${periodLabel(latestEmployee.fiscal_period_end)}、提出会社単体）` }, { key: 'value', label: '値', numeric: true }]}
              rows={[
                ...(nonConsolidated.employees.value != null ? [{ item: '従業員数（人）', value: formatNumber(nonConsolidated.employees.value, 0) }] : []),
                ...(nonConsolidated.average_age?.value != null ? [{ item: '平均年齢（歳）', value: formatNumber(nonConsolidated.average_age.value, 1) }] : []),
                ...(nonConsolidated.average_length_of_service?.value != null ? [{ item: '平均勤続年数（年）', value: formatNumber(nonConsolidated.average_length_of_service.value, 1) }] : []),
                ...(nonConsolidated.average_annual_salary?.value != null ? [{ item: '平均年間給与（万円）', value: formatNumber(nonConsolidated.average_annual_salary.value / 10000, 1) }] : []),
              ]}
            />
          )}
          <FigureNotes kind="work" holding={company.is_holding_company} />
        </>
      ) : (
        <StateMessage kind="empty" message="働く環境のデータは、まだありません。" />
      )}
      {company.recruit_url && <p><ExternalLink href={company.recruit_url}>採用ページ</ExternalLink></p>}
    </section>

    <section aria-labelledby="news">
      <h2 id="news"><Phrase text="ニュース" /></h2>
      <StateMessage kind="empty" message={`${company.name}に関するニュース解説は、まだありません。`} actionLabel="ニュースの一覧を見る" actionHref="/news/" />
    </section>

    <section aria-labelledby="documents">
      <h2 id="documents"><Phrase text="資料" /></h2>
      <ul>
        {filing && <li><ExternalLink href={filing.url}>{source.title}（EDINET）</ExternalLink></li>}
        {company.ir_url && <li><ExternalLink href={company.ir_url}>IRページ</ExternalLink></li>}
        {company.website_url && <li><ExternalLink href={company.website_url}>会社の公式サイト</ExternalLink></li>}
      </ul>
    </section>

    <AdSlot page="company" position="after-body" />

    <section aria-labelledby="sources-heading">
      <SourceList sources={sources} heading="出典" />
      <h2 id="related"><Phrase text="関連するページ" /></h2>
      {sameProcess.length > 0 ? (
        <ul>
          {sameProcess.slice(0, 6).map((c) => <li><a href={`/companies/${c.slug}/`}>{c.short_names[0] ?? c.name}</a>：{c.tagline}</li>)}
        </ul>
      ) : (
        <StateMessage kind="empty" message="同じ工程の企業は、まだありません。" />
      )}
    </section>
    <PageFeedback pageType="company" />
    <Fragment slot="aside" />
    <AdSlot slot="aside-ad" page="company" position="aside" />
  </Page>
) : (
  <Page title={title} heading={company.name} description={`${company.name}のページは、準備中です。`} breadcrumbs={breadcrumbs} noindex wide>
    <p class="company-meta">
      {company.securities_code && <span>証券コード：<span class="nowrap">{company.securities_code}</span></span>}
      <span>企業区分：{typeLabel[company.type] ?? company.type}</span>
    </p>
    <p class="company-tags">
      {company.processes.map((p) => <Tag href={`/processes/${p}/`} kind="工程">{processName(p)}</Tag>)}
    </p>
    <Notice kind="note" title="Coming Soon">
      <p>このページは準備中です。詳しい内容は、順に公開します。<a href="/about/roadmap/">公開範囲と今後の予定</a>をご覧ください。</p>
    </Notice>
    <h2><Phrase text="同じ工程の企業" /></h2>
    {(() => {
      const links = sameProcess.filter((c) => {
        const o = loadOverview(c.slug);
        return isDetailed(c, o, loadAuto(c.slug), preview);
      });
      return links.length > 0 ? (
        <ul>
          {links.slice(0, 6).map((c) => <li><a href={`/companies/${c.slug}/`}>{c.short_names[0] ?? c.name}</a>：{c.tagline}</li>)}
        </ul>
      ) : (
        <StateMessage kind="empty" message="同じ工程で、詳しい内容を公開している企業は、まだありません。" actionLabel="公開範囲と今後の予定を見る" actionHref="/about/roadmap/" />
      );
    })()}
  </Page>
)}

<style>
  @import "../../styles/breakpoints.css";
  /* 同じ工程の企業と比べる（9.2）：企業名、売上高の横棒、売上高 */
  .peers-cap {
    color: var(--color-text-muted);
    font-size: var(--text-small);
    line-height: var(--text-small-leading);
  }
  .peers {
    margin: 0;
    padding: 0;
    border-top: var(--border-width) solid var(--color-border);
    list-style: none;
  }
  .peers__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--peer-bar-width-sp) auto;
    align-items: center;
    gap: var(--space-4);
    min-height: var(--target-min);
    padding-block: var(--space-2);
    border-bottom: var(--border-width) solid var(--color-border);
    font-size: var(--text-dense);
    line-height: var(--text-dense-leading);
  }
  .peers__row--me {
    font-weight: var(--font-weight-bold);
  }
  /* 横棒は、CSPで属性の style を使えないため、SVGの幅で示す */
  .peers__bar {
    display: block;
    width: 100%;
    height: var(--peer-bar-height);
  }
  .peers__track {
    fill: var(--color-surface-sunken);
  }
  .peers__fill {
    fill: var(--color-primary);
  }
  .peers__value {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  @media (--tablet) {
    .peers__row {
      grid-template-columns: minmax(0, 1fr) var(--peer-bar-width) auto;
    }
  }
  /* IR重要ポイントの対象の期・作成日・元にした資料（補助の文字） */
  .ir-meta {
    color: var(--color-text-muted);
    font-size: var(--text-small);
    line-height: var(--text-small-leading);
  }
  .company-meta {
