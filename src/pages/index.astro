---
// トップページ（/。要件定義書 3.3、仕様書 9.1）：説明の一文（h1）→ サイトの説明 → 3つの入口 → 半導体ができるまで（工程の全体図）
// → 半導体関連の売上高の上位10社（グラフ）→ 新着のニュース解説（最大5件）。
// 最初の画面（幅360px、高さ約640px）に、説明と3つの入口が収まる。同じ形のカードを3つ並べない（定義の一覧）
import { BUILD_ENV } from 'astro:env/server';
import Chart from '../components/Chart.astro';
import ExternalLink from '../components/ExternalLink.astro';
import FacilitiesBand from '../components/FacilitiesBand.astro';
import Phrase from '../components/Phrase.astro';
import SearchBox from '../components/SearchBox.astro';
import StateMessage from '../components/StateMessage.astro';
import SupplyMapSvg from '../components/SupplyMapSvg.astro';
import Tag from '../components/Tag.astro';
import Base from '../layouts/Base.astro';
import { companyRows, dateLabel, loadAuto, loadChartColors, loadCompanies, loadSupply } from '../lib/companies';
import { loadMenu } from '../lib/menu';
import { loadNews } from '../lib/news';
import { buildSupplyMap, orderedStages, type MapProcess, type MapStage } from '../lib/supplyMap';

const supply = loadSupply() as unknown as { categories: MapStage[]; processes: MapProcess[] };
const { note } = loadMenu();
const preview = BUILD_ENV === 'preview';

// 新着のニュース解説（9.1 の6）：新しい順に最大5件。日付、見出し、関係する企業のタグ
const news = loadNews(preview).slice(0, 5);
const companies = loadCompanies();
const companyTags = (slugs: string[]) =>
  slugs.flatMap((slug) => {
    const c = companies.find((x) => x.slug === slug);
    return c ? [{ slug, name: c.short_names[0] ?? c.name }] : [];
  });

// 半導体ができるまで（9.1 の4）：タブレット以上は工程の全体図、スマートフォンは段階ごとの要約（全体図は縦に長くなるため）
const rows = companyRows(preview);
const counts: Record<string, number> = {};
for (const r of rows) for (const p of r.company.processes) counts[p] = (counts[p] ?? 0) + 1;
const mapWide = buildSupplyMap(supply.categories, supply.processes, counts, 'wide');
const stageSummary = orderedStages(supply.categories, supply.processes).map(({ stage, items }) => ({
  slug: stage.slug,
  name: stage.name,
  processes: items.length,
  companies: rows.filter((r) => r.company.processes.some((p) => items.some((i) => i.slug === p))).length,
}));

// 工場設備（分類 facilities）：特定の工程ではなく、工場全体を支える会社。スマートフォンの一覧の最後の行と、全体図の下の帯
const facilities = supply.categories.find((c) => c.slug === 'facilities');
const facilitiesCount = companies.filter((c) => c.categories.includes('facilities')).length;

// 半導体関連の売上高の上位10社（9.1 の5）：売上高（最新の通期、連結）× 半導体関連の比率（セグメント対応表。企業ページと同じ値）
const semi = (r: (typeof rows)[number]) => (r.sales !== null && r.ratio !== null ? Math.round((r.sales * r.ratio) / 100) : null);
const ranked = rows.filter((r) => r.detailed && semi(r) !== null).sort((a, b) => (semi(b) ?? 0) - (semi(a) ?? 0)).slice(0, 10);
const colors = loadChartColors();
const chartName = (r: (typeof rows)[number]) => (r.company.short_names[0] ?? r.company.name).replace(/・?(ホールディングス|グループ)$/, '');
const salesSpec = {
  kind: 'hbar' as const, unit: '億円', decimals: 0, labelLatest: false,
  categories: ranked.map((r) => { const n = chartName(r); return { label: n, short: n.length > 8 ? `${n.slice(0, 7)}…` : n, lines: [n] }; }),
  series: [{ name: '半導体関連の売上高', color: colors.metrics.net_sales.color, values: ranked.map(semi) }],
};
// 出典の確認日：グラフに使った企業の、自動取得のデータの更新日のうち、もっとも新しい日
const accessedOn = ranked.map((r) => loadAuto(r.company.slug)?.updated_at.slice(0, 10) ?? '').sort().pop() ?? '';
const entryStages = ['front-end', 'back-end'].map((slug) => ({ slug, name: supply.categories.find((c) => c.slug === slug)?.name ?? slug }));
---

<Base title="SemiCompass（セミコンパス）｜日本の半導体業界を、企業・工程・ニュースでつなげて理解する" description="半導体ができるまでの工程と、そこに関わる日本の企業を、図と業績の数字でたどれる情報サイト。ニュースは、どの工程・どの企業に関わるかまで解説します。">
  <div class="container home">
    <h1 class="home__title"><Phrase text="日本の半導体業界を、企業・工程・ニュースでつなげて理解する" /></h1>
    <p class="lead measure home__lead">
      半導体の工程と、そこに関わる日本の企業を、図と業績の数字でたどれます。
    </p>

    <dl class="entries">
      <div class="entries__item">
        <dt><a href="/processes/">工程から探す</a></dt>
        <dd>
          <ul class="entries__links">
            {entryStages.map((s) => <li><a href={`/processes/#stage-${s.slug}`}>{s.name}</a></li>)}
            <li><a href="/processes/">すべての工程</a></li>
          </ul>
        </dd>
      </div>
      <div class="entries__item">
        <dt><a href="/news/">ニュースから探す</a></dt>
        <dd>何が起きたか、なぜ重要か、どの工程・企業に関わるかを解説します。</dd>
      </div>
      <div class="entries__item">
        <dt>企業名・証券コードで探す</dt>
        <dd><SearchBox id="home-search" /></dd>
      </div>
    </dl>

    <section aria-labelledby="home-map-title" class="home__map">
      <h2 id="home-map-title">半導体ができるまで</h2>
      <p class="measure">設計と材料から、前工程、後工程を経て、半導体ができます。数は、その工程に関わる掲載企業の数です。工場全体を支える設備の会社は、最後にまとめました。</p>
      <ol class="stage-summary">
        {stageSummary.map((s) => (
          <li class="stage-summary__item">
            <a class="stage-summary__name" href={`/processes/#stage-${s.slug}`}>{s.name}</a>
            <span class="stage-summary__count">{s.processes}工程・{s.companies}社</span>
          </li>
        ))}
        {facilities && facilitiesCount > 0 && (
          <li class="stage-summary__item">
            <a class="stage-summary__name" href={`/companies/process/${facilities.slug}/`}>{facilities.name}</a>
            <span class="stage-summary__count">工場全体・{facilitiesCount}社</span>
          </li>
        )}
      </ol>
      <div class="home__map-plot">
        <SupplyMapSvg model={mapWide} title="半導体の工程の全体図" hrefBase="/processes/" />
        <FacilitiesBand />
      </div>
      <p class="home__more"><a href="/processes/">工程の一覧と、工程ごとの企業を見る</a></p>
    </section>

    <section aria-labelledby="home-sales-title" class="home__sales">
      <h2 id="home-sales-title">半導体の売上が大きい企業</h2>
      <p class="measure">連結の売上高に、半導体関連の事業の比率を掛けた値です。総合メーカーも、半導体の部分だけで比べられます。</p>
      <Chart id="home-sales" title="半導体関連の売上高（最新の通期）の上位10社" unit="億円" period="各社の最新の通期（決算期は企業により異なる）" spec={salesSpec}
        source={{ title: '有価証券報告書', publisher: 'EDINET（金融庁）', accessedOn }} />
      <p class="home__more"><a href="/companies/">掲載企業の売上高・営業利益率・平均年間給与を表で比べる</a></p>
    </section>

    <section aria-labelledby="latest-news" class="home__news">
      <h2 id="latest-news">新着のニュース解説</h2>
      {news.length === 0 ? (
        <StateMessage kind="empty" message="ニュース解説は、まだありません。" actionLabel="企業の一覧を見る" actionHref="/companies/" />
      ) : (
        <>
          <ol class="home-news">
            {news.map((n) => (
              <li class="home-news__item">
                <time class="home-news__date" datetime={n.front.published_at}>{dateLabel(n.front.published_at)}</time>
                <h3 class="home-news__title"><a href={n.url}><Phrase text={n.front.title} /></a></h3>
                {companyTags(n.front.tags.companies).length > 0 && (
                  <p class="home-news__tags">{companyTags(n.front.tags.companies).map((c) => <Tag href={`/companies/${c.slug}/`} kind="企業">{c.name}</Tag>)}</p>
                )}
              </li>
            ))}
          </ol>
          <p class="home-news__more"><a href="/news/">ニュース解説の一覧</a></p>
        </>
      )}
    </section>

    <p class="measure home__note">運営者は、noteでも発信しています。<ExternalLink href={note.url}>{note.label}</ExternalLink></p>
  </div>
</Base>

<style>
  @import "../styles/breakpoints.css";

  /* まとまりは余白で示す（仕様書 6.1）。スマートフォンは、最初の画面（360×640）に説明と3つの入口が収まる範囲に抑え、
     タブレット以上で、--space-7〜--space-8 を取る */
  .home {
    padding-block: var(--space-3) var(--space-6);
  }
  .home__title {
    margin-block-end: var(--space-2);
  }
  .home__lead {
    margin-block-end: var(--space-4);
  }
  .entries {
    margin: 0;
    padding: 0;
  }
  @media (--tablet) {
    .home {
      padding-block: var(--space-7) var(--space-8);
    }
    .home__lead {
      margin-block-end: var(--space-7);
    }
  }
  .entries__item {
    padding-block: var(--space-1);
    border-top: var(--border-width) solid var(--color-border);
  }
  .entries dt {
    font-size: var(--text-lead);
    font-weight: var(--font-weight-bold);
    line-height: var(--text-lead-leading);
    letter-spacing: var(--text-lead-tracking);
  }
  .entries dd {
    margin: 0;
    font-size: var(--text-dense);
    line-height: var(--text-dense-leading);
  }
  .entries__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .entries__links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
  }
  .home__news {
    margin-block-start: var(--space-7);
  }
  .home__note {
    margin-block-start: var(--space-6);
    color: var(--color-text-muted);
    font-size: var(--text-small);
    line-height: var(--text-small-leading);
    letter-spacing: var(--text-small-tracking);
  }
  .home__news h2 {
    margin-block-start: 0;
  }
  /* 新着のニュース解説：1件ずつ罫線で区切る（ニュースの一覧と同じ並べ方。仕様書 9.6） */
  .home__map,
  .home__sales {
    margin-block-start: var(--space-7);
  }
  .home__map h2,
  .home__sales h2 {
    margin-block-start: 0;
  }
  /* スマートフォン：段階ごとの要約（1行ずつ罫線で区切る）。タブレット以上：工程の全体図 */
  .stage-summary {
    max-width: var(--content-max-width);
    margin: var(--space-4) 0 0;
    padding: 0;
    border-top: var(--border-width) solid var(--color-border);
    list-style: none;
  }
  .stage-summary__item {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0 var(--space-4);
    border-bottom: var(--border-width) solid var(--color-border);
  }
  .stage-summary__name {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
    font-size: var(--text-lead);
    font-weight: var(--font-weight-bold);
    line-height: var(--text-lead-leading);
  }
  .stage-summary__count {
    color: var(--color-text-muted);
    font-size: var(--text-small);
    line-height: var(--text-small-leading);
    font-variant-numeric: tabular-nums;
  }
  .home__map-plot {
    display: none;
    overflow-x: auto;
    padding-block: var(--space-3);
  }
  .home__map-plot :global(.map-svg) {
    display: block;
  }
  @media (--tablet) {
    .stage-summary {
      display: none;
    }
    /* 工場設備の帯の幅を、全体図の幅に揃える（列の幅は、全体図の幅で決まる） */
    .home__map-plot {
      display: grid;
      justify-content: start;
    }
  }
  .home__more {
    margin-block-start: var(--space-3);
  }
  .home-news {
    max-width: var(--content-max-width);
    margin: var(--space-4) 0 0;
    padding: 0;
    border-top: var(--border-width) solid var(--color-border);
    list-style: none;
  }
  .home-news__item {
    padding-block: var(--space-4);
    border-bottom: var(--border-width) solid var(--color-border);
  }
  .home-news__date {
    color: var(--color-text-muted);
    font-size: var(--text-small);
    line-height: var(--text-small-leading);
    letter-spacing: var(--text-small-tracking);
  }
  .home-news__title {
    margin: var(--space-1) 0 0;
    font-size: var(--text-h3);
    line-height: var(--text-h3-leading);
  }
  .home-news__title a {
    display: inline-block;
    min-height: var(--target-min);
  }
  .home-news__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-2) 0 0;
  }
  .home-news__more {
    margin-block-start: var(--space-4);
  }
  @media (--tablet) {
    .home__news {
      margin-block-start: var(--space-8);
    }
  }

  @media (--pc) {
    .entries {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-6);
    }
    .entries__item {
      padding-block: var(--space-4) 0;
    }
  }
</style>
