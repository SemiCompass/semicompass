---
// トップページ（/。要件定義書 3.3、仕様書 9.1）：説明の一文（h1）→ サイトの説明 → 4つの入口 → 新着のニュース解説（最大5件）。
// 最初の画面（幅360px、高さ約640px）に、説明と4つの入口が収まる。入口は、記号と見出しを組にした同じ形のボタン（運用ルール書 10.3.3 の例外）
import { BUILD_DATE, BUILD_ENV } from 'astro:env/server';
import Icon from '../components/Icon.astro';
import ExternalLink from '../components/ExternalLink.astro';
import Phrase from '../components/Phrase.astro';
import StateMessage from '../components/StateMessage.astro';
import Tag from '../components/Tag.astro';
import Base from '../layouts/Base.astro';
import { dateLabel, loadCompanies } from '../lib/companies';
import { buildDate } from '../lib/buildDate';
import { loadLearnPages } from '../lib/content';
import { eventDates, upcomingEvents } from '../lib/events';
import { loadMenu } from '../lib/menu';
import { loadNews } from '../lib/news';

const { note } = loadMenu();
const preview = BUILD_ENV === 'preview';
// 近く開かれる技術系のイベント（要件定義書 3.3 の5、FR-206）：終わっていないものを、開催日の近い順に最大5件
const events = upcomingEvents(buildDate(BUILD_DATE));
const eventsCheckedOn = events.map((e) => String(e.checked_on)).sort().pop() ?? '';

// 新着のニュース解説（9.1 の4）：新しい順に最大5件。日付、見出し、関係する企業のタグ
const news = loadNews(preview).slice(0, 5);
const companies = loadCompanies();
const companyTags = (slugs: string[]) =>
  slugs.flatMap((slug) => {
    const c = companies.find((x) => x.slug === slug);
    return c ? [{ slug, name: c.short_names[0] ?? c.name }] : [];
  });

// 4つの入口（要件定義書 3.3 の3）：行き先、見出し、一文の説明、記号。企業名・証券コードの検索は、ヘッダーの検索欄を使う
const entries = [
  // 学習のページ（content/learn/）が1つもない間は、用語集へ（要件定義書 3.3）
  loadLearnPages(preview).length > 0
    ? { href: '/learn/', icon: 'book', title: '半導体を学ぶ', text: '基礎から図でわかる' }
    : { href: '/glossary/', icon: 'book', title: '半導体を学ぶ', text: '用語から基本を知る' },
  { href: '/processes/', icon: 'flow', title: '工程をたどる', text: 'チップができるまで' },
  { href: '/news/', icon: 'newspaper', title: 'ニュースを読む', text: 'どこに効くかまで' },
  { href: '/companies/', icon: 'building', title: '会社を知る', text: '工程と数字で比べる' },
] as const;

// 最初の画面の工程の流れの図（仕様書 9.1 の改訂案）。工程の一覧への入口を兼ねる
const flowSteps = [
  { label: '設計', x: 20, y: 10 },
  { label: 'ウェーハ', x: 180, y: 10 },
  { label: '前工程', x: 180, y: 82 },
  { label: '後工程', x: 20, y: 82 },
  { label: '検査', x: 20, y: 154 },
];
---

<Base title="SemiCompass（セミコンパス）｜日本の半導体業界を、企業・工程・ニュースでつなげて理解する" description="半導体ができるまでの工程と、そこに関わる日本の企業を、図と業績の数字でたどれる情報サイト。ニュースは、どの工程・どの企業に関わるかまで解説します。">
  <div class="container home">
    <div class="home__hero">
      <div class="home__intro">
        <h1 class="home__title"><Phrase text="日本の半導体業界を、企業・工程・ニュースでつなげて理解する" /></h1>
        <p class="lead measure home__lead">
          半導体ができる工程と、そこに関わる日本の企業を、図と業績の数字でひとつながりにたどれます。
        </p>
      </div>
      <a class="home__flow" href="/processes/" aria-label="工程の一覧へ：設計、ウェーハ、前工程、後工程、検査の流れ">
        <svg viewBox="0 0 320 200" role="img" aria-hidden="true" focusable="false">
          {flowSteps.map((step, i) => (
            <g transform={`translate(${step.x} ${step.y})`}>
              <rect class="home__flow-box" width="120" height="44" rx="6" />
              <circle class="home__flow-num" cx="22" cy="22" r="11" />
              <text class="home__flow-num-text" x="22" y="26.5" font-size="13" text-anchor="middle">{i + 1}</text>
              <text class="home__flow-label" x="42" y="27" font-size="15">{step.label}</text>
            </g>
          ))}
          <path class="home__flow-arrow" d="M140 32h36m-6-5 6 5-6 5M236 54v28m-5-6 5 6 5-6M176 104h-36m6-5-6 5 6 5M80 126v28m-5-6 5 6 5-6" />
        </svg>
        <span class="home__flow-caption">工程ごとに、関わる企業がわかる</span>
      </a>
    </div>

    <nav class="entries" aria-label="目的から探す">
      <ul class="entries__list">
        {entries.map((e) => (
          <li>
            <a class="entry" href={e.href}>
              <Icon name={e.icon} class="entry__icon" />
              <span class="entry__title">{e.title}</span>
              <span class="entry__text">{e.text}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="home__columns">
    <section aria-labelledby="latest-news" class="home__news">
      <h2 id="latest-news">新着のニュース解説</h2>
      {news.length === 0 ? (
        <StateMessage kind="empty" message="ニュース解説は、まだありません。" actionLabel="企業の一覧を見る" actionHref="/companies/" />
      ) : (
        <>
          <ol class="home-news">
            {news.map((n) => (
              <li class="home-news__item">
                <time class="home-news__date" datetime={n.front.published_at}>{dateLabel(n.front.published_at)}</time>
                <h3 class="home-news__title"><a href={n.url}><Phrase text={n.front.title} /></a></h3>
                {companyTags(n.front.tags.companies).length > 0 && (
                  <p class="home-news__tags">{companyTags(n.front.tags.companies).map((c) => <Tag href={`/companies/${c.slug}/`} kind="企業">{c.name}</Tag>)}</p>
                )}
              </li>
            ))}
          </ol>
          <p class="home-news__more"><a href="/news/">ニュース解説の一覧</a></p>
        </>
      )}
    </section>

    {events.length > 0 && (
      <section aria-labelledby="home-events-title" class="home__events">
        <h2 id="home-events-title">近く開かれる技術系のイベント</h2>
        <ol class="home-events">
          {events.map((e) => (
            <li class="home-events__item">
              <span class="home-events__date">{eventDates(e)}</span>
              <span class="home-events__name"><ExternalLink href={e.url}>{e.name}</ExternalLink></span>
              <span class="home-events__place">{e.venue}（{e.city}）・主催：{e.organizer}</span>
            </li>
          ))}
        </ol>
        <p class="home-events__source">出典：各主催者の公式ページ。{dateLabel(eventsCheckedOn)}確認</p>
      </section>
    )}
    </div>

    <p class="measure home__note">運営者は、noteでも発信しています。<ExternalLink href={note.url}>{note.label}</ExternalLink></p>
  </div>
</Base>

<style>
  @import "../styles/breakpoints.css";

  /* まとまりは余白で示す（仕様書 6.1）。スマートフォンは、最初の画面（360×640）に説明と4つの入口が収まる範囲に抑え、
     タブレット以上で、--space-7〜--space-8 を取る */
  .home {
    padding-block: var(--space-3) var(--space-6);
  }
  .home__title {
    margin-block-end: var(--space-2);
    font-size: var(--text-display);
    line-height: var(--text-display-leading);
  }
  /* 最初の画面：説明と、工程の流れの図。PCでは2列、それより狭い幅では図を入口の後ろに回さず、説明の下に小さく置く */
  .home__hero {
    display: grid;
    gap: var(--space-4);
  }
  .home__flow {
    display: none;
  }
  @media (--pc) {
    .home__hero {
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
      align-items: center;
      gap: var(--space-7);
      margin-block-end: var(--space-7);
    }
    .home__flow {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      padding: var(--space-4);
      border-radius: var(--radius-card);
      background: var(--color-surface-sunken);
      color: var(--color-text);
      text-decoration: none;
    }
    .home__flow:hover {
      background: var(--color-primary-tint);
    }
  }
  .home__flow svg {
    width: 100%;
    height: auto;
  }
  .home__flow-box {
    fill: var(--color-surface);
    stroke: var(--color-border-strong);
    stroke-width: var(--border-width);
  }
  .home__flow-num {
    fill: var(--color-highlight-tint);
    stroke: var(--color-highlight);
    stroke-width: var(--icon-stroke);
  }
  .home__flow-num-text {
    fill: var(--color-highlight-text);
    font-weight: var(--font-weight-bold);
  }
  .home__flow-label {
    fill: var(--color-text);
    font-weight: var(--font-weight-bold);
  }
  .home__flow-arrow {
    fill: none;
    stroke: var(--color-primary);
    stroke-width: 2;
  }
  .home__flow-caption {
    color: var(--color-primary);
    font-size: var(--text-small);
    font-weight: var(--font-weight-bold);
    align-self: center;
  }
  .home__lead {
    margin-block-end: var(--space-4);
  }
  @media (--tablet) {
    .home {
      padding-block: var(--space-7) var(--space-8);
    }
    .home__lead {
      margin-block-end: var(--space-7);
    }
  }
  /* 4つの入口：記号・見出し・一文の説明を縦に組んだボタン。スマートフォンは2列×2行、タブレット以上は4列（仕様書 9.1 の3） */
  .entries__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (--tablet) {
    .entries__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  @media (--tablet) {
    .entry {
      padding: var(--space-4);
    }
    .entry :global(.entry__icon) {
      margin-block-end: var(--space-2);
      padding: var(--space-2);
    }
  }
  .entries__list li {
    display: flex;
  }
  .entry {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    width: 100%;
    min-height: var(--target-min);
    padding: var(--space-3);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface-sunken);
    color: var(--color-text);
    text-decoration: none;
  }
  .entry:hover {
    border-color: var(--color-primary);
    background: var(--color-primary-tint);
  }
  /* 記号は琥珀の下地の丸に置く（暖色のアクセントを点で使う） */
  .entry :global(.entry__icon) {
    box-sizing: content-box;
    width: var(--icon-entry);
    height: var(--icon-entry);
    margin-block-end: var(--space-1);
    padding: var(--space-1);
    border-radius: 50%;
    background: var(--color-highlight-tint);
    color: var(--color-highlight-text);
  }
  .entry__title {
    color: var(--color-primary);
    font-size: var(--text-lead);
    font-weight: var(--font-weight-bold);
    line-height: var(--text-lead-leading);
    letter-spacing: var(--text-lead-tracking);
  }
  .entry__text {
    color: var(--color-text-muted);
    font-size: var(--text-small);
    line-height: var(--text-small-leading);
    letter-spacing: var(--text-small-tracking);
  }
  .home__news {
    margin-block-start: var(--space-7);
  }
  /* PCでは、新着のニュース解説を左、イベントを右の2列にする */
  @media (--pc) {
    .home__columns {
      display: grid;
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
      gap: var(--space-7);
      align-items: start;
    }
    .home__columns .home__events {
      padding: var(--space-5);
      border-radius: var(--radius-card);
      background: var(--color-surface-sunken);
    }
  }
  .home__note {
    margin-block-start: var(--space-6);
    color: var(--color-text-muted);
    font-size: var(--text-small);
    line-height: var(--text-small-leading);
    letter-spacing: var(--text-small-tracking);
  }
  .home__news h2 {
    margin-block-start: 0;
  }
  /* 新着のニュース解説：1件ずつ罫線で区切る（ニュースの一覧と同じ並べ方。仕様書 9.6） */
  .home__events {
    margin-block-start: var(--space-7);
  }
  .home__events h2 {
    margin-block-start: 0;
  }
  /* イベント：1件ずつ罫線で区切る（ニュースの一覧と同じ並べ方。仕様書 9.1 の5） */
  .home-events {
    max-width: var(--content-max-width);
    margin: var(--space-4) 0 0;
    padding: 0;
    border-top: var(--border-width) solid var(--color-border);
    list-style: none;
  }
  .home-events__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding-block: var(--space-3);
    border-bottom: var(--border-width) solid var(--color-border);
  }
  .home-events__date,
  .home-events__place,
  .home-events__source {
    color: var(--color-text-muted);
    font-size: var(--text-small);
    line-height: var(--text-small-leading);
  }
  .home-events__date {
    color: var(--color-highlight-text);
    font-weight: var(--font-weight-bold);
  }
  .home-events__date {
    font-variant-numeric: tabular-nums;
  }
  .home-events__name {
    font-size: var(--text-lead);
    font-weight: var(--font-weight-bold);
    line-height: var(--text-lead-leading);
  }
  .home-news {
    max-width: var(--content-max-width);
    margin: var(--space-4) 0 0;
    padding: 0;
    border-top: var(--border-width) solid var(--color-border);
    list-style: none;
  }
  .home-news__item {
    padding-block: var(--space-4);
    border-bottom: var(--border-width) solid var(--color-border);
  }
  .home-news__date {
    color: var(--color-text-muted);
    font-size: var(--text-small);
    line-height: var(--text-small-leading);
    letter-spacing: var(--text-small-tracking);
    font-variant-numeric: tabular-nums;
  }
  .home-news__title {
    margin: var(--space-1) 0 0;
    font-size: var(--text-h3);
    line-height: var(--text-h3-leading);
  }
  .home-news__title a {
    display: inline-block;
    min-height: var(--target-min);
    color: var(--color-text);
    text-decoration: none;
  }
  .home-news__title a:hover {
    color: var(--color-primary);
    text-decoration: underline;
  }
  .home-news__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-2) 0 0;
  }
  .home-news__more {
    margin-block-start: var(--space-4);
  }
  @media (--tablet) {
    .home__news,
    .home__events {
      margin-block-start: var(--space-8);
    }
  }
</style>
