---
// トップページ（/。要件定義書 3.3、仕様書 9.1）：濃紺の帯（大見出し、説明、大きな検索欄）→ 帯からはみ出す4つの入口 →
// 半導体ができるまで（工程の流れの図）→ 新着のニュース解説（最大5件）と、近く開かれるイベント・運営者のnote。
// 入口は、絵と見出しを組にした同じ形のカード（運用ルール書 10.3.3 の例外）。帯の地には回路の格子とウェーハの同心円の線（仕様書 7章）
import { BUILD_DATE, BUILD_ENV } from 'astro:env/server';
import EntryPicture from '../components/EntryPicture.astro';
import ExternalLink from '../components/ExternalLink.astro';
import Phrase from '../components/Phrase.astro';
import ProcessFlow from '../components/ProcessFlow.astro';
import SearchBox from '../components/SearchBox.astro';
import StateMessage from '../components/StateMessage.astro';
import Base from '../layouts/Base.astro';
import { organizationLd, websiteLd } from '../lib/seo';
import { dateLabel, loadCompanies } from '../lib/companies';
import { buildDate } from '../lib/buildDate';
import { loadLearnPages } from '../lib/content';
import { eventDates, upcomingEvents } from '../lib/events';
import { loadMenu } from '../lib/menu';
import { loadNews } from '../lib/news';
import { loadSupply } from '../lib/companies';

const { note } = loadMenu();
const preview = BUILD_ENV === 'preview';
// 近く開かれる技術系のイベント（要件定義書 3.3 の5、FR-206）：終わっていないものを、開催日の近い順に最大5件
const events = upcomingEvents(buildDate(BUILD_DATE));
const eventsCheckedOn = events.map((e) => String(e.checked_on)).sort().pop() ?? '';

// 新着のニュース解説（9.1 の5）：新しい順に最大5件。日付、見出し、関係する企業のタグ
const news = loadNews(preview).slice(0, 5);
const companies = loadCompanies();
const companyTags = (slugs: string[]) =>
  slugs.flatMap((slug) => {
    const c = companies.find((x) => x.slug === slug);
    return c ? [{ slug, name: c.short_names[0] ?? c.name }] : [];
  });

// 新着の印：ビルドの日から3日以内に公開したもの（日付で変わる計算は BUILD_DATE を使う。CLAUDE.md 9章）
const today = buildDate(BUILD_DATE);
const isNew = (d: string) => (Date.parse(today) - Date.parse(String(d))) / 86400000 <= 3;
const shortDate = (d: string) => `${Number(String(d).slice(5, 7))}月${Number(String(d).slice(8, 10))}日`;
// イベントの暦：開催の年がビルドの年と違うときは、年も示す
const calMonth = (d: string) => (String(d).slice(0, 4) === today.slice(0, 4) ? '' : `${String(d).slice(0, 4)}年`) + `${Number(String(d).slice(5, 7))}月`;
// ニュースの段階のタグ：工程のタグの段階、なければ関係する企業の分類から（最大2つ）。色はトップの全体図と同じ
const supply = loadSupply() as { processes: { slug: string; stage: string }[]; categories: { slug: string; name: string }[] };
const stageColor: Record<string, string> = { materials: 'materials', 'front-end': 'front', 'back-end': 'back', devices: 'devices' };
const stagesOf = (n: (typeof news)[number]) => {
  const fromProcesses = n.front.tags.processes.map((p) => supply.processes.find((x) => x.slug === p)?.stage).filter(Boolean) as string[];
  const fromCompanies = n.front.tags.companies.flatMap((slug) => companies.find((c) => c.slug === slug)?.categories ?? []);
  const slugs = [...new Set([...fromProcesses, ...(fromProcesses.length ? [] : fromCompanies)])].filter((s) => s in stageColor || s === 'design' || s === 'test');
  return slugs.slice(0, 2).map((slug) => ({ slug, name: supply.categories.find((c) => c.slug === slug)?.name ?? slug, color: stageColor[slug] ?? 'neutral' }));
};

// 4つの入口（要件定義書 3.3 の3、仕様書 9.1 の2）：行き先、絵、見出し、一文の説明
const entries = [
  // 学習のページ（content/learn/）が1つもない間は、用語集へ（要件定義書 3.3）
  loadLearnPages(preview).length > 0
    ? { href: '/learn/', pic: 'learn', title: '半導体を学ぶ', text: '中学理科から、基礎編9分野を順に' }
    : { href: '/glossary/', pic: 'learn', title: '半導体を学ぶ', text: '用語から基本を知る' },
  { href: '/processes/', pic: 'process', title: '工程を学ぶ', text: 'ウェーハからチップまでの流れ' },
  { href: '/news/', pic: 'news', title: 'ニュースを読む', text: 'どの工程・どの企業の話かを解説' },
  { href: '/companies/', pic: 'company', title: '企業を比べる', text: '売上高・利益率・給与を並べて' },
] as const;
// 入力の例（8.6）：企業名、証券コード、用語を1つずつ
const examples = ['東京エレクトロン', '8035', 'CMP'];

---

<Base jsonLd={[organizationLd(Astro.site as URL), websiteLd(Astro.site as URL)]} title="SemiCompass（セミコンパス）｜日本の半導体業界を、企業・工程・ニュースでつなげて理解する" description="半導体ができるまでの工程と、そこに関わる日本の企業を、図と業績の数字でたどれる情報サイト。ニュースは、どの工程・どの企業に関わるかまで解説します。">
  <div class="home-page">
    <section class="hero" aria-labelledby="home-title">
      <svg class="hero__bg" aria-hidden="true" focusable="false" preserveAspectRatio="xMaxYMid slice" viewBox="0 0 1280 520">
        <defs>
          <pattern id="hero-grid" width="32" height="32" patternUnits="userSpaceOnUse"><path class="hero__grid" d="M32 0H0V32" /></pattern>
        </defs>
        <rect width="1280" height="520" fill="url(#hero-grid)" />
        <g class="hero__rings">
          <circle cx="1120" cy="250" r="360" /><circle cx="1120" cy="250" r="300" /><circle cx="1120" cy="250" r="240" /><circle cx="1120" cy="250" r="180" />
        </g>
        <path class="hero__notch" d="M1120 -110v12" />
      </svg>
      <div class="container hero__inner">
        <h1 class="hero__title" id="home-title">
          <span class="hero__line">日本の半導体業界を、</span><span class="hero__line">企業・工程・ニュースで</span><span class="hero__line"><em class="hero__em">つなげて</em>理解する</span>
        </h1>
        <p class="hero__lead">半導体ができるまでの工程と、そこに関わる日本の企業を、図と業績の数字でたどれます。</p>
        <div class="hero__search">
          <p class="hero__label" id="home-search-label">企業・工程・用語を探す</p>
          <SearchBox id="home-search" size="large" />
          <p class="hero__examples"><span>例</span>{examples.map((q) => <a href={`/search/?q=${encodeURIComponent(q)}`}>{q}</a>)}</p>
        </div>
      </div>
    </section>

    <nav class="container entries" aria-label="目的から探す">
      <ul class="entries__list">
        {entries.map((e) => (
          <li>
            <a class="entry" href={e.href}>
              <span class="entry__pic"><EntryPicture name={e.pic} /></span>
              <span class="entry__title">{e.title}<span class="entry__arrow" aria-hidden="true">→</span></span>
              <span class="entry__text">{e.text}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="container home">
      <section class="home__sec" aria-labelledby="home-flow">
        <div class="home__section-head">
          <h2 id="home-flow">半導体ができるまで</h2>
          <span class="home__rule" aria-hidden="true"></span>
          <a class="home__more" href="/processes/">工程の一覧へ</a>
        </div>
        <p class="home__intro">工程の名前を選ぶと、解説と関わる企業へ進めます。右の数は、その工程に関わる掲載企業の数です。</p>
        <ProcessFlow />
      </section>

      <div class="home__columns">
        <section aria-labelledby="latest-news" class="home__news">
          <div class="home__section-head">
            <h2 id="latest-news">新着のニュース解説</h2>
            <span class="home__rule" aria-hidden="true"></span>
            {news.length > 0 && <a class="home__more" href="/news/">一覧を見る</a>}
          </div>
          {news.length === 0 ? (
            <StateMessage kind="empty" message="ニュース解説は、まだありません。" actionLabel="企業の一覧を見る" actionHref="/companies/" />
          ) : (
            <ol class="home-news">
              {news.map((n) => (
                <li class="home-news__item">
                  <time class="home-news__date" datetime={n.front.published_at}>{shortDate(n.front.published_at)}</time>
                  <div class="home-news__body">
                    <h3 class="home-news__title">
                      <a href={n.url}><Phrase text={n.front.title} /></a>
                      {isNew(n.front.published_at) && <span class="home-news__new">新着</span>}
                    </h3>
                    {(stagesOf(n).length > 0 || companyTags(n.front.tags.companies).length > 0) && (
                      <p class="home-news__tags">
                        {stagesOf(n).map((st) => <a class:list={['chip', `chip--${st.color}`]} href={`/companies/process/${st.slug}/`}><span class="chip__dot" aria-hidden="true"></span>{st.name}</a>)}
                        {companyTags(n.front.tags.companies).map((c) => <a class="chip" href={`/companies/${c.slug}/`}><span class="visually-hidden">企業：</span>{c.name}</a>)}
                      </p>
                    )}
                  </div>
                </li>
              ))}
            </ol>
          )}
        </section>

        <div class="home__side">
          {events.length > 0 && (
            <section aria-labelledby="home-events-title" class="home__events">
              <div class="home__section-head">
                <h2 id="home-events-title">近く開かれるイベント</h2>
                <span class="home__rule" aria-hidden="true"></span>
              </div>
              <ol class="home-events">
                {events.map((e) => (
                  <li class="home-events__item">
                    <span class="home-events__cal" aria-hidden="true">
                      <span class="home-events__month">{calMonth(e.start_date)}</span>
                      <span class="home-events__day">{Number(String(e.start_date).slice(8, 10))}</span>
                      {e.end_date && e.end_date !== e.start_date && <span class="home-events__end">〜{Number(String(e.end_date).slice(8, 10))}日</span>}
                    </span>
                    <span class="home-events__text">
                      <span class="visually-hidden">{eventDates(e)}</span>
                      <span class="home-events__name"><ExternalLink href={e.url}>{e.name}</ExternalLink></span>
                      <span class="home-events__place">{e.venue}・主催：{e.organizer}</span>
                    </span>
                  </li>
                ))}
              </ol>
              <p class="home-events__source">出典：各主催者の公式ページ。{dateLabel(eventsCheckedOn)}確認</p>
            </section>
          )}
          <p class="home__note"><span class="home__note-mark" aria-hidden="true">n</span><span>運営者は、noteでも発信しています。<br /><ExternalLink href={note.url}>{note.label}</ExternalLink></span></p>
        </div>
      </div>
    </div>
  </div>
</Base>

<style>
  @import "../styles/breakpoints.css";
  /* ---- 1 帯（仕様書 9.1 の1）：ヘッダーと続けた濃紺の帯。地に回路の格子とウェーハの同心円（7章） ---- */
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--color-brand);
    color: var(--color-on-brand);
  }
  .hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .hero__grid {
    fill: none;
    stroke: var(--color-brand-grid);
    stroke-width: var(--border-width);
  }
  .hero__rings {
    fill: none;
    stroke: var(--color-brand-ring);
    stroke-width: var(--border-width);
  }
  .hero__notch {
    stroke: var(--color-brand-accent);
    stroke-width: var(--border-width-focus);
  }
  .hero__inner {
    position: relative;
    padding-block: var(--space-6) calc(var(--space-6) + var(--hero-overlap-sp));
  }
  .hero__inner > * {
    max-width: var(--hero-max-width);
  }
  .hero__title {
    margin: 0;
    color: var(--color-on-brand);
    font-size: var(--text-display);
    line-height: var(--text-display-leading);
    letter-spacing: var(--text-h1-tracking);
  }
  .hero__line {
    display: inline-block;
  }
  .hero__em {
    color: var(--color-brand-accent);
    font-style: normal;
  }
  .hero__lead {
    max-width: var(--hero-lead-max-width);
    margin: var(--space-4) 0 0;
    color: var(--color-on-brand-lead);
    font-size: var(--text-dense);
    line-height: var(--text-lead-leading);
    letter-spacing: var(--text-lead-tracking);
  }
  .hero__search {
    max-width: var(--hero-lead-max-width);
    margin-block-start: var(--space-5);
  }
  .hero__label {
    margin: 0 0 var(--space-2);
    font-size: var(--text-small);
    font-weight: var(--font-weight-bold);
  }
  /* 帯の上では、キーボードで選んだときの枠を明るい緑にする（8.6） */
  .hero :global(:focus-visible) {
    outline-color: var(--color-brand-accent);
  }
  .hero__examples {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin: var(--space-3) 0 0;
    color: var(--color-on-brand-muted);
    font-size: var(--text-small);
  }
  .hero__examples a,
  .hero__examples a:visited {
    display: inline-flex;
    align-items: center;
    min-height: var(--tag-height);
    padding-inline: var(--space-3);
    border: var(--border-width) solid var(--color-brand-line);
    border-radius: var(--radius-pill);
    color: var(--color-on-brand);
    text-decoration: none;
  }
  .hero__examples a:hover {
    background: var(--color-brand-hover);
    color: var(--color-on-brand);
  }

  /* ---- 2 4つの入口：帯の下端からはみ出して重ねる ---- */
  .entries {
    position: relative;
    margin-block-start: calc(var(--hero-overlap-sp) * -1);
  }
  .entries__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .entries__list li {
    display: flex;
  }
  .entry,
  .entry:visited {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    width: 100%;
    padding: var(--space-4);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
    color: var(--color-text);
    text-decoration: none;
  }
  .entry:hover {
    border-color: var(--color-primary);
    color: var(--color-text);
  }
  .entry__pic {
    display: grid;
    place-items: center;
    width: var(--icon-entry-tile);
    height: var(--icon-entry-tile);
    margin-block-end: var(--space-2);
    border-radius: var(--radius-card);
    background: var(--color-surface-sunken);
  }
  .entry:hover .entry__pic {
    background: var(--color-primary-tint);
  }
  .entry__title {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-dense);
    font-weight: var(--font-weight-bold);
    line-height: var(--text-dense-leading);
    font-feature-settings: "palt";
  }
  .entry__arrow {
    color: var(--color-primary);
    font-weight: var(--font-weight-normal);
  }
  .entry__text {
    color: var(--color-text-muted);
    font-size: var(--text-small);
    line-height: var(--text-small-leading);
  }

  /* ---- 3〜7 本文 ---- */
  .home {
    padding-block: 0 var(--space-6);
  }
  .home__sec,
  .home__columns {
    margin-block-start: var(--space-7);
  }
  .home__section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 var(--space-4);
    margin-block-end: var(--space-4);
  }
  .home__section-head h2 {
    margin: 0;
    font-size: var(--text-h2);
    line-height: var(--text-h2-leading);
  }
  .home__rule {
    flex: 1 1 var(--space-6);
    align-self: center;
    border-top: var(--border-width) solid var(--color-border);
  }
  .home__more {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
    font-size: var(--text-small);
    font-weight: var(--font-weight-bold);
    white-space: nowrap;
  }
  .home__intro {
    max-width: var(--content-max-width);
    margin: calc(var(--space-2) * -1) 0 var(--space-5);
    color: var(--color-text-muted);
    font-size: var(--text-dense);
    line-height: var(--text-lead-leading);
  }
  .home__columns {
    display: grid;
    gap: var(--space-7);
  }
  /* 5 新着のニュース解説：上に濃い罫線、各件を罫線で区切る（カードにしない） */
  .home-news,
  .home-events {
    margin: 0;
    padding: 0;
    border-top: var(--border-width) solid var(--color-text);
    list-style: none;
  }
  .home-news__item,
  .home-events__item {
    display: grid;
    grid-template-columns: var(--date-col-width) minmax(0, 1fr);
    gap: var(--space-3);
    padding-block: var(--space-4);
    border-bottom: var(--border-width) solid var(--color-border);
  }
  .home-news__date {
    color: var(--color-text-muted);
    font-size: var(--text-small);
    line-height: var(--text-body-leading);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .home-news__title {
    margin: 0;
    font-size: var(--text-body);
    line-height: var(--text-lead-leading);
    font-feature-settings: "palt";
  }
  .home-news__title a,
  .home-news__title a:visited {
    color: var(--color-text);
    text-decoration: none;
  }
  .home-news__title a:hover {
    color: var(--color-primary);
    text-decoration: underline;
  }
  .home-news__new {
    display: inline-block;
    margin-inline-start: var(--space-2);
    padding-inline: var(--space-2);
    border-radius: var(--radius-control);
    background: var(--color-highlight-tint);
    color: var(--color-highlight-text);
    font-size: var(--text-caption);
    font-weight: var(--font-weight-bold);
    line-height: var(--text-small-leading);
    vertical-align: middle;
  }
  .home-news__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-2) 0 0;
  }
  /* 段階のタグと企業のタグ（8.11） */
  .chip,
  .chip:visited {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: var(--tag-height-sm);
    padding-inline: var(--space-3);
    border-radius: var(--radius-pill);
    background: var(--color-surface-sunken);
    color: var(--color-text);
    font-size: var(--text-caption);
    line-height: var(--text-caption-leading);
    text-decoration: none;
  }
  .chip:hover {
    text-decoration: underline;
  }
  .chip__dot {
    width: var(--space-2);
    height: var(--space-2);
    border-radius: var(--radius-pill);
    background: currentcolor;
  }
  .chip--materials,
  .chip--materials:visited {
    background: var(--color-stage-materials-tint);
    color: var(--color-stage-materials);
    font-weight: var(--font-weight-bold);
  }
  .chip--front,
  .chip--front:visited {
    background: var(--color-stage-front-tint);
    color: var(--color-stage-front);
    font-weight: var(--font-weight-bold);
  }
  .chip--back,
  .chip--back:visited {
    background: var(--color-stage-back-tint);
    color: var(--color-stage-back);
    font-weight: var(--font-weight-bold);
  }
  .chip--devices,
  .chip--devices:visited {
    background: var(--color-stage-devices-tint);
    color: var(--color-stage-devices);
    font-weight: var(--font-weight-bold);
  }
  /* 6 イベント：暦の形の日付（上の帯は濃紺の面に白い文字） */
  .home__side {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .home-events__cal {
    display: grid;
    align-content: start;
    overflow: hidden;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-cal);
    font-variant-numeric: tabular-nums;
  }
  .home-events__cal > span {
    display: flex;
    justify-content: center;
  }
  .home-events__month {
    background: var(--color-brand);
    color: var(--color-on-brand);
    font-size: var(--text-caption);
    font-weight: var(--font-weight-bold);
    line-height: var(--text-small-leading);
    white-space: nowrap;
  }
  .home-events__day {
    padding-block-start: var(--space-1);
    font-size: var(--text-h2);
    font-weight: var(--font-weight-bold);
    line-height: var(--leading-reset);
  }
  .home-events__end {
    padding-block: var(--space-1);
    color: var(--color-text-muted);
    font-size: var(--text-caption);
    line-height: var(--text-caption-leading);
  }
  .home-events__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .home-events__name {
    font-size: var(--text-dense);
    font-weight: var(--font-weight-bold);
    line-height: var(--text-dense-leading);
    font-feature-settings: "palt";
  }
  .home-events__name :global(a),
  .home-events__name :global(a:visited) {
    color: var(--color-text);
    text-decoration: none;
  }
  .home-events__name :global(a:hover) {
    color: var(--color-primary);
    text-decoration: underline;
  }
