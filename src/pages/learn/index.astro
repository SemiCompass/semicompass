---
// 半導体を学ぶ（/learn/。要求定義書 FR-901、要件定義書 FR-901）：分野ごとに、できている単元を並べる。
// ページはできたものから順に増やす。単元がまだない分野は「準備中」とし、完成しているように見せない（MV-08）
import { BUILD_ENV } from 'astro:env/server';
import Page from '../../layouts/Page.astro';
import UnitList from '../../components/LearnUnitList.astro';
import { learnIndex } from '../../lib/learn';

const index = learnIndex(BUILD_ENV === 'preview');
---

<Page
  title="半導体を学ぶ｜SemiCompass"
  heading="半導体を学ぶ"
  description="半導体工学の基礎から、材料、設計、製造、パワー半導体、センサー、通信、業界までを、研究分野ごとに順に学べます。"
  breadcrumbs={[{ label: 'ホーム', href: '/' }, { label: '半導体を学ぶ' }]}
  toc={index.map(({ field }) => ({ id: `field-${field.slug}`, label: field.title }))}
>
  <p class="lead measure">半導体工学の基礎から、結晶と材料、デバイスの設計、製造、パワー半導体、センサー、通信、業界までを、研究分野ごとに順に学べます。各ページの最後に、内容を確かめる問いがあります。ページは、順に増やしています。</p>
  {index.map(({ field, units, lead, sections }) => (
    <section aria-labelledby={`field-${field.slug}`} class="learn-field">
      <h2 id={`field-${field.slug}`}>{field.no}. {field.title}</h2>
      <p class="measure">{field.summary}</p>
      {units.length > 0 ? (
        <>
          {lead.length > 0 && <UnitList units={lead} />}
          {sections.filter((s) => s.units.length > 0).map(({ section, units: su }) => (
            <section aria-labelledby={`section-${field.slug}-${section.slug}`} class="learn-section">
              <h3 id={`section-${field.slug}-${section.slug}`}>{section.title}</h3>
              {section.summary && <p class="measure">{section.summary}</p>}
              <UnitList units={su} />
            </section>
          ))}
        </>
      ) : (
        <p class="learn-field__pending">この分野のページは、準備中です。</p>
      )}
    </section>
  ))}
</Page>

<style>
  .learn-field {
    margin-block-start: var(--space-7);
  }
  .learn-section {
    margin-block-start: var(--space-5);
  }
  .learn-field__pending {
    color: var(--color-text-muted);
  }
</style>
