---
// 半導体を学ぶ（/learn/。要求定義書 FR-901、要件定義書 FR-901、仕様書 8.18）：二段の入口を並べる。
// 基礎編（対象で分けた9分野）と、深掘り編「半導体の物理」（学問で分けたカード）。入口から分野のページ（/learn/{分野}/）へ進み、
// その分野の単元を体系の順に学ぶ。単元がまだない分野は「準備中」とする（MV-08）
import { BUILD_ENV } from 'astro:env/server';
import LearnTierFields from '../../components/LearnTierFields.astro';
import Page from '../../layouts/Page.astro';
import { learnTiers } from '../../lib/learn';

const tiers = learnTiers(BUILD_ENV === 'preview');
---

<Page
  title="半導体を学ぶ｜SemiCompass"
  heading="半導体を学ぶ"
  description="半導体工学の基礎から、材料、設計、製造、パワー半導体、センサー、通信、業界までを分野ごとに順に学べます。動作を支える物理も、式の読み方に絞って学べます。"
  breadcrumbs={[{ label: 'ホーム', href: '/' }, { label: '半導体を学ぶ' }]}
  wide
>
  <p class="lead measure">基礎編では、半導体の世界に何があり、どう作られ、どう使われるかを、分野ごとに順に学べます。半導体の物理では、なぜそう動くのかを、式の形から読めることに絞って学べます。分野を選ぶと、その分野のページが学ぶ順に並んでいます。各ページの最後に、内容を確かめる問いがあります。</p>
  <nav aria-label="分野を選ぶ">
    {tiers.map((entry) => <LearnTierFields entry={entry} />)}
  </nav>
</Page>
