---
// 学習のページ（/learn/{分野}/{slug}/。要求定義書 FR-901、FR-902、FR-904）：説明の一文 → 図 → 本文 → この技術に関わる企業
// → 関係する工程と用語 → さらに深く → 次に読む → 理解度チェック → 出典。前後のリンクは content/learn/path.yaml の並びから作る。
// 深掘り編「半導体の物理」のページは、本文（式／式のどこを見るか／数値例）の後に「基礎編のどこに効くか」を置き、本文の式を MathML で示す
import { BUILD_ENV } from 'astro:env/server';
import CompanyTable from '../../../components/CompanyTable.astro';
import Quiz from '../../../components/Quiz.astro';
import RichText from '../../../components/RichText.astro';
import SourceList from '../../../components/SourceList.astro';
import LearnDeeper from '../../../components/LearnDeeper.astro';
import LearnPathNav from '../../../components/LearnPathNav.astro';
import Page from '../../../layouts/Page.astro';
import Phrase from '../../../components/Phrase.astro';
import { companyRows, loadSupply } from '../../../lib/companies';
import { loadLearnPages, loadLearnPath, loadTerms, type LearnPage } from '../../../lib/content';
import { appliesToLinks, deeperLinks, fieldName, fieldOf, learnFigure, learnHref, learnIndex, neighbors } from '../../../lib/learn';
import { displayMath } from '../../../lib/math';

export function getStaticPaths() {
  return loadLearnPages(BUILD_ENV === 'preview').map((page) => ({ params: { field: page.field, slug: page.slug }, props: { page } }));
}
const { page } = Astro.props as { page: LearnPage };
const preview = BUILD_ENV === 'preview';
const f = page.front;
// 分野は、path.yaml でこのページを並べた分野（フォルダと違うことがある。公開済みのURLを変えずに組み替えたため）
const field = fieldOf(preview, learnHref(page)) ?? loadLearnPath().find((x) => x.slug === page.field);
// 深掘り編のページか（path.yaml の physics のカードに並べたページ）
const physics = field?.tier === 'physics';
const applies = physics ? appliesToLinks(preview, page) : [];
const deeper = physics ? [] : deeperLinks(preview, learnHref(page));
const supply = loadSupply() as ReturnType<typeof loadSupply> & { processes: { slug: string; name: string }[] };
const processes = (f.processes ?? []).map((slug) => supply.processes.find((p) => p.slug === slug)).filter((p) => p !== undefined);
const terms = loadTerms(preview).filter((t) => (f.related_terms ?? []).includes(t.slug));
const rows = companyRows(preview).filter((r) => (f.companies ?? []).includes(r.company.slug));
const { previous, next, isLast } = neighbors(preview, page);
const hasNav = Boolean(previous || next || isLast);
const Figure = learnFigure(page) as any;
const sources = (f.sources ?? []).map((s) => ({
  number: Number(s.id.slice(1)), title: s.title, publisher: s.publisher, url: s.url, publishedOn: s.published_on, accessedOn: s.accessed_on, pages: s.pages,
}));
const headed = page.sections.filter((s) => s.heading);
// 分野の中の位置（8.18。基礎編だけ）：「4 / 8ページ」と、ページの数だけの目盛り
const fieldEntry = !physics && field ? learnIndex(preview).find((e) => e.field.slug === field.slug) : undefined;
const position = fieldEntry ? fieldEntry.units.findIndex((u) => u.href === learnHref(page)) + 1 : 0;
const total = fieldEntry?.units.length ?? 0;
const SUMMARY_HEADING = 'このページのまとめ';
const label = (date: string) => {
  const [y, m, d] = date.split('-').map(Number);
  return `${y}年${m}月${d}日`;
};
const toc = [
  ...headed.map((s, i) => ({ id: `s${i}`, label: s.heading })),
  ...(applies.length > 0 ? [{ id: 'applies', label: '基礎編のどこに効くか' }] : []),
  ...(rows.length > 0 ? [{ id: 'companies', label: 'この技術に関わる企業' }] : []),
  ...(processes.length + terms.length > 0 ? [{ id: 'related', label: '関係する工程と用語' }] : []),
  ...(deeper.length > 0 ? [{ id: 'deeper', label: 'さらに深く' }] : []),
  ...(hasNav ? [{ id: 'next-read', label: '次に読む' }] : []),
  ...(page.quiz.length > 0 ? [{ id: 'quiz-title', label: '理解度チェック' }] : []),
  ...(sources.length > 0 ? [{ id: 'sources-heading', label: '出典' }] : []),
];
---

<Page
  title={`${f.title}｜半導体を学ぶ｜SemiCompass`}
  heading={f.title}
  description={f.description}
  breadcrumbs={[
    { label: 'ホーム', href: '/' },
    { label: '半導体を学ぶ', href: '/learn/' },
    ...(physics ? [{ label: '半導体の物理', href: '/learn/#tier-physics' }] : []),
    { label: field?.title ?? page.field, href: `/learn/${field?.slug ?? page.field}/` },
    { label: f.title },
  ]}
  toc={toc}
  publishedAt={f.published_at}
  updatedAt={f.updated_at}
  schemaType="Article"
  noindex={f.draft === true}
>
  <header class="lesson-head" slot="head">
    {position > 0 && field && (
      <p class="lesson-progress">
        <a href={`/learn/${field.slug}/`}>{fieldName(field)}</a>
        <span class="lesson-progress__bar" aria-hidden="true">
          {Array.from({ length: total }, (_, i) => <i class:list={{ 'is-done': i + 1 < position, 'is-current': i + 1 === position }}></i>)}
        </span>
        <span class="lesson-progress__n">{position} / {total}ページ</span>
      </p>
    )}
    <h1 class="lesson-head__title"><Phrase text={f.title} /></h1>
    <p class="lesson-head__dates">
      {f.published_at && <span>公開日：<time datetime={f.published_at}>{label(f.published_at)}</time></span>}
      {f.updated_at && <span>更新日：<time datetime={f.updated_at}>{label(f.updated_at)}</time></span>}
      <span>作成者：<a href="/about/">hysd（SemiCompass運営者）</a></span>
    </p>
  </header>
  <p class="lead measure">{f.description}</p>
  {Figure && <Figure />}
  {page.sections.map((section) => {
    const body = section.paragraphs.map((paragraph) => {
      const block = physics ? displayMath(paragraph) : null;
      return block ? <div class="math-display" set:html={block} /> : <p><RichText text={paragraph} math={physics} /></p>;
    });
    return (
      <>
        {section.heading && <h2 id={`s${headed.indexOf(section)}`}>{section.heading}</h2>}
        {section.heading === SUMMARY_HEADING ? <div class="lesson-summary">{body}</div> : body}
      </>
    );
  })}

  {applies.length > 0 && (
    <section aria-labelledby="applies">
      <h2 id="applies">基礎編のどこに効くか</h2>
      <ul>
        {applies.map((a) => <li><a href={a.link.href}>{a.link.title}</a>：{a.note}</li>)}
      </ul>
    </section>
  )}

  {rows.length > 0 && (
    <section aria-labelledby="companies">
      <h2 id="companies">この技術に関わる企業</h2>
      <CompanyTable rows={rows} caption={`${f.title}に関わる企業の一覧`} processes={supply.processes} filters={false} compact />
    </section>
  )}

  {processes.length + terms.length > 0 && (
    <section aria-labelledby="related">
      <h2 id="related">関係する工程と用語</h2>
      <ul>
        {processes.map((p) => <li>工程：<a href={`/processes/${p.slug}/`}>{p.name}</a></li>)}
        {terms.map((t) => <li>用語：<a href={`/glossary/${t.slug}/`}>{t.front.term}</a>：{t.front.short_definition}</li>)}
      </ul>
    </section>
  )}

  {deeper.length > 0 && <LearnDeeper links={deeper} />}

  {hasNav && <LearnPathNav id="next-read" heading="次に読む" previous={previous} next={next} isLast={isLast} />}

  <Quiz questions={page.quiz} pageType="learn" />
  {sources.length > 0 && <SourceList sources={sources} heading="出典" />}
</Page>

<style>
  .math-display {
    max-width: var(--content-max-width);
    margin-block: var(--space-4);
    padding-inline-start: var(--space-4);
    overflow-x: auto;
  }
  /* 学習のページの頭（8.18）：分野の中の位置、大見出し、日付と作成者 */
  .lesson-head {
    margin-block-end: var(--space-5);
  }
  .lesson-progress {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    margin: 0 0 var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-small);
    line-height: var(--text-small-leading);
  }
  .lesson-progress a {
    font-weight: var(--font-weight-bold);
  }
  .lesson-progress__bar {
    display: inline-flex;
    gap: var(--meter-gap);
  }
  .lesson-progress__bar i {
    width: var(--progress-cell-width);
    height: var(--progress-cell-height);
    border-radius: var(--meter-gap);
    background: var(--color-border);
  }
  .lesson-progress__bar i.is-done {
    background: var(--color-accent);
  }
  .lesson-progress__bar i.is-current {
    background: var(--color-primary);
  }
  .lesson-progress__n {
    font-variant-numeric: tabular-nums;
  }
  .lesson-head__title {
    margin: 0;
  }
  .lesson-head__dates {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    margin: var(--space-3) 0 0;
    color: var(--color-text-muted);
    font-size: var(--text-small);
    line-height: var(--text-small-leading);
  }
  /* このページのまとめ（8.18） */
  .lesson-summary {
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-card);
    background: var(--color-surface-sunken);
  }
  .lesson-summary :global(p:last-child) {
    margin-block-end: 0;
  }
</style>
