---
// 図：ワイヤボンディング（模式図）。用語 wire-bonding の本文に合わせる
import FigureFrame from '../../components/FigureFrame.astro';
---

<FigureFrame id="fig-term-wire-bonding" columns={2} title="ワイヤボンディング（模式図）" caption="図：チップの電極パッドと、基板やリードフレームの端子を、細い金属線で一本ずつつなぐ。金属線の端は、熱、圧力、超音波などを加えて接合する。接続の後、樹脂で覆って封止する。寸法は簡単にした模式図、本サイトで作成">
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 140" role="img" aria-label="接続：チップの上の電極パッドと、外側の端子を、弧を描く細い金属線で結ぶ">
      <path class="fig-metal" d="M14 100h44v8H14zM142 100h44v8h-44zM66 100h68v8H66z" />
      <rect class="fig-wafer" x="72" y="80" width="56" height="20" />
      <rect class="fig-strong" x="76" y="76" width="8" height="4" />
      <rect class="fig-strong" x="116" y="76" width="8" height="4" />
      <path class="fig-line" d="M80 76c-4-30-30-34-40 24M120 76c4-30 30-34 40 24" />
    </svg>
    <span class="fig__name">細い金属線でつなぐ</span>
    <span class="fig__note">電極パッドと端子を一本ずつつなぐ。端子が多いほど時間がかかる</span>
  </li>
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 140" role="img" aria-label="封止：接続の後、チップと金属線を樹脂で覆う">
      <path class="fig-metal" d="M14 100h44v8H14zM142 100h44v8h-44z" />
      <rect class="fig-part" x="34" y="50" width="132" height="62" />
      <rect class="fig-wafer" x="72" y="80" width="56" height="20" />
    </svg>
    <span class="fig__name">樹脂で封止する</span>
    <span class="fig__note">接続の後、チップと金属線をモールド樹脂で覆う</span>
  </li>
  <ul class="fig__legend" slot="legend" aria-hidden="true">
    <li><svg class="fig__key" viewBox="0 0 24 24"><rect class="fig-wafer" x="3" y="8" width="18" height="8" /></svg>チップ</li>
    <li><svg class="fig__key" viewBox="0 0 24 24"><rect class="fig-strong" x="3" y="8" width="18" height="8" /></svg>電極パッド</li>
    <li><svg class="fig__key" viewBox="0 0 24 24"><rect class="fig-metal" x="3" y="8" width="18" height="8" /></svg>端子（リードフレーム）</li>
    <li><svg class="fig__key" viewBox="0 0 24 24"><path class="fig-line" d="M3 16c4-10 14-10 18 0" /></svg>金属線</li>
  </ul>
</FigureFrame>
