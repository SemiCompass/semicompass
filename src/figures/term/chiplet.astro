---
// 図：チップレットの考え方（模式図）。用語 chiplet の本文に合わせる
import FigureFrame from '../../components/FigureFrame.astro';
---

<FigureFrame id="fig-term-chiplet" columns={2} title="チップレットの考え方（模式図）" caption="図：大きな回路を一つのチップにまとめる代わりに、機能ごとに小さなチップに分けて作り、一つのパッケージの中で並べて接続する。チップごとに適した製造技術を選べる。寸法は簡単にした模式図、本サイトで作成">
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 140" role="img" aria-label="一つの大きなチップ：すべての機能を一つのチップにまとめて作る">
      <rect class="fig-film" x="20" y="100" width="160" height="16" />
      <rect class="fig-wafer" x="44" y="36" width="112" height="64" />
      <path class="fig-dash" d="M100 36v64M44 68h112" />
    </svg>
    <span class="fig__name">一つの大きなチップ</span>
    <span class="fig__note">すべての機能を、一つのチップに作り込む</span>
  </li>
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 140" role="img" aria-label="チップレット：機能ごとの小さなチップを、パッケージの基板の上に並べて接続する">
      <rect class="fig-film" x="20" y="100" width="160" height="16" />
      <rect class="fig-wafer" x="32" y="56" width="40" height="44" />
      <rect class="fig-part" x="80" y="56" width="40" height="44" />
      <rect class="fig-wafer" x="128" y="56" width="40" height="44" />
      <path class="fig-metal" d="M72 92h8v4h-8zM120 92h8v4h-8z" />
    </svg>
    <span class="fig__name">チップレット</span>
    <span class="fig__note">機能ごとの小さなチップを並べ、パッケージの中でつなぐ</span>
  </li>
  <ul class="fig__legend" slot="legend" aria-hidden="true">
    <li><svg class="fig__key" viewBox="0 0 24 24"><rect class="fig-wafer" x="3" y="8" width="18" height="8" /></svg>チップ（機能ごと）</li>
    <li><svg class="fig__key" viewBox="0 0 24 24"><rect class="fig-part" x="3" y="8" width="18" height="8" /></svg>別の製造技術で作るチップ</li>
    <li><svg class="fig__key" viewBox="0 0 24 24"><rect class="fig-metal" x="3" y="8" width="18" height="8" /></svg>チップ間の接続</li>
    <li><svg class="fig__key" viewBox="0 0 24 24"><rect class="fig-film" x="3" y="8" width="18" height="8" /></svg>パッケージの基板</li>
  </ul>
</FigureFrame>
