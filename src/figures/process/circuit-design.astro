---
// 図：回路設計の流れ（模式図）。工程ページ circuit-design の本文に合わせる
import FigureFrame from '../../components/FigureFrame.astro';
---

<FigureFrame id="fig-circuit-design" title="回路設計の流れ（模式図）" caption="図：回路の動作をハードウェア記述言語で書き、論理合成で論理ゲートの接続情報に変え、配置配線でチップの図面（レイアウト）を作る。各段階で検証し、問題があれば前の段階に戻る。寸法は簡単にした模式図、本サイトで作成">
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 140" role="img" aria-label="論理設計：回路の動作を、ハードウェア記述言語の文で書く">
      <rect class="fig-part" x="40" y="24" width="120" height="92" />
      <path class="fig-line" d="M56 44h72M56 60h56M68 76h64M68 92h40" />
    </svg>
    <span class="fig__name">動作を書く</span>
    <span class="fig__note">回路の動作を、ハードウェア記述言語で書く</span>
  </li>
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 140" role="img" aria-label="論理合成：書いた記述を、論理ゲートどうしの接続に変える">
      <rect class="fig-film" x="40" y="34" width="36" height="24" />
      <rect class="fig-film" x="40" y="82" width="36" height="24" />
      <rect class="fig-film" x="124" y="58" width="36" height="24" />
      <path class="fig-line" d="M76 46h24v20h24M76 94h24V74h24M160 70h24M16 46h24M16 94h24" />
    </svg>
    <span class="fig__name">ゲートの接続に変える</span>
    <span class="fig__note">論理合成で、論理ゲートの接続情報にする</span>
  </li>
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 140" role="img" aria-label="配置配線：素子と配線の位置を決めて、チップの図面であるレイアウトを作る">
      <rect class="fig-wafer" x="40" y="20" width="120" height="100" />
      <rect class="fig-film" x="52" y="32" width="32" height="24" />
      <rect class="fig-film" x="116" y="32" width="32" height="24" />
      <rect class="fig-film" x="84" y="84" width="32" height="24" />
      <path class="fig-metal" d="M84 42h32v4H84zM66 56h4v40h18v4H66zM132 56h4v44h-20v-4h16z" />
    </svg>
    <span class="fig__name">図面にする</span>
    <span class="fig__note">配置配線でレイアウトを作り、フォトマスクのデータとして渡す</span>
  </li>
  <ul class="fig__legend" slot="legend" aria-hidden="true">
    <li><svg class="fig__key" viewBox="0 0 24 24"><rect class="fig-film" x="3" y="8" width="18" height="8" /></svg>論理ゲート・素子</li>
    <li><svg class="fig__key" viewBox="0 0 24 24"><rect class="fig-metal" x="3" y="8" width="18" height="8" /></svg>配線</li>
  </ul>
</FigureFrame>
