---
// 図：パッケージングの流れ（模式図）。工程ページ packaging の本文に合わせる
import FigureFrame from '../../components/FigureFrame.astro';
---

<FigureFrame id="fig-packaging" title="パッケージングの流れ（模式図）" caption="図：切り分けたチップをリードフレームや配線基板に載せて固定し、チップの電極と外部端子を細い金属線で結ぶ（ワイヤボンディング）。その後、全体を樹脂で覆って固める。寸法は簡単にした模式図、本サイトで作成">
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 140" role="img" aria-label="チップを載せる：切り分けたチップを、リードフレームの上に載せて固定する">
      <path class="fig-metal" d="M20 96h40v8H20zM140 96h40v8h-40zM72 96h56v8H72z" />
      <rect class="fig-wafer" x="80" y="80" width="40" height="16" />
      <path class="fig-arrow" d="M100 40v32m-5-6 5 6 5-6" />
    </svg>
    <span class="fig__name">チップを載せる</span>
    <span class="fig__note">リードフレームや配線基板の上に、チップを固定する</span>
  </li>
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 140" role="img" aria-label="ワイヤボンディング：チップの電極と外部端子を、細い金属線で結ぶ">
      <path class="fig-metal" d="M20 96h40v8H20zM140 96h40v8h-40zM72 96h56v8H72z" />
      <rect class="fig-wafer" x="80" y="80" width="40" height="16" />
      <path class="fig-line" d="M84 80c-6-24-24-24-30 16M116 80c6-24 24-24 30 16" />
    </svg>
    <span class="fig__name">金属線でつなぐ</span>
    <span class="fig__note">チップの電極と外部端子を、細い金属線で結ぶ</span>
  </li>
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 140" role="img" aria-label="封止：チップと金属線を、樹脂で覆って固める。外に端子が出る">
      <path class="fig-metal" d="M20 96h40v8H20zM140 96h40v8h-40z" />
      <rect class="fig-part" x="50" y="56" width="100" height="56" />
      <rect class="fig-wafer" x="80" y="80" width="40" height="16" />
    </svg>
    <span class="fig__name">樹脂で覆う</span>
    <span class="fig__note">湿気やほこり、衝撃から守るため、樹脂で封止する</span>
  </li>
  <ul class="fig__legend" slot="legend" aria-hidden="true">
    <li><svg class="fig__key" viewBox="0 0 24 24"><rect class="fig-wafer" x="3" y="8" width="18" height="8" /></svg>チップ</li>
    <li><svg class="fig__key" viewBox="0 0 24 24"><rect class="fig-metal" x="3" y="8" width="18" height="8" /></svg>リードフレーム・端子</li>
    <li><svg class="fig__key" viewBox="0 0 24 24"><rect class="fig-part" x="3" y="8" width="18" height="8" /></svg>樹脂</li>
  </ul>
</FigureFrame>
