---
// 図：エッチングの前後の断面（模式図）。ドライは垂直に削れ、ウェットは横にも進む（工程ページ etching の本文に合わせる）
import FigureFrame from '../../components/FigureFrame.astro';
const resist = [[20, 60], [90, 110], [140, 180]];
---

<FigureFrame id="fig-etching" title="エッチングの前と後（断面の模式図）" caption="図：レジストに覆われていない部分の膜が削られる。ドライエッチングはイオンを引き込んで垂直に近い形に削り、ウェットエッチングは薬液で横方向にも削りが進む。寸法は簡単にした模式図、本サイトで作成">
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 140" role="img" aria-label="エッチングの前：ウェーハの上に膜があり、その上にレジストのパターンが残っている">
      <rect class="fig-wafer" x="10" y="100" width="180" height="30" />
      <rect class="fig-film" x="10" y="80" width="180" height="20" />
      {resist.map(([a, b]) => <rect class="fig-resist" x={a} y="66" width={b - a} height="14" />)}
    </svg>
    <span class="fig__name">エッチングの前</span>
    <span class="fig__note">膜の上に、露光と現像で作ったレジストのパターンがある</span>
  </li>
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 140" role="img" aria-label="ドライエッチングの後：覆われていない膜が垂直に削られている">
      <rect class="fig-wafer" x="10" y="100" width="180" height="30" />
      {resist.map(([a, b]) => <rect class="fig-film" x={a} y="80" width={b - a} height="20" />)}
      {resist.map(([a, b]) => <rect class="fig-resist" x={a} y="66" width={b - a} height="14" />)}
      <path class="fig-arrow" d="M75 22v36m-5-7 5 7 5-7M125 22v36m-5-7 5 7 5-7" />
      <rect class="fig-plasma" x="14" y="8" width="172" height="14" />
    </svg>
    <span class="fig__name">ドライエッチング</span>
    <span class="fig__note">プラズマのイオンを引き込み、垂直に近い形に削る</span>
  </li>
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 140" role="img" aria-label="ウェットエッチングの後：膜がレジストの下まで横方向に削られている">
      <rect class="fig-wafer" x="10" y="100" width="180" height="30" />
      {resist.map(([a, b]) => (
        <path class="fig-film" d={`M${a + 7} 80 Q${a + 1} 90 ${a - 1} 100 H${b + 1} Q${b - 1} 90 ${b - 7} 80 Z`} />
      ))}
      {resist.map(([a, b]) => <rect class="fig-resist" x={a} y="66" width={b - a} height="14" />)}
    </svg>
    <span class="fig__name">ウェットエッチング</span>
    <span class="fig__note">薬液に浸して溶かす。削りが横方向にも進む</span>
  </li>
  <ul class="fig__legend" slot="legend" aria-hidden="true">
    <li><svg class="fig__key" viewBox="0 0 24 24"><rect class="fig-resist" x="3" y="6" width="18" height="12" /></svg>レジスト</li>
    <li><svg class="fig__key" viewBox="0 0 24 24"><rect class="fig-film" x="3" y="6" width="18" height="12" /></svg>削る膜</li>
    <li><svg class="fig__key" viewBox="0 0 24 24"><rect class="fig-wafer" x="3" y="6" width="18" height="12" /></svg>ウェーハ</li>
    <li><svg class="fig__key" viewBox="0 0 24 24"><path class="fig-arrow" d="M12 3v16m-5-5 5 5 5-5" /></svg>イオンの向き</li>
  </ul>
</FigureFrame>
