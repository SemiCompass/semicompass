---
// 図：CMPの装置と、研磨の前後の断面（模式図）。工程ページ cmp の本文に合わせる
import FigureFrame from '../../components/FigureFrame.astro';
---

<FigureFrame id="fig-cmp" title="CMP（平坦化）の仕組み（模式図）" caption="図：回転する定盤の研磨パッドにウェーハの表面を押し当て、スラリーを流しながら研磨する。表面の出っ張りから先に削られ、平らになる。寸法は簡単にした模式図、本サイトで作成">
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 140" role="img" aria-label="CMPの装置：研磨ヘッドがウェーハを下向きに押し当て、回転する定盤の研磨パッドの上にスラリーを流す">
      <rect class="fig-part" x="20" y="96" width="160" height="16" />
      <rect class="fig-film" x="20" y="88" width="160" height="8" />
      <path class="fig-line" d="M100 112v20" />
      <rect class="fig-part" x="96" y="44" width="56" height="20" />
      <rect class="fig-wafer" x="100" y="64" width="48" height="8" />
      <path class="fig-line" d="M124 22v22" />
      <path class="fig-arrow" d="M124 26v16m-5-6 5 6 5-6" />
      <path class="fig-line" d="M40 30h24v14" />
      <circle class="fig-dot-alt" cx="64" cy="56" r="3" />
      <circle class="fig-dot-alt" cx="62" cy="70" r="3" />
      <circle class="fig-dot-alt" cx="66" cy="82" r="3" />
      <path class="fig-arrow" d="M40 124c20 8 100 8 120 0" />
    </svg>
    <span class="fig__name">装置</span>
    <span class="fig__note">研磨ヘッドでウェーハを押し当て、回転する定盤の上でスラリーを流す</span>
  </li>
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 140" role="img" aria-label="研磨の前：溝に埋めた金属の上に余分な金属があり、表面に凹凸がある">
      <rect class="fig-wafer" x="10" y="104" width="180" height="28" />
      <path class="fig-film" d="M10 104V70h40v20h30V70h40v20h30V70h30v34z" />
      <path class="fig-metal" d="M10 70V56h40l4 6h22l4-6h40l4 6h22l4-6h30v14h-30v20h-30V70h-40v20H50V70z" />
    </svg>
    <span class="fig__name">研磨の前</span>
    <span class="fig__note">溝に金属を埋めると、溝の外にも余分な金属が付き、凹凸が残る</span>
  </li>
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 140" role="img" aria-label="研磨の後：余分な金属が除かれ、溝の中の金属だけが配線として残り、表面が平らになる">
      <rect class="fig-wafer" x="10" y="104" width="180" height="28" />
      <path class="fig-film" d="M10 104V70h40v20h30V70h40v20h30V70h30v34z" />
      <path class="fig-metal" d="M50 70h30v20H50zM120 70h30v20h-30z" />
      <path class="fig-dash" d="M10 66h180" />
    </svg>
    <span class="fig__name">研磨の後</span>
    <span class="fig__note">余分な金属が除かれて表面が平らになり、溝の中の金属が配線になる</span>
  </li>
  <ul class="fig__legend" slot="legend" aria-hidden="true">
    <li><svg class="fig__key" viewBox="0 0 24 24"><rect class="fig-film" x="3" y="8" width="18" height="8" /></svg>研磨パッド・絶縁膜</li>
    <li><svg class="fig__key" viewBox="0 0 24 24"><rect class="fig-metal" x="3" y="8" width="18" height="8" /></svg>金属</li>
    <li><svg class="fig__key" viewBox="0 0 24 24"><circle class="fig-dot-alt" cx="12" cy="12" r="4" /></svg>スラリー</li>
    <li><svg class="fig__key" viewBox="0 0 24 24"><path class="fig-arrow" d="M12 3v16m-5-5 5 5 5-5" /></svg>押し当てる力・回転</li>
  </ul>
</FigureFrame>
