---
// 図2：半導体の材料と、その上流の原料（テーマ「材料の地政学」のバリューチェーン）。模式図、本サイトで作成。
// 原料は、経済産業省が経済安全保障推進法の支援の対象に挙げたもの
import FigureFrame from '../../components/FigureFrame.astro';
---

<FigureFrame id="fig-theme-mat-chain" columns={2} title="図2 半導体の材料と、その上流の原料（模式図）" caption="図：工程ごとに使う主な材料と、その上流の原料の例。原料の例は、経済産業省が経済安全保障推進法で供給の確保を支援する対象に挙げたもの。模式図、本サイトで作成">
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 140" role="img" aria-label="ウェーハ：シリコンの単結晶を薄く切り、表面を鏡のように磨く">
      <ellipse class="fig-wafer" cx="100" cy="76" rx="70" ry="22" />
      <ellipse class="fig-film" cx="100" cy="70" rx="70" ry="22" />
    </svg>
    <span class="fig__name">1. ウェーハ</span>
    <span class="fig__note">シリコンの単結晶を薄く切り、表面を磨く</span>
  </li>
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 140" role="img" aria-label="露光：マスクの形を、フォトレジストに写す">
      <rect class="fig-part" x="50" y="24" width="100" height="10" />
      <path class="fig-dash" d="M70 34v40M100 34v40M130 34v40" />
      <rect class="fig-film" x="30" y="80" width="140" height="10" />
      <rect class="fig-wafer" x="30" y="90" width="140" height="20" />
    </svg>
    <span class="fig__name">2. 露光の材料</span>
    <span class="fig__note">マスクブランクスとフォトレジスト</span>
  </li>
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 140" role="img" aria-label="エッチングと洗浄：ガスや薬品で、不要な部分を削り、表面を洗う">
      <rect class="fig-wafer" x="30" y="90" width="140" height="20" />
      <rect class="fig-film" x="30" y="78" width="30" height="12" />
      <rect class="fig-film" x="85" y="78" width="30" height="12" />
      <rect class="fig-film" x="140" y="78" width="30" height="12" />
      <path class="fig-dash" d="M72 30v40M128 30v40" />
    </svg>
    <span class="fig__name">3. エッチングと洗浄</span>
    <span class="fig__note">特殊ガスと、高純度のフッ化水素などの薬品</span>
  </li>
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 140" role="img" aria-label="上流の原料：ヘリウム、ネオン、クリプトン、キセノン、蛍石、黄リンなど">
      <circle class="fig-part" cx="60" cy="60" r="16" />
      <circle class="fig-part" cx="100" cy="50" r="12" />
      <circle class="fig-part" cx="140" cy="62" r="18" />
      <rect class="fig-wafer" x="30" y="96" width="140" height="14" />
    </svg>
    <span class="fig__name">上流の原料</span>
    <span class="fig__note">ヘリウム、ネオン、クリプトン、キセノン、蛍石、黄リンなど</span>
  </li>
  <ul class="fig__legend" slot="legend" aria-hidden="true">
    <li><svg class="fig__key" viewBox="0 0 24 24"><rect class="fig-wafer" x="3" y="8" width="18" height="8" /></svg>ウェーハ</li>
    <li><svg class="fig__key" viewBox="0 0 24 24"><rect class="fig-film" x="3" y="8" width="18" height="8" /></svg>膜・レジスト</li>
    <li><svg class="fig__key" viewBox="0 0 24 24"><rect class="fig-part" x="3" y="8" width="18" height="8" /></svg>マスク・原料</li>
  </ul>
</FigureFrame>
