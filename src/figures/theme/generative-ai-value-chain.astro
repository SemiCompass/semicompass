---
// 図2：生成AI向けの半導体ができるまで（テーマ「生成AIと半導体」のバリューチェーン）。模式図、本サイトで作成
import FigureFrame from '../../components/FigureFrame.astro';
---

<FigureFrame id="fig-theme-gai-chain" columns={2} title="図2 生成AI向けの半導体ができるまで（模式図）" caption="図：演算チップとHBMを別々に作り、インターポーザの上に並べて1つのパッケージにまとめ、基板に載せて試験する。寸法は簡単にした模式図、本サイトで作成">
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 140" role="img" aria-label="演算チップ：最先端の微細化の工程で、ウェーハの上に作る">
      <rect class="fig-film" x="30" y="96" width="140" height="16" />
      <rect class="fig-part" x="60" y="56" width="80" height="40" />
      <path class="fig-dash" d="M80 56v40M100 56v40M120 56v40" />
    </svg>
    <span class="fig__name">1. 演算チップを作る</span>
    <span class="fig__note">GPUなど。最先端の微細化の工程で作る</span>
  </li>
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 140" role="img" aria-label="HBM：薄く削ったDRAMのチップを何枚も積み重ねる">
      <rect class="fig-film" x="64" y="100" width="72" height="12" />
      <rect class="fig-wafer" x="64" y="86" width="72" height="12" />
      <rect class="fig-wafer" x="64" y="72" width="72" height="12" />
      <rect class="fig-wafer" x="64" y="58" width="72" height="12" />
      <rect class="fig-wafer" x="64" y="44" width="72" height="12" />
    </svg>
    <span class="fig__name">2. HBMを作る</span>
    <span class="fig__note">薄く削ったDRAMのチップを積み重ね、樹脂で固める</span>
  </li>
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 140" role="img" aria-label="先端パッケージ：インターポーザの上に、演算チップとHBMを並べてつなぐ">
      <rect class="fig-film" x="20" y="92" width="160" height="12" />
      <rect class="fig-part" x="74" y="56" width="52" height="36" />
      <rect class="fig-wafer" x="30" y="60" width="36" height="32" />
      <rect class="fig-wafer" x="134" y="60" width="36" height="32" />
      <path class="fig-metal" d="M66 88h8v4h-8zM126 88h8v4h-8z" />
    </svg>
    <span class="fig__name">3. 1つにまとめる</span>
    <span class="fig__note">インターポーザの上に、演算チップとHBMを並べてつなぐ</span>
  </li>
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 140" role="img" aria-label="基板と試験：パッケージ基板に載せ、試験装置で動作を確かめる">
      <rect class="fig-film" x="20" y="100" width="160" height="14" />
      <rect class="fig-film" x="40" y="84" width="120" height="16" />
      <rect class="fig-part" x="74" y="60" width="52" height="24" />
      <path class="fig-dash" d="M100 20v36" />
    </svg>
    <span class="fig__name">4. 基板に載せて試験する</span>
    <span class="fig__note">パッケージ基板に載せ、試験装置で動作を確かめる</span>
  </li>
  <ul class="fig__legend" slot="legend" aria-hidden="true">
    <li><svg class="fig__key" viewBox="0 0 24 24"><rect class="fig-part" x="3" y="8" width="18" height="8" /></svg>演算チップ</li>
    <li><svg class="fig__key" viewBox="0 0 24 24"><rect class="fig-wafer" x="3" y="8" width="18" height="8" /></svg>メモリ（DRAM）</li>
    <li><svg class="fig__key" viewBox="0 0 24 24"><rect class="fig-film" x="3" y="8" width="18" height="8" /></svg>ウェーハ・インターポーザ・基板</li>
  </ul>
</FigureFrame>
