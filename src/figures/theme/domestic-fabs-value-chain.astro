import FigureFrame from '../../components/FigureFrame.astro';
---

<FigureFrame id="fig-theme-fabs-chain" columns={2} title="図2 国の支援を受けた主な工場と、作る半導体（模式図）" caption="図：国の支援を受けた主な工場の場所と、作る半導体の種類。工場ごとに、ロジック、メモリ、最先端のロジックと役割が分かれる。模式図、本サイトで作成">
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 140" role="img" aria-label="熊本県：JASMがロジック半導体を作る">
      <rect class="fig-wafer" x="40" y="60" width="120" height="50" />
      <rect class="fig-part" x="60" y="36" width="80" height="24" />
    </svg>
    <span class="fig__name">熊本県（JASM）</span>
    <span class="fig__note">ロジック半導体。第1工場は2024年12月に量産</span>
  </li>
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 140" role="img" aria-label="三重県・岩手県：キオクシアが3次元フラッシュメモリを作る">
      <rect class="fig-film" x="60" y="94" width="80" height="12" />
