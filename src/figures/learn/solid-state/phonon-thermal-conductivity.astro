---
// 図：熱伝導率の温度変化の模式図と、シリコンの300 Kと400 Kでの見積もり（仕様書 7章、8.18）
import FigureFrame from '../../../components/FigureFrame.astro';
// シリコンの熱伝導率 1.5 W/(cm·K)（CERN）。400 K は温度に反比例する近似（0.75倍）で見積もる（本サイトで計算）
const items = [
  { name: '300 K', k: 1.5 },
  { name: '400 K（見積もり）', k: 1.5 * 0.75 },
];
const bx = (k: number) => 80 + (k / 2) * 100;
---

<FigureFrame id="fig-phonon-thermal-conductivity" columns={2} title="熱伝導率は、低温で増え、高温で下がる" caption="図：左は、結晶の熱伝導率の温度変化の模式図（縦横とも対数の目盛り。数値ではない）。低温では温度の3乗で増え、最大を経て、高温では温度に反比例して下がる（ケルン大学の講義資料）。右は、シリコンの熱伝導率。300 Kの値はCERNの資料、400 Kは反比例の近似による本サイトの見積もり">
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 160" role="img" aria-label="熱伝導率は低温で温度の3乗で増え、最大値のあと、高温で温度に反比例して下がる模式図">
      <path class="fig-line" d="M40 12V126h150" />
      <path class="fig-arrow" d="M44 118L84 50Q100 28 116 44L186 108" />
      <text class="fig-text" x="46" y="86" font-size="7">温度の3乗</text>
      <text class="fig-text" x="130" y="60" font-size="7">温度に反比例</text>
      <text class="fig-text" x="190" y="152" font-size="7" text-anchor="end">温度（対数）</text>
      <text class="fig-text" x="4" y="8" font-size="7">熱伝導率（対数）</text>
    </svg>
    <span class="fig__name">熱伝導率の温度変化（模式図）</span>
    <span class="fig__note">最大を境に、増減が入れ替わる</span>
  </li>
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 160" role="img" aria-label="シリコンの熱伝導率：300 Kで1.5、400 Kで約1.1 W/(cm·K)（見積もり）">
      <path class="fig-line" d="M80 30V110h110" />
      {items.map((m, i) => (
        <>
          <text class="fig-text" x="76" y={58 + i * 30} font-size="6" text-anchor="end">{m.name}</text>
          <rect class={i === 0 ? 'fig-film' : 'fig-wafer'} x="80" y={46 + i * 30} width={bx(m.k) - 80} height="16" />
          <text class="fig-text" x={bx(m.k) + 3} y={58 + i * 30} font-size="7">{m.k.toFixed(2)}</text>
        </>
      ))}
      <text class="fig-text" x="190" y="126" font-size="7" text-anchor="end">熱伝導率（W/(cm·K)）</text>
    </svg>
    <span class="fig__name">シリコンの熱伝導率</span>
    <span class="fig__note">400 Kは近似による見積もり</span>
  </li>
</FigureFrame>
