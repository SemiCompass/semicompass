---
// 図：接合温度と消費電力の関係（仮定の値）と、熱抵抗の大きさの比べ（仕様書 7章、8.18）
import FigureFrame from '../../../components/FigureFrame.astro';
// 仮定：周囲60℃、熱抵抗100℃/W、最大の接合温度150℃。本サイトで計算
const tj = (p: number) => 60 + 100 * p;
const tx = (p: number) => 40 + (p / 1) * 148;
const ly = (t: number) => 126 - ((t - 50) / 120) * 110;
// 熱抵抗（℃/W）：チップ自身は CERN のシリコンの熱伝導率から、100 は仮定の値
const items = [
  { name: 'チップ自身', r: 0.0333 },
  { name: '仮定の素子', r: 100 },
];
const bx = (r: number) => 70 + ((Math.log10(r) + 2) / 5) * 110;
---

<FigureFrame id="fig-thermal-design" columns={2} title="接合温度は、消費電力と熱抵抗の積だけ上がる" caption="図：左は、周囲60℃、熱抵抗100℃/Wと仮定したときの、消費電力と接合温度の関係（実際の製品の値ではない）。右は、熱抵抗の比べで、横軸は対数の目盛り。チップ自身は面積1 cm²、厚さ0.5 mmとして、CERNの資料のシリコンの熱伝導率から本サイトで計算した">
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 160" role="img" aria-label="周囲60℃で熱抵抗100℃/Wのとき、消費電力0.5 Wで接合温度は110℃、0.9 Wで150℃に達する">
      <path class="fig-line" d="M40 12V126h150" />
      {[60, 110, 150].map((t) => (
        <>
          <path class="fig-dash" d={`M40 ${ly(t)}h150`} />
          <text class="fig-text" x="36" y={ly(t) + 3} font-size="7" text-anchor="end">{t}</text>
        </>
      ))}
      {[0, 0.5, 1].map((p) => (
        <text class="fig-text" x={tx(p)} y="138" font-size="7" text-anchor="middle">{p}</text>
      ))}
      <text class="fig-text" x="190" y="152" font-size="7" text-anchor="end">消費電力（W）</text>
      <text class="fig-text" x="4" y="8" font-size="7">接合温度（℃）</text>
      <text class="fig-text" x="44" y={ly(150) - 3} font-size="6">最大の接合温度（仮定）</text>
      <path class="fig-arrow" d={`M${tx(0)} ${ly(tj(0))}L${tx(0.9)} ${ly(tj(0.9))}`} />
    </svg>
    <span class="fig__name">消費電力と接合温度</span>
    <span class="fig__note">傾きが熱抵抗にあたる</span>
  </li>
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 160" role="img" aria-label="熱抵抗：チップ自身は約0.033℃/W、仮定の素子は100℃/Wで、約3000倍の差">
      <path class="fig-line" d="M70 30V110h120" />
      {items.map((m, i) => (
        <>
          <text class="fig-text" x="66" y={58 + i * 30} font-size="7" text-anchor="end">{m.name}</text>
          <rect class={i === 0 ? 'fig-film' : 'fig-wafer'} x="70" y={46 + i * 30} width={bx(m.r) - 70} height="16" />
          <text class="fig-text" x={bx(m.r) + 3} y={58 + i * 30} font-size="7">{m.r}</text>
        </>
      ))}
      {[-2, 0, 2].map((e) => (
        <text class="fig-text" x={70 + ((e + 2) / 5) * 110} y="122" font-size="7" text-anchor="middle">10<tspan baseline-shift="super" font-size="5">{e}</tspan></text>
      ))}
      <text class="fig-text" x="190" y="138" font-size="7" text-anchor="end">熱抵抗（℃/W）</text>
    </svg>
    <span class="fig__name">熱抵抗の比べ</span>
    <span class="fig__note">桁が大きく違う</span>
  </li>
</FigureFrame>
