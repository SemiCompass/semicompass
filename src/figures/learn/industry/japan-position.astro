---
// 図：世界の半導体の売上に占める地域ごとのシェア（1988年と2019年）。数値は経済産業省「半導体政策について」（Omdiaのデータ）による（仕様書 7章、8.18）
import FigureFrame from '../../../components/FigureFrame.astro';
const years = [
  { key: '1988', label: '1988年', rows: [{ name: '日本', v: 50.3 }, { name: '米国', v: 36.8 }, { name: 'アジア', v: 3.3 }] },
  { key: '2019', label: '2019年', rows: [{ name: '日本', v: 10.0 }, { name: '米国', v: 50.7 }, { name: 'アジア', v: 25.2 }] },
];
const scale = 2.0; // 1% あたりの長さ（横軸は0%から始める）
---

<FigureFrame id="fig-japan-position" columns={2} title="世界のシェアの移り変わり" caption="図：世界の半導体の売上に占める地域ごとのシェア（%）。左は1988年、右は2019年。アジアは日本を除く。横の長さは0%から始めた。出典：経済産業省「半導体政策について」（2024年、Omdiaのデータをもとに経済産業省が作成）。本サイトで作図">
  {years.map((y) => (
    <li class="fig__panel">
      <svg class="fig__svg" viewBox="0 0 200 130" role="img" aria-label={`${y.label}：${y.rows.map((r) => `${r.name}${r.v.toFixed(1)}%`).join('、')}`}>
        <text class="fig-strong" x="10" y="18" font-size="10">{y.label}</text>
        <path class="fig-line" d="M50 28v92" />
        {y.rows.map((r, i) => (
          <>
            <text class="fig-text" x="44" y={50 + i * 30} font-size="9" text-anchor="end">{r.name}</text>
            <rect class={r.name === '日本' ? 'fig-film' : 'fig-part'} x="50" y={38 + i * 30} width={Math.max(r.v * scale, 1)} height="18" />
            <text class={r.name === '日本' ? 'fig-strong' : 'fig-text'} x={54 + r.v * scale} y={51 + i * 30} font-size="9">{r.v.toFixed(1)}%</text>
          </>
        ))}
      </svg>
      <span class="fig__name">{y.label}</span>
      <span class="fig__note">{y.key === '1988' ? '日本が半分を占めていた' : '米国とアジアが伸び、日本は10.0%に'}</span>
    </li>
  ))}
</FigureFrame>
