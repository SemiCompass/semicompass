---
// 図：減価償却と、稼働率による一つあたりの費用の違い（模式図）（仕様書 7章、8.18）
import FigureFrame from '../../../components/FigureFrame.astro';
---

<FigureFrame id="fig-capital-investment" columns={2} title="減価償却と、稼働率による一つあたりの費用の違い（模式図）" caption="図：左は、減価償却。装置の代金は、買ったときにまとめて払うが、費用としては使う期間に分けて計上する。右は、稼働率の違い。設備の費用は同じでも、処理するチップが多いほど、一つあたりの負担は小さい。目盛りのない模式図、本サイトで作成">
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 150" role="img" aria-label="買ったときの支出と、毎年の費用">
      <text class="fig-text" x="36" y="14" font-size="7" text-anchor="middle">支出</text>
      <rect class="fig-part" x="16" y="22" width="40" height="90" />
      <text class="fig-text" x="36" y="126" font-size="6.5" text-anchor="middle">買った年</text>
      <text class="fig-text" x="130" y="14" font-size="7" text-anchor="middle">費用</text>
      <rect class="fig-film" x="80" y="82" width="24" height="30" />
      <rect class="fig-film" x="108" y="82" width="24" height="30" />
      <rect class="fig-film" x="136" y="82" width="24" height="30" />
      <rect class="fig-film" x="164" y="82" width="24" height="30" />
      <text class="fig-text" x="134" y="126" font-size="6.5" text-anchor="middle">毎年に分ける</text>
      <path class="fig-arrow" d="M58 70h18M70 66l6 4-6 4"/>
    </svg>
    <span class="fig__name">減価償却</span>
    <span class="fig__note">代金を使う期間に分けて費用にする</span>
  </li>
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 150" role="img" aria-label="よく動く工場と、あまり動かない工場">
      <text class="fig-text" x="50" y="14" font-size="7" text-anchor="middle">よく動く</text>
      <text class="fig-text" x="150" y="14" font-size="7" text-anchor="middle">あまり動かない</text>
      <rect class="fig-film" x="14" y="22" width="18" height="18" />
      <rect class="fig-film" x="36" y="22" width="18" height="18" />
      <rect class="fig-film" x="58" y="22" width="18" height="18" />
      <rect class="fig-film" x="80" y="22" width="18" height="18" />
      <rect class="fig-film" x="14" y="44" width="18" height="18" />
      <rect class="fig-film" x="36" y="44" width="18" height="18" />
      <rect class="fig-film" x="58" y="44" width="18" height="18" />
      <rect class="fig-film" x="80" y="44" width="18" height="18" />
      <rect class="fig-film" x="114" y="22" width="36" height="36" />
      <rect class="fig-film" x="154" y="22" width="36" height="36" />
      <rect class="fig-film" x="114" y="62" width="36" height="36" />
      <rect class="fig-film" x="154" y="62" width="36" height="36" />
      <text class="fig-text" x="50" y="128" font-size="6.5" text-anchor="middle">一つあたりの負担：小</text>
      <text class="fig-text" x="150" y="128" font-size="6.5" text-anchor="middle">一つあたりの負担：大</text>
    </svg>
    <span class="fig__name">稼働率の違い</span>
    <span class="fig__note">処理が多いほど、一つあたりは小さい</span>
  </li>
</FigureFrame>
