---
// 図：決算の資料と、利益の段階（模式図）（仕様書 7章、8.18）
import FigureFrame from '../../../components/FigureFrame.astro';
---

<FigureFrame id="fig-reading-financials" columns={2} title="決算の資料と、利益の段階（模式図）" caption="図：左は、決算に関する資料。決算短信は簡潔、決算説明資料は図表で説明、有価証券報告書は詳しい。右は、利益の段階。売上高から費用を引いて、売上総利益、営業利益の順に小さくなる。目盛りのない模式図、本サイトで作成">
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 150" role="img" aria-label="決算短信、決算説明資料、有価証券報告書">
      <rect class="fig-film" x="16" y="12" width="100" height="34" />
      <text class="fig-text" x="66" y="33" font-size="7.5" text-anchor="middle">決算短信</text>
      <text class="fig-text" x="150" y="33" font-size="7" text-anchor="middle">簡潔</text>
      <rect class="fig-film" x="16" y="58" width="140" height="34" />
      <text class="fig-text" x="86" y="79" font-size="7.5" text-anchor="middle">決算説明資料</text>
      <text class="fig-text" x="176" y="79" font-size="7" text-anchor="middle">図表</text>
      <rect class="fig-film" x="16" y="104" width="168" height="34" />
      <text class="fig-text" x="100" y="125" font-size="7.5" text-anchor="middle">有価証券報告書</text>
    </svg>
    <span class="fig__name">決算の資料</span>
    <span class="fig__note">詳しさが違う</span>
  </li>
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 150" role="img" aria-label="売上高、売上総利益、営業利益の順に小さくなる">
      <rect class="fig-film" x="16" y="20" width="168" height="26" />
      <text class="fig-text" x="100" y="37" font-size="7.5" text-anchor="middle">売上高</text>
      <rect class="fig-film" x="16" y="56" width="118" height="26" />
      <text class="fig-text" x="75" y="73" font-size="7.5" text-anchor="middle">売上総利益</text>
      <rect class="fig-part" x="16" y="92" width="70" height="26" />
      <text class="fig-text" x="51" y="109" font-size="7.5" text-anchor="middle">営業利益</text>
      <text class="fig-text" x="100" y="138" font-size="7" text-anchor="middle">引く費用が増えるほど小さくなる</text>
    </svg>
    <span class="fig__name">利益の段階</span>
    <span class="fig__note">費用を引くごとに小さくなる</span>
  </li>
</FigureFrame>
