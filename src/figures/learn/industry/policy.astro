---
// 図：半導体を支える三つの基金と、それぞれの対象（模式図）。経済産業省の2024年の資料による（仕様書 7章、8.18）
import FigureFrame from '../../../components/FigureFrame.astro';
const funds = [
  { y: 8, name: '先端半導体基金', target: ['先端のロジック', 'メモリの工場'] },
  { y: 54, name: '経済安全保障基金', target: ['レガシー半導体', '装置・部素材・原料'] },
  { y: 100, name: 'ポスト5G基金', target: ['先端半導体の', '研究開発'] },
];
---

<FigureFrame id="fig-policy" columns={2} title="半導体を支える仕組み（模式図）" caption="図：左は、経済産業省の2024年の資料に示された、半導体を支える三つの基金と、それぞれが主に支える対象。右は、支援の考え方の流れ。半導体を特定重要物資に指定し、法律を整え、基金などで工場や研究開発、人材の育成を支える。本サイトで作成">
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 150" role="img" aria-label="三つの基金：先端半導体基金は先端の工場、経済安全保障基金はレガシー半導体や装置・部素材・原料、ポスト5G基金は研究開発">
      {funds.map((f) => (
        <>
          <rect class="fig-film" x="6" y={f.y} width="78" height="40" />
          <text class="fig-text" x="45" y={f.y + 24} font-size="7.5" text-anchor="middle">{f.name}</text>
          <path class="fig-arrow" d={`M86 ${f.y + 20}h10M90 ${f.y + 16}l6 4-6 4`} />
          <rect class="fig-part" x="100" y={f.y} width="94" height="40" />
          <text class="fig-text" x="147" y={f.y + 17} font-size="7.5" text-anchor="middle">{f.target[0]}</text>
          <text class="fig-text" x="147" y={f.y + 30} font-size="7.5" text-anchor="middle">{f.target[1]}</text>
        </>
      ))}
    </svg>
    <span class="fig__name">三つの基金</span>
    <span class="fig__note">基金のほかに、税の負担を軽くする仕組みもある</span>
  </li>
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 150" role="img" aria-label="特定重要物資に指定し、法律を整え、基金などで工場、研究開発、人材の育成を支える">
      {['特定重要物資に指定', '法律を整える', '基金などで支える'].map((t, i) => (
        <>
          <rect class={i === 2 ? 'fig-film' : 'fig-part'} x="30" y={6 + i * 30} width="140" height="22" />
          <text class="fig-text" x="100" y={21 + i * 30} font-size="8" text-anchor="middle">{t}</text>
          {i < 2 && <path class="fig-arrow" d={`M100 ${29 + i * 30}v5M97 ${31 + i * 30}l3 3 3-3`} />}
        </>
      ))}
      <path class="fig-arrow" d="M100 88v8M50 96h100M50 96v8M100 96v8M150 96v8" />
      {[{ x: 26, t: '工場' }, { x: 76, t: '研究開発' }, { x: 126, t: '人材の育成' }].map((b) => (
        <>
          <rect class="fig-part" x={b.x} y="106" width="48" height="26" />
          <text class="fig-text" x={b.x + 24} y="122" font-size="7" text-anchor="middle">{b.t}</text>
        </>
      ))}
    </svg>
    <span class="fig__name">支援の考え方の流れ</span>
    <span class="fig__note">金額や枠組みは、資料の時点のもの</span>
  </li>
</FigureFrame>
