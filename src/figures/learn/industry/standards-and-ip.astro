---
// 図：共通の決まりと、設計資産の組み合わせ（模式図）（仕様書 7章、8.18）
import FigureFrame from '../../../components/FigureFrame.astro';
---

<FigureFrame id="fig-standards-and-ip" columns={2} title="共通の決まりと、設計資産の組み合わせ（模式図）" caption="図：左は、共通の決まり。別々の会社が作った装置と容器が、共通の決まりに合わせて作られているので、組み合わせて使える。右は、設計資産。チップは、自社で設計した部分と、設計済みの部品（設計資産）を組み合わせて作る。目盛りのない模式図、本サイトで作成">
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 150" role="img" aria-label="別々の会社の装置と容器が、共通の決まりでつながる">
      <rect class="fig-film" x="10" y="60" width="56" height="36" />
      <text class="fig-text" x="38" y="82" font-size="6.5" text-anchor="middle">A社の装置</text>
      <rect class="fig-film" x="134" y="60" width="56" height="36" />
      <text class="fig-text" x="162" y="82" font-size="6.5" text-anchor="middle">B社の容器</text>
      <rect class="fig-part" x="74" y="50" width="52" height="56" />
      <text class="fig-text" x="100" y="76" font-size="7" text-anchor="middle">共通の</text>
      <text class="fig-text" x="100" y="88" font-size="7" text-anchor="middle">決まり</text>
      <path class="fig-arrow" d="M66 78h8M126 78h8"/>
      <text class="fig-text" x="100" y="126" font-size="7.5" text-anchor="middle">組み合わせて使える</text>
    </svg>
    <span class="fig__name">共通の決まり</span>
    <span class="fig__note">別の会社の製品でも組み合わせられる</span>
  </li>
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 150" role="img" aria-label="自社の設計と、設計資産の部品を組み合わせる">
      <rect class="fig-wafer" x="20" y="20" width="160" height="110" />
      <rect class="fig-part" x="30" y="30" width="60" height="40" />
      <text class="fig-text" x="60" y="54" font-size="6.5" text-anchor="middle">自社の設計</text>
      <rect class="fig-film" x="100" y="30" width="70" height="24" />
      <text class="fig-text" x="135" y="46" font-size="6.5" text-anchor="middle">演算の部品</text>
      <rect class="fig-film" x="100" y="58" width="70" height="24" />
      <text class="fig-text" x="135" y="74" font-size="6.5" text-anchor="middle">通信の部品</text>
      <rect class="fig-film" x="30" y="90" width="140" height="30" />
      <text class="fig-text" x="100" y="108" font-size="6.5" text-anchor="middle">メモリを扱う部品</text>
    </svg>
    <span class="fig__name">設計資産</span>
    <span class="fig__note">確かめられた部品を使う</span>
  </li>
</FigureFrame>
