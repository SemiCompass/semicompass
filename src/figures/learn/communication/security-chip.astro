---
// 図：鍵を守る専用の領域と、起動の確認（模式図）（仕様書 7章、8.18）
import FigureFrame from '../../../components/FigureFrame.astro';
---

<FigureFrame id="fig-security-chip" columns={2} title="鍵を守る専用の領域と、起動の確認（模式図）" caption="図：左は、セキュリティのためのチップ。鍵は専用の領域に置かれ、暗号の計算はチップの中で行う。鍵は外に出ない。右は、起動の確認。書き換えられない部分から、段階的に次を確かめる。目盛りのない模式図、本サイトで作成">
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 150" role="img" aria-label="鍵の領域、暗号の計算、外とのやり取り">
      <rect class="fig-wafer" x="50" y="14" width="100" height="100" />
      <rect class="fig-part" x="60" y="24" width="80" height="34" />
      <text class="fig-text" x="100" y="46" font-size="7.5" text-anchor="middle">鍵の領域</text>
      <rect class="fig-film" x="60" y="68" width="80" height="34" />
      <text class="fig-text" x="100" y="90" font-size="7.5" text-anchor="middle">暗号の計算</text>
      <path class="fig-arrow" d="M150 85h30M174 81l6 4-6 4M20 85h30M44 81l6 4-6 4"/>
      <text class="fig-text" x="100" y="134" font-size="7" text-anchor="middle">計算の結果だけを外へ</text>
    </svg>
    <span class="fig__name">セキュリティのチップ</span>
    <span class="fig__note">鍵は外に出さない</span>
  </li>
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 150" role="img" aria-label="書き換えられない部分から、段階的に確かめる">
      <rect class="fig-part" x="50" y="10" width="100" height="28" />
      <text class="fig-text" x="100" y="28" font-size="7" text-anchor="middle">書き換えられない部分</text>
      <path class="fig-arrow" d="M100 38v10M96 42l4 6 4-6"/>
      <rect class="fig-film" x="50" y="48" width="100" height="28" />
      <text class="fig-text" x="100" y="66" font-size="7" text-anchor="middle">次のソフトウェアを確認</text>
      <path class="fig-arrow" d="M100 76v10M96 80l4 6 4-6"/>
      <rect class="fig-film" x="50" y="86" width="100" height="28" />
      <text class="fig-text" x="100" y="104" font-size="7" text-anchor="middle">さらに次を確認</text>
      <text class="fig-text" x="100" y="134" font-size="7" text-anchor="middle">確認できたものだけ起動する</text>
    </svg>
    <span class="fig__name">起動の確認</span>
    <span class="fig__note">正しいソフトウェアだけを起動する</span>
  </li>
</FigureFrame>
