---
// 図：光通信の流れと、色の重ね方（模式図）（仕様書 7章、8.18）
import FigureFrame from '../../../components/FigureFrame.astro';
---

<FigureFrame id="fig-optical-communication" columns={2} title="光通信の流れと、色の重ね方（模式図）" caption="図：左は、光通信の流れ。電気の信号を半導体レーザーで光に変え、光ファイバで運び、受光素子で電気に戻して、増幅器で大きくする。右は、色の重ね方。色の違う光に別々のデータを乗せ、一本のファイバにまとめて送り、受ける側で色ごとに分ける。目盛りのない模式図、本サイトで作成">
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 150" role="img" aria-label="光通信の流れ">
      <rect class="fig-part" x="8" y="40" width="40" height="30" />
      <text class="fig-text" x="28" y="53" font-size="7" text-anchor="middle">電気</text>
      <text class="fig-text" x="28" y="63" font-size="6.5" text-anchor="middle">の信号</text>
      <rect class="fig-film" x="60" y="40" width="40" height="30" />
      <text class="fig-text" x="80" y="53" font-size="6.5" text-anchor="middle">レーザー</text>
      <text class="fig-text" x="80" y="63" font-size="6.5" text-anchor="middle">で光に</text>
      <path class="fig-line" d="M100 55h46" />
      <text class="fig-text" x="123" y="48" font-size="6.5" text-anchor="middle">光ファイバ</text>
      <rect class="fig-film" x="146" y="40" width="46" height="30" />
      <text class="fig-text" x="169" y="53" font-size="6.5" text-anchor="middle">受光素子</text>
      <text class="fig-text" x="169" y="63" font-size="6.5" text-anchor="middle">で電気に</text>
      <path class="fig-arrow" d="M48 55h12M100 55h4M192 55v26M188 76l4 6 4-6"/>
      <rect class="fig-part" x="146" y="86" width="46" height="26" />
      <text class="fig-text" x="169" y="102" font-size="7" text-anchor="middle">増幅</text>
    </svg>
    <span class="fig__name">光通信の流れ</span>
    <span class="fig__note">電気から光へ、光から電気へ</span>
  </li>
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 150" role="img" aria-label="色の違う三つの光を、一本の光ファイバにまとめ、受ける側で分ける">
      <path class="fig-arrow" d="M14 34h46"/>
      <path class="fig-arrow" d="M14 74h46"/>
      <path class="fig-dash" d="M14 114h46"/>
      <text class="fig-text" x="14" y="26" font-size="7" text-anchor="start">色A</text>
      <text class="fig-text" x="14" y="66" font-size="7" text-anchor="start">色B</text>
      <text class="fig-text" x="14" y="106" font-size="7" text-anchor="start">色C</text>
      <rect class="fig-film" x="60" y="26" width="16" height="96" />
      <path class="fig-line" d="M76 74h54"/>
      <rect class="fig-film" x="130" y="26" width="16" height="96" />
      <path class="fig-arrow" d="M146 34h40"/>
      <path class="fig-arrow" d="M146 74h40"/>
      <path class="fig-dash" d="M146 114h40"/>
      <text class="fig-text" x="103" y="66" font-size="7" text-anchor="middle">一本</text>
    </svg>
    <span class="fig__name">色の重ね方</span>
    <span class="fig__note">一本で運ぶ量が増える</span>
  </li>
</FigureFrame>
