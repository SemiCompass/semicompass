---
// 図：通信の階層と、方式を選ぶ観点（模式図）（仕様書 7章、8.18）
import FigureFrame from '../../../components/FigureFrame.astro';
---

<FigureFrame id="fig-protocol-layers" columns={2} title="通信の階層と、方式を選ぶ観点（模式図）" caption="図：左は、通信の階層。下から、電気の信号、データのまとめ方、手順の三つ。右は、方式を選ぶときの四つの観点。速さ、距離、配線の数、電力である。目盛りのない模式図、本サイトで作成">
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 150" role="img" aria-label="電気の信号、データのまとめ方、手順の三つの階層">
      <rect class="fig-film" x="30" y="12" width="140" height="34" />
      <text class="fig-text" x="100" y="34" font-size="7" text-anchor="middle">手順（何を頼み、何を返すか）</text>
      <rect class="fig-film" x="30" y="58" width="140" height="34" />
      <text class="fig-text" x="100" y="80" font-size="7" text-anchor="middle">データのまとめ方、誤りへの対応</text>
      <rect class="fig-part" x="30" y="104" width="140" height="34" />
      <text class="fig-text" x="100" y="126" font-size="7.5" text-anchor="middle">電気の信号の形</text>
    </svg>
    <span class="fig__name">通信の階層</span>
    <span class="fig__note">一部を入れ替えやすい</span>
  </li>
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 150" role="img" aria-label="速さ、距離、配線の数、電力">
      <rect class="fig-film" x="16" y="14" width="80" height="50" />
      <text class="fig-text" x="56" y="42" font-size="8" text-anchor="middle">速さ</text>
      <rect class="fig-film" x="104" y="14" width="80" height="50" />
      <text class="fig-text" x="144" y="42" font-size="8" text-anchor="middle">距離</text>
      <rect class="fig-film" x="16" y="78" width="80" height="50" />
      <text class="fig-text" x="56" y="100" font-size="8" text-anchor="middle">配線の数</text>
      <rect class="fig-film" x="104" y="78" width="80" height="50" />
      <text class="fig-text" x="144" y="106" font-size="8" text-anchor="middle">電力</text>
    </svg>
    <span class="fig__name">方式を選ぶ観点</span>
    <span class="fig__note">互いにつり合いの関係にある</span>
  </li>
</FigureFrame>
