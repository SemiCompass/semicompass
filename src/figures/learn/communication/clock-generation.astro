---
// 図：位相同期回路の構成と、ジッタ（模式図）（仕様書 7章、8.18）
import FigureFrame from '../../../components/FigureFrame.astro';
---

<FigureFrame id="fig-clock-generation" columns={2} title="位相同期回路の構成と、ジッタ（模式図）" caption="図：左は、位相同期回路（PLL）の構成。基準の合図と、出力を割った合図を比べ、ずれに応じて発振器を調整し、基準の整数倍の出力を得る。右は、ジッタ。切り替わる時刻が、理想の位置から前後に揺らぐ。目盛りのない模式図、本サイトで作成">
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 150" role="img" aria-label="基準と比べ、発振器を調整し、出力を割って戻す">
      <text class="fig-text" x="14" y="38" font-size="7" text-anchor="start">基準</text>
      <path class="fig-arrow" d="M14 44h22M32 40l4 4-4 4"/>
      <rect class="fig-film" x="38" y="30" width="40" height="28" />
      <text class="fig-text" x="58" y="45" font-size="7" text-anchor="middle">比較</text>
      <path class="fig-arrow" d="M78 44h12M86 40l4 4-4 4"/>
      <rect class="fig-film" x="92" y="30" width="44" height="28" />
      <text class="fig-text" x="114" y="45" font-size="7" text-anchor="middle">調整</text>
      <path class="fig-arrow" d="M136 44h12M144 40l4 4-4 4"/>
      <rect class="fig-part" x="150" y="30" width="40" height="28" />
      <text class="fig-text" x="170" y="40" font-size="6.5" text-anchor="middle">発振器</text>
      <text class="fig-text" x="170" y="52" font-size="6.5" text-anchor="middle">出力</text>
      <path class="fig-arrow" d="M170 58v30H58V76M54 82l4-6 4 6"/>
      <rect class="fig-film" x="90" y="96" width="40" height="20" />
      <text class="fig-text" x="110" y="110" font-size="7" text-anchor="middle">割る</text>
      <text class="fig-text" x="100" y="138" font-size="7" text-anchor="middle">出力は基準の整数倍</text>
    </svg>
    <span class="fig__name">PLLの構成</span>
    <span class="fig__note">基準の整数倍の出力を作る</span>
  </li>
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 150" role="img" aria-label="理想のクロックと、時刻が揺らぐクロック">
      <text class="fig-text" x="10" y="20" font-size="7" text-anchor="start">理想</text>
      <path class="fig-line" d="M10 52h20v-24h20v24h20v-24h20v24h20v-24h20v24h20v-24h20v24h20"/>
      <text class="fig-text" x="10" y="84" font-size="7" text-anchor="start">揺らぎあり</text>
      <path class="fig-line" d="M10 116h24v-24h16v24h24v-24h16v24h18v-24h22v24h14v-24h24v24h22"/>
      <text class="fig-text" x="100" y="140" font-size="7" text-anchor="middle">切り替わる時刻が前後する</text>
    </svg>
    <span class="fig__name">ジッタ</span>
    <span class="fig__note">切り替わる時刻が前後する</span>
  </li>
</FigureFrame>
