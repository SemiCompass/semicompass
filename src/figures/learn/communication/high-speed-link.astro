---
// 図：並列と直列、差動の信号（模式図）（仕様書 7章、8.18）
import FigureFrame from '../../../components/FigureFrame.astro';
---

<FigureFrame id="fig-high-speed-link" columns={2} title="並列と直列、差動の信号（模式図）" caption="図：左は、データの運び方。並列は、多数の線で同時に運ぶ。直列は、一本の道に順番に流す。右は、差動の信号。二本の線で逆の信号を送り、まわりから入る雑音は二本に同じように加わるので、差をとると打ち消される。目盛りのない模式図、本サイトで作成">
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 150" role="img" aria-label="並列と直列">
      <rect class="fig-part" x="10" y="14" width="26" height="46" />
      <rect class="fig-part" x="100" y="14" width="26" height="46" />
      <path class="fig-arrow" d="M36 22h64" />
      <path class="fig-arrow" d="M36 32h64" />
      <path class="fig-arrow" d="M36 42h64" />
      <path class="fig-arrow" d="M36 52h64" />
      <text class="fig-text" x="68" y="72" font-size="7.5" text-anchor="middle">並列：多数の線</text>
      <rect class="fig-part" x="10" y="88" width="26" height="46" />
      <rect class="fig-part" x="100" y="88" width="26" height="46" />
      <path class="fig-arrow" d="M36 111h64" />
      <text class="fig-text" x="68" y="146" font-size="7.5" text-anchor="middle">直列：一本を速く</text>
      <text class="fig-text" x="160" y="50" font-size="7" text-anchor="start">同時に</text>
      <text class="fig-text" x="160" y="125" font-size="7" text-anchor="start">順番に</text>
    </svg>
    <span class="fig__name">並列と直列</span>
    <span class="fig__note">線の数か、一本の速さか</span>
  </li>
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 150" role="img" aria-label="差動の信号">
      <polyline class="fig-arrow" points="20,50 50,50 50,30 90,30 90,50 130,50 130,30 180,30" />
      <polyline class="fig-line" points="20,90 50,90 50,110 90,110 90,90 130,90 130,110 180,110" />
      <text class="fig-text" x="100" y="20" font-size="7" text-anchor="middle">一方が上がるとき</text>
      <text class="fig-text" x="100" y="128" font-size="7" text-anchor="middle">もう一方は下がる</text>
      <path class="fig-dash" d="M70 52v36M150 52v36"/>
      <text class="fig-text" x="100" y="74" font-size="7" text-anchor="middle">差だけを見る</text>
    </svg>
    <span class="fig__name">差動の信号</span>
    <span class="fig__note">差をとると雑音が消える</span>
  </li>
</FigureFrame>
