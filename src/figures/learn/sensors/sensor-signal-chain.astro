---
// 図：信号を取り出す流れと、AD変換（模式図）（仕様書 7章、8.18）
import FigureFrame from '../../../components/FigureFrame.astro';
---

<FigureFrame id="fig-sensor-signal-chain" columns={2} title="信号を取り出す流れと、AD変換（模式図）" caption="図：左は、センサーの信号を取り出す流れ。センサーの小さな信号を、増幅し、不要な成分を取り除き、デジタルの値に変える。右は、AD変換。時間で区切って測り（標本化）、値を段階に分ける（量子化）。目盛りのない模式図、本サイトで作成">
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 150" role="img" aria-label="センサー、増幅、フィルター、AD変換、デジタルの値の順">
      <rect class="fig-part" x="50" y="6" width="100" height="22" />
      <text class="fig-text" x="100" y="21" font-size="7" text-anchor="middle">センサー（小さな信号）</text>
      <path class="fig-arrow" d="M100 28v8M96 32l4 6 4-6"/>
      <rect class="fig-film" x="50" y="38" width="100" height="22" />
      <text class="fig-text" x="100" y="53" font-size="7.5" text-anchor="middle">増幅</text>
      <path class="fig-arrow" d="M100 60v8M96 64l4 6 4-6"/>
      <rect class="fig-film" x="50" y="70" width="100" height="22" />
      <text class="fig-text" x="100" y="85" font-size="7.5" text-anchor="middle">不要な成分を取り除く</text>
      <path class="fig-arrow" d="M100 92v8M96 96l4 6 4-6"/>
      <rect class="fig-film" x="50" y="102" width="100" height="22" />
      <text class="fig-text" x="100" y="117" font-size="7.5" text-anchor="middle">AD変換</text>
      <text class="fig-text" x="100" y="141" font-size="7" text-anchor="middle">デジタルの値へ</text>
    </svg>
    <span class="fig__name">信号を取り出す流れ</span>
    <span class="fig__note">小さな信号を、扱いやすくする</span>
  </li>
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 150" role="img" aria-label="なめらかな信号を、時間で区切り、段階に当てはめる">
      <path class="fig-line" d="M14 120h176M14 120V16"/>
      <path class="fig-dash" d="M14 40h176M14 64h176M14 88h176"/>
      <path class="fig-arrow" d="M14 100 Q 50 20 90 56 T 180 40"/>
      <circle class="fig-dot" cx="30" cy="64" r="3" />
      <circle class="fig-dot" cx="60" cy="40" r="3" />
      <circle class="fig-dot" cx="90" cy="56" r="3" />
      <circle class="fig-dot" cx="120" cy="64" r="3" />
      <circle class="fig-dot" cx="150" cy="40" r="3" />
      <circle class="fig-dot" cx="180" cy="40" r="3" />
      <text class="fig-text" x="100" y="138" font-size="7" text-anchor="middle">点：時間で区切って測った値</text>
    </svg>
    <span class="fig__name">AD変換</span>
    <span class="fig__note">標本化と量子化</span>
  </li>
</FigureFrame>
