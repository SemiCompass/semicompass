---
// 図：センサーを組み合わせる流れと、弱点の補い合い（模式図）（仕様書 7章、8.18）
import FigureFrame from '../../../components/FigureFrame.astro';
---

<FigureFrame id="fig-sensor-fusion" columns={2} title="センサーを組み合わせる流れと、弱点の補い合い（模式図）" caption="図：左は、三つのセンサーの出力を、時刻をそろえて計算に集め、向きと動きを求める流れ。右は、それぞれの弱点。互いに補い合う。目盛りのない模式図、本サイトで作成">
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 150" role="img" aria-label="三つのセンサーの出力を計算に集める">
      <rect class="fig-part" x="10" y="10" width="50" height="28" />
      <text class="fig-text" x="35" y="28" font-size="7" text-anchor="middle">加速度</text>
      <rect class="fig-part" x="10" y="50" width="50" height="28" />
      <text class="fig-text" x="35" y="68" font-size="6.5" text-anchor="middle">回転の速さ</text>
      <rect class="fig-part" x="10" y="90" width="50" height="28" />
      <text class="fig-text" x="35" y="108" font-size="7" text-anchor="middle">磁気</text>
      <path class="fig-arrow" d="M60 24h20M60 64h20M60 104h20M80 24v80M80 64h20M96 60l4 4-4 4"/>
      <rect class="fig-film" x="100" y="40" width="90" height="48" />
      <text class="fig-text" x="145" y="60" font-size="7" text-anchor="middle">時刻をそろえて</text>
      <text class="fig-text" x="145" y="74" font-size="7" text-anchor="middle">計算する</text>
      <text class="fig-text" x="145" y="112" font-size="7" text-anchor="middle">向きと動きを求める</text>
    </svg>
    <span class="fig__name">組み合わせる流れ</span>
    <span class="fig__note">時刻をそろえて計算する</span>
  </li>
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 150" role="img" aria-label="三つのセンサーの弱点">
      <rect class="fig-film" x="16" y="12" width="168" height="34" />
      <text class="fig-text" x="100" y="26" font-size="7.5" text-anchor="middle">加速度</text>
      <text class="fig-text" x="100" y="39" font-size="6.5" text-anchor="middle">傾きと動きを区別しにくい</text>
      <rect class="fig-film" x="16" y="58" width="168" height="34" />
      <text class="fig-text" x="100" y="72" font-size="7.5" text-anchor="middle">回転の速さ</text>
      <text class="fig-text" x="100" y="85" font-size="6.5" text-anchor="middle">積み重ねるとずれが溜まる</text>
      <rect class="fig-film" x="16" y="104" width="168" height="34" />
      <text class="fig-text" x="100" y="118" font-size="7.5" text-anchor="middle">磁気</text>
      <text class="fig-text" x="100" y="131" font-size="6.5" text-anchor="middle">鉄や磁石に乱される</text>
    </svg>
    <span class="fig__name">それぞれの弱点</span>
    <span class="fig__note">出方が違うので補える</span>
  </li>
</FigureFrame>
