---
// 図：ホール効果と回転の検出（模式図）（仕様書 7章、8.18）
import FigureFrame from '../../../components/FigureFrame.astro';
---

<FigureFrame id="fig-magnetic-sensor" columns={2} title="ホール効果と回転の検出（模式図）" caption="図：左は、ホール素子。半導体の板に電流を流し、板に垂直に磁界をかけると、電流を運ぶ粒が片側に寄り、板の両側に電圧が生まれる。右は、回転の検出。軸に付けた磁石が回ると、そばのホール素子の出力が変わり、回転の速さや角度が分かる。目盛りのない模式図、本サイトで作成">
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 150" role="img" aria-label="ホール素子">
      <polygon class="fig-wafer" points="40,66 150,66 170,46 60,46" />
      <polygon class="fig-wafer" points="40,66 150,66 150,86 40,86" />
      <path class="fig-arrow" d="M20 76h24M150 76h26M170 72l6 4-6 4" />
      <text class="fig-text" x="20" y="98" font-size="7" text-anchor="start">電流</text>
      <path class="fig-arrow" d="M105 20v24M101 38l4 6 4-6" />
      <text class="fig-text" x="112" y="20" font-size="7" text-anchor="start">磁界</text>
      <path class="fig-line" d="M62 46l-8 20M158 46l-8 20" />
      <text class="fig-text" x="104" y="116" font-size="7.5" text-anchor="middle">板の両側の電圧</text>
      <path class="fig-dash" d="M52 100v-14M158 100v-14M52 100h106" />
    </svg>
    <span class="fig__name">板の両側に電圧</span>
    <span class="fig__note">磁界の強さと向きが分かる</span>
  </li>
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 150" role="img" aria-label="回転する軸の磁石と、そばのホール素子">
      <circle class="fig-line" cx="80" cy="76" r="44" />
      <rect class="fig-part" x="60" y="62" width="20" height="14" />
      <rect class="fig-film" x="80" y="62" width="20" height="14" />
      <text class="fig-text" x="70" y="72" font-size="7" text-anchor="middle">N</text>
      <text class="fig-text" x="90" y="72" font-size="7" text-anchor="middle">S</text>
      <path class="fig-arrow" d="M80 76m-30 -4a32 32 0 0 1 12 -22" />
      <rect class="fig-part" x="150" y="64" width="34" height="24" />
      <text class="fig-text" x="167" y="78" font-size="7" text-anchor="middle">素子</text>
      <path class="fig-arrow" d="M124 76h26" />
      <text class="fig-text" x="100" y="138" font-size="7.5" text-anchor="middle">磁石が回り、出力が変わる</text>
    </svg>
    <span class="fig__name">回転の検出</span>
    <span class="fig__note">磁石が近づくたびに出力が変わる</span>
  </li>
</FigureFrame>
