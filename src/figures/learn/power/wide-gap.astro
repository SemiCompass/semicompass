---
// 図：バンドギャップと、必要な層の厚さ（模式図）（仕様書 7章、8.18）
import FigureFrame from '../../../components/FigureFrame.astro';
---

<FigureFrame id="fig-wide-gap" columns={2} title="バンドギャップと、必要な層の厚さ（模式図）" caption="図：左は、材料によるバンドギャップの大きさの違い。炭化ケイ素と窒化ガリウムは、シリコンより広い。右は、同じ耐圧を得るのに必要な不純物の少ない層の厚さ。バンドギャップが広い材料ほど、薄くできる。目盛りのない模式図、本サイトで作成">
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 150" role="img" aria-label="シリコン、炭化ケイ素、窒化ガリウムのバンドギャップの大小">
      <path class="fig-line" d="M20 120h170M20 120V16"/>
      <rect class="fig-film" x="34" y="80" width="34" height="40" />
      <rect class="fig-part" x="90" y="50" width="34" height="70" />
      <rect class="fig-part" x="146" y="40" width="34" height="80" />
      <text class="fig-text" x="51" y="134" font-size="7" text-anchor="middle">シリコン</text>
      <text class="fig-text" x="107" y="134" font-size="7" text-anchor="middle">炭化ケイ素</text>
      <text class="fig-text" x="163" y="134" font-size="6.5" text-anchor="middle">窒化ガリウム</text>
      <text class="fig-text" x="24" y="14" font-size="7" text-anchor="start">バンドギャップ</text>
    </svg>
    <span class="fig__name">バンドギャップ</span>
    <span class="fig__note">広いと強い電界に耐える</span>
  </li>
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 150" role="img" aria-label="同じ耐圧に必要な層の厚さは、材料で違う">
      <rect class="fig-film" x="20" y="24" width="44" height="86" />
      <rect class="fig-part" x="78" y="84" width="44" height="26" />
      <rect class="fig-part" x="136" y="92" width="44" height="18" />
      <text class="fig-text" x="42" y="122" font-size="7" text-anchor="middle">シリコン</text>
      <text class="fig-text" x="100" y="122" font-size="7" text-anchor="middle">炭化ケイ素</text>
      <text class="fig-text" x="158" y="122" font-size="6.5" text-anchor="middle">窒化ガリウム</text>
      <text class="fig-text" x="100" y="138" font-size="7" text-anchor="middle">薄いほど電気が通りやすい</text>
    </svg>
    <span class="fig__name">必要な層の厚さ</span>
    <span class="fig__note">広いバンドギャップなら薄くできる</span>
  </li>
</FigureFrame>
