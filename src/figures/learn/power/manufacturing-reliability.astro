---
// 図：製造の流れと、パワーモジュールの断面（模式図）（仕様書 7章、8.18）
import FigureFrame from '../../../components/FigureFrame.astro';
---

<FigureFrame id="fig-manufacturing-reliability" columns={2} title="製造の流れと、パワーモジュールの断面（模式図）" caption="図：左は、パワー半導体に特有の製造の流れ。表側の回路を作ったあと、ウェーハを裏側から削って薄くし、裏側の層と電極を作り、試験をしてパッケージにする。右は、パワーモジュールの断面。チップで生じた熱は、はんだ、絶縁の基板、放熱板を通って逃げる。目盛りのない模式図、本サイトで作成">
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 150" role="img" aria-label="表側の回路、薄くする、裏側の電極、試験、パッケージの順">
      <rect class="fig-film" x="30" y="6" width="140" height="20" />
      <text class="fig-text" x="100" y="20" font-size="7" text-anchor="middle">表側の回路を作る</text>
      <rect class="fig-film" x="30" y="32" width="140" height="20" />
      <text class="fig-text" x="100" y="46" font-size="7" text-anchor="middle">裏側から削って薄くする</text>
      <rect class="fig-film" x="30" y="58" width="140" height="20" />
      <text class="fig-text" x="100" y="72" font-size="7" text-anchor="middle">裏側の層と電極を作る</text>
      <rect class="fig-film" x="30" y="84" width="140" height="20" />
      <text class="fig-text" x="100" y="98" font-size="7" text-anchor="middle">耐圧などを試験する</text>
      <rect class="fig-part" x="30" y="110" width="140" height="20" />
      <text class="fig-text" x="100" y="124" font-size="7" text-anchor="middle">パッケージにする</text>
    </svg>
    <span class="fig__name">製造の流れ</span>
    <span class="fig__note">ウェーハを薄くして裏側を作る</span>
  </li>
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 150" role="img" aria-label="チップ、はんだ、絶縁の基板、放熱板が重なる">
      <rect class="fig-part" x="50" y="14" width="40" height="18" />
      <rect class="fig-part" x="110" y="14" width="40" height="18" />
      <text class="fig-text" x="70" y="26" font-size="6.5" text-anchor="middle">チップ</text>
      <text class="fig-text" x="130" y="26" font-size="6.5" text-anchor="middle">チップ</text>
      <rect class="fig-resist" x="40" y="32" width="120" height="8" />
      <text class="fig-text" x="100" y="48" font-size="6.5" text-anchor="middle">はんだ</text>
      <rect class="fig-film" x="40" y="52" width="120" height="22" />
      <text class="fig-text" x="100" y="67" font-size="7" text-anchor="middle">絶縁の基板</text>
      <rect class="fig-resist" x="40" y="74" width="120" height="8" />
      <rect class="fig-wafer" x="30" y="82" width="140" height="30" />
      <text class="fig-text" x="100" y="101" font-size="7" text-anchor="middle">放熱板</text>
      <path class="fig-arrow" d="M100 112v14M96 120l4 6 4-6"/>
      <text class="fig-text" x="100" y="142" font-size="7" text-anchor="middle">熱を逃がす</text>
    </svg>
    <span class="fig__name">パワーモジュールの断面</span>
    <span class="fig__note">熱は下へ逃げる</span>
  </li>
</FigureFrame>
