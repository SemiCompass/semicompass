---
// 図：四つのスイッチで直流を交流にするインバーターと、パルス幅変調（PWM）（模式図。仕様書 7章、8.18）
import FigureFrame from '../../../components/FigureFrame.astro';
// PWM：正弦波の値に応じて、各区間の入の時間の長さを変える（模式図）
const n = 16;
const pulses = Array.from({ length: n }, (_, i) => {
  const v = Math.sin(((i + 0.5) / n) * 2 * Math.PI);
  const w = Math.abs(v) * 8;
  const x0 = 30 + i * 10 + (10 - w) / 2;
  return { x: x0, w, up: v >= 0 };
});
const sine = Array.from({ length: 41 }, (_, i) => {
  const x = 30 + (i / 40) * 160;
  const y = 80 - Math.sin((i / 40) * 2 * Math.PI) * 34;
  return `${i === 0 ? 'M' : 'L'}${x.toFixed(1)} ${y.toFixed(1)}`;
}).join('');
---

<FigureFrame id="fig-inverter" columns={2} title="インバーターとパルス幅変調（模式図）" caption="図：左は、四つのスイッチで直流を交流にするインバーターの基本の形。S1とS4が入のときと、S2とS3が入のときで、負荷（モーターなど）にかかる電圧の向きが入れ替わる。右は、パルス幅変調。入の時間の長さ（四角の幅）を少しずつ変えると、平均の電圧はなめらかな波（線）に近づく。模式図、本サイトで作成">
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 160" role="img" aria-label="直流の電源と四つのスイッチ、真ん中に負荷。対角の二つのスイッチを組にして交互に入切する">
      <path class="fig-line" d="M20 30h160M20 130h160M20 30v35M20 95v35" />
      <path class="fig-line" d="M12 65h16M15 72h10" />
      <text class="fig-text" x="6" y="88" font-size="7">直流</text>
      {[[60, 'S1'], [140, 'S2']].map(([x, l]) => (
        <>
          <path class="fig-line" d={`M${x} 30v14M${x} 62v18`} />
          <rect class="fig-part" x={Number(x) - 9} y="44" width="18" height="18" />
          <text class="fig-text" x={x} y="56" font-size="7" text-anchor="middle">{l}</text>
        </>
      ))}
      {[[60, 'S3'], [140, 'S4']].map(([x, l]) => (
        <>
          <path class="fig-line" d={`M${x} 80v18M${x} 116v14`} />
          <rect class="fig-part" x={Number(x) - 9} y="98" width="18" height="18" />
          <text class="fig-text" x={x} y="110" font-size="7" text-anchor="middle">{l}</text>
        </>
      ))}
      <path class="fig-line" d="M60 80h22M118 80h22" />
      <rect class="fig-film" x="82" y="70" width="36" height="20" />
      <text class="fig-text" x="100" y="83" font-size="7" text-anchor="middle">負荷</text>
      <path class="fig-arrow" d="M86 64h28M108 60l6 4-6 4" />
      <text class="fig-text" x="100" y="150" font-size="7" text-anchor="middle">S1・S4 と S2・S3 を交互に入切</text>
    </svg>
    <span class="fig__name">四つのスイッチで向きを入れ替える</span>
    <span class="fig__note">直流から、向きの変わる電圧を作る</span>
  </li>
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 160" role="img" aria-label="パルスの幅を少しずつ変えると、平均の電圧がなめらかな波になる">
      <path class="fig-line" d="M30 20V140M30 80h162" />
      {pulses.map((p) => (
        <rect class="fig-wafer" x={p.x} y={p.up ? 46 : 80} width={Math.max(p.w, 0.5)} height="34" />
      ))}
      <path class="fig-arrow" d={sine} />
      <text class="fig-text" x="190" y="152" font-size="7" text-anchor="end">時間</text>
      <text class="fig-text" x="34" y="16" font-size="7">電圧</text>
    </svg>
    <span class="fig__name">パルス幅変調</span>
    <span class="fig__note">入の時間の長さで、平均の電圧を変える</span>
  </li>
</FigureFrame>
