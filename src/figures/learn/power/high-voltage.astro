---
// 図：逆向きの電圧と、耐圧の考え方（模式図）（仕様書 7章、8.18）
import FigureFrame from '../../../components/FigureFrame.astro';
---

<FigureFrame id="fig-high-voltage" columns={2} title="逆向きの電圧と、耐圧の考え方（模式図）" caption="図：左は、pn接合に逆向きの電圧をかけたときの空乏層。電気を運ぶ粒が遠ざけられ、電気を通さない領域が広がって、電圧を受け持つ。右は、耐圧と層の厚さ。不純物の少ない層を厚くするほど、高い電圧に耐えられるが、電気は通りにくくなる。目盛りのない模式図、本サイトで作成">
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 150" role="img" aria-label="p型とn型の間に、空乏層が広がる">
      <rect class="fig-film" x="20" y="40" width="50" height="56" />
      <rect class="fig-resist" x="70" y="40" width="60" height="56" />
      <rect class="fig-part" x="130" y="40" width="50" height="56" />
      <text class="fig-text" x="45" y="72" font-size="7.5" text-anchor="middle">p型</text>
      <text class="fig-text" x="100" y="66" font-size="7.5" text-anchor="middle">空乏層</text>
      <text class="fig-text" x="100" y="78" font-size="6.5" text-anchor="middle">電気を通さない</text>
      <text class="fig-text" x="155" y="72" font-size="7.5" text-anchor="middle">n型</text>
      <path class="fig-arrow" d="M30 24h140"/>
      <text class="fig-text" x="100" y="18" font-size="7.5" text-anchor="middle">逆向きの電圧</text>
      <text class="fig-text" x="100" y="120" font-size="7" text-anchor="middle">電界が強すぎると、絶縁破壊</text>
    </svg>
    <span class="fig__name">逆向きの電圧で広がる</span>
    <span class="fig__note">電圧を空乏層が受け持つ</span>
  </li>
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 150" role="img" aria-label="薄い層より、厚い層のほうが高い電圧に耐える">
      <rect class="fig-wafer" x="20" y="86" width="70" height="24" />
      <rect class="fig-film" x="20" y="66" width="70" height="20" />
      <text class="fig-text" x="55" y="80" font-size="7" text-anchor="middle">薄い層</text>
      <text class="fig-text" x="55" y="128" font-size="7" text-anchor="middle">耐圧：低い</text>
      <rect class="fig-wafer" x="110" y="86" width="70" height="24" />
      <rect class="fig-film" x="110" y="26" width="70" height="60" />
      <text class="fig-text" x="145" y="60" font-size="7" text-anchor="middle">厚い層</text>
      <text class="fig-text" x="145" y="128" font-size="7" text-anchor="middle">耐圧：高い</text>
      <text class="fig-text" x="145" y="98" font-size="6.5" text-anchor="middle">基板</text>
      <text class="fig-text" x="55" y="98" font-size="6.5" text-anchor="middle">基板</text>
    </svg>
    <span class="fig__name">層の厚さと耐圧</span>
    <span class="fig__note">厚いほど耐圧は高く、電気は通りにくい</span>
  </li>
</FigureFrame>
