---
// 図：炭化ケイ素と窒化ガリウムの素子の断面（模式図）（仕様書 7章、8.18）
import FigureFrame from '../../../components/FigureFrame.astro';
---

<FigureFrame id="fig-sic-gan" columns={2} title="炭化ケイ素と窒化ガリウムの素子の断面（模式図）" caption="図：左は、炭化ケイ素の縦型の素子。表側のソースとゲートから、薄い層を通って、裏側のドレインへ電気が縦に流れる。右は、窒化ガリウムの横型の素子。基板の上に窒化ガリウムの層を重ね、電気は表面に沿って横に流れる。目盛りのない模式図、本サイトで作成">
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 150" role="img" aria-label="炭化ケイ素の縦型の素子の断面">
      <rect class="fig-metal" x="30" y="16" width="30" height="10" />
      <text class="fig-text" x="45" y="12" font-size="6.5" text-anchor="middle">ゲート</text>
      <rect class="fig-metal" x="80" y="16" width="30" height="10" />
      <text class="fig-text" x="95" y="12" font-size="6.5" text-anchor="middle">ソース</text>
      <rect class="fig-metal" x="130" y="16" width="30" height="10" />
      <rect class="fig-film" x="20" y="30" width="150" height="56" />
      <text class="fig-text" x="95" y="52" font-size="7" text-anchor="middle">不純物の少ない層</text>
      <text class="fig-text" x="95" y="64" font-size="6.5" text-anchor="middle">薄くできる</text>
      <rect class="fig-wafer" x="20" y="86" width="150" height="30" />
      <text class="fig-text" x="95" y="105" font-size="7" text-anchor="middle">炭化ケイ素の基板</text>
      <rect class="fig-metal" x="20" y="116" width="150" height="8" />
      <text class="fig-text" x="95" y="138" font-size="6.5" text-anchor="middle">ドレイン（裏側）</text>
      <path class="fig-arrow" d="M95 124v0M178 40v70M174 104l4 6 4-6"/>
    </svg>
    <span class="fig__name">炭化ケイ素（縦型）</span>
    <span class="fig__note">電気は表から裏へ縦に流れる</span>
  </li>
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 150" role="img" aria-label="窒化ガリウムの横型の素子の断面">
      <rect class="fig-metal" x="20" y="24" width="30" height="10" />
      <text class="fig-text" x="35" y="20" font-size="6.5" text-anchor="middle">ソース</text>
      <rect class="fig-metal" x="80" y="24" width="30" height="10" />
      <text class="fig-text" x="95" y="20" font-size="6.5" text-anchor="middle">ゲート</text>
      <rect class="fig-metal" x="150" y="24" width="30" height="10" />
      <text class="fig-text" x="165" y="20" font-size="6.5" text-anchor="middle">ドレイン</text>
      <rect class="fig-film" x="10" y="36" width="180" height="30" />
      <text class="fig-text" x="100" y="55" font-size="7" text-anchor="middle">窒化ガリウムの層</text>
      <path class="fig-arrow" d="M30 42h140M164 38l6 4-6 4"/>
      <rect class="fig-wafer" x="10" y="66" width="180" height="40" />
      <text class="fig-text" x="100" y="90" font-size="7" text-anchor="middle">基板（シリコンなど）</text>
      <text class="fig-text" x="100" y="126" font-size="7" text-anchor="middle">基板の上に層を重ねる</text>
    </svg>
    <span class="fig__name">窒化ガリウム（横型）</span>
    <span class="fig__note">電気は表面に沿って横に流れる</span>
  </li>
</FigureFrame>
