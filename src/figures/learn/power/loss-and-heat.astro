---
// 図：損失の二つの種類と、熱の通り道（模式図）（仕様書 7章、8.18）
import FigureFrame from '../../../components/FigureFrame.astro';
---

<FigureFrame id="fig-loss-and-heat" columns={2} title="損失の二つの種類と、熱の通り道（模式図）" caption="図：左は、スイッチの入切の様子。入のあいだは導通損失が、切り替えの途中は電圧と電流が重なって、スイッチング損失が生じる。右は、熱の通り道。チップで生じた熱は、基板、放熱板を通って、空気や水へ逃げる。目盛りのない模式図、本サイトで作成">
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 150" role="img" aria-label="入のあいだと、切り替えの途中の損失">
      <path class="fig-line" d="M14 120h176M14 120V14"/>
      <path class="fig-arrow" d="M14 100h50 L74 40 h40 L124 100 h60"/>
      <text class="fig-text" x="40" y="92" font-size="7" text-anchor="middle">切</text>
      <text class="fig-text" x="94" y="32" font-size="7" text-anchor="middle">入</text>
      <text class="fig-text" x="150" y="92" font-size="7" text-anchor="middle">切</text>
      <path class="fig-dash" d="M64 40v80M124 40v80"/>
      <text class="fig-text" x="69" y="134" font-size="6.5" text-anchor="middle">切り替え</text>
      <text class="fig-text" x="94" y="134" font-size="6.5" text-anchor="middle">導通</text>
      <text class="fig-text" x="129" y="134" font-size="6.5" text-anchor="middle">切り替え</text>
    </svg>
    <span class="fig__name">二つの損失</span>
    <span class="fig__note">導通損失とスイッチング損失</span>
  </li>
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 150" role="img" aria-label="チップから放熱板、空気や水へ">
      <rect class="fig-part" x="40" y="10" width="120" height="22" />
      <text class="fig-text" x="100" y="25" font-size="7" text-anchor="middle">チップ（熱が生まれる）</text>
      <path class="fig-arrow" d="M100 32v10M96 38l4 6 4-6"/>
      <rect class="fig-film" x="60" y="44" width="80" height="22" />
      <text class="fig-text" x="100" y="59" font-size="7.5" text-anchor="middle">基板</text>
      <path class="fig-arrow" d="M100 66v10M96 72l4 6 4-6"/>
      <rect class="fig-wafer" x="60" y="78" width="80" height="22" />
      <text class="fig-text" x="100" y="93" font-size="7.5" text-anchor="middle">放熱板</text>
      <path class="fig-arrow" d="M100 100v10M96 106l4 6 4-6"/>
      <text class="fig-text" x="100" y="128" font-size="7.5" text-anchor="middle">空気や水へ</text>
    </svg>
    <span class="fig__name">熱の通り道</span>
    <span class="fig__note">熱は温度の高いほうから低いほうへ</span>
  </li>
</FigureFrame>
