---
// 図：電気の形を変える流れ（模式図）（仕様書 7章、8.18）
import FigureFrame from '../../../components/FigureFrame.astro';
---

<FigureFrame id="fig-power-applications" columns={2} title="電気の形を変える流れ（模式図）" caption="図：左は、電気自動車。電池の直流の電気を、インバーターで交流に変えて、モーターを動かす。右は、太陽光発電。パネルの直流の電気を、パワーコンディショナーで交流に変えて、電力の網につなぐ。どちらも、中身はパワー半導体のスイッチである。目盛りのない模式図、本サイトで作成">
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 150" role="img" aria-label="電池からインバーターを通してモーターへ">
      <rect class="fig-part" x="70" y="10" width="60" height="26" />
      <text class="fig-text" x="100" y="27" font-size="7" text-anchor="middle">電池（直流）</text>
      <path class="fig-arrow" d="M100 36v18M96 48l4 6 4-6"/>
      <rect class="fig-film" x="60" y="54" width="80" height="32" />
      <text class="fig-text" x="100" y="68" font-size="7.5" text-anchor="middle">インバーター</text>
      <text class="fig-text" x="100" y="79" font-size="6.5" text-anchor="middle">パワー半導体のスイッチ</text>
      <path class="fig-arrow" d="M100 86v18M96 98l4 6 4-6"/>
      <rect class="fig-part" x="70" y="104" width="60" height="26" />
      <text class="fig-text" x="100" y="121" font-size="7" text-anchor="middle">モーター（交流）</text>
    </svg>
    <span class="fig__name">電気自動車</span>
    <span class="fig__note">直流を交流に変えて、モーターを回す</span>
  </li>
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 150" role="img" aria-label="太陽光パネルからパワーコンディショナーを通して電力の網へ">
      <rect class="fig-part" x="70" y="10" width="60" height="26" />
      <text class="fig-text" x="100" y="27" font-size="7" text-anchor="middle">パネル（直流）</text>
      <path class="fig-arrow" d="M100 36v18M96 48l4 6 4-6"/>
      <rect class="fig-film" x="60" y="54" width="80" height="32" />
      <text class="fig-text" x="100" y="68" font-size="7.5" text-anchor="middle">パワーコン</text>
      <text class="fig-text" x="100" y="79" font-size="7.5" text-anchor="middle">ディショナー</text>
      <path class="fig-arrow" d="M100 86v18M96 98l4 6 4-6"/>
      <rect class="fig-part" x="70" y="104" width="60" height="26" />
      <text class="fig-text" x="100" y="121" font-size="7" text-anchor="middle">電力の網（交流）</text>
    </svg>
    <span class="fig__name">太陽光発電</span>
    <span class="fig__note">直流を交流に変えて、網につなぐ</span>
  </li>
</FigureFrame>
