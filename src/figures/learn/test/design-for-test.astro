---
// 図：スキャンと、限られた端子（模式図）（仕様書 7章、8.18）
import FigureFrame from '../../../components/FigureFrame.astro';
---

<FigureFrame id="fig-design-for-test" columns={2} title="スキャンと、限られた端子（模式図）" caption="図：左は、スキャン。テストのときだけ、回路の途中の記憶素子を一本の列につなぎ、外から値を流し込み、結果を外へ読み出す。右は、チップの内部と端子。内部には多数の素子があるが、外からつなげる端子は限られる。目盛りのない模式図、本サイトで作成">
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 150" role="img" aria-label="記憶素子を一本の列につないで、外から読み書きする">
      <text class="fig-text" x="100" y="16" font-size="7" text-anchor="middle">テストの入力</text>
      <rect class="fig-film" x="16" y="56" width="34" height="34" />
      <rect class="fig-film" x="58" y="56" width="34" height="34" />
      <rect class="fig-film" x="100" y="56" width="34" height="34" />
      <rect class="fig-film" x="142" y="56" width="34" height="34" />
      <text class="fig-text" x="33" y="77" font-size="6.5" text-anchor="middle">記憶</text>
      <text class="fig-text" x="75" y="77" font-size="6.5" text-anchor="middle">記憶</text>
      <text class="fig-text" x="117" y="77" font-size="6.5" text-anchor="middle">記憶</text>
      <text class="fig-text" x="159" y="77" font-size="6.5" text-anchor="middle">記憶</text>
      <path class="fig-arrow" d="M10 73h6M50 73h8M92 73h8M134 73h8M176 73h14M186 69l4 4-4 4"/>
      <text class="fig-text" x="100" y="112" font-size="7" text-anchor="middle">テストの出力</text>
      <text class="fig-text" x="100" y="132" font-size="7" text-anchor="middle">回路の奥の値を外から操作できる</text>
    </svg>
    <span class="fig__name">スキャン</span>
    <span class="fig__note">外から値を流し込み、結果を読み出す</span>
  </li>
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 150" role="img" aria-label="内部には多数の素子、外につながる端子は限られる">
      <rect class="fig-wafer" x="50" y="34" width="100" height="80" />
      <circle class="fig-dot" cx="66" cy="52" r="2.5" />
      <circle class="fig-dot" cx="66" cy="68" r="2.5" />
      <circle class="fig-dot" cx="66" cy="84" r="2.5" />
      <circle class="fig-dot" cx="66" cy="100" r="2.5" />
      <circle class="fig-dot" cx="82" cy="52" r="2.5" />
      <circle class="fig-dot" cx="82" cy="68" r="2.5" />
      <circle class="fig-dot" cx="82" cy="84" r="2.5" />
      <circle class="fig-dot" cx="82" cy="100" r="2.5" />
      <circle class="fig-dot" cx="98" cy="52" r="2.5" />
      <circle class="fig-dot" cx="98" cy="68" r="2.5" />
      <circle class="fig-dot" cx="98" cy="84" r="2.5" />
      <circle class="fig-dot" cx="98" cy="100" r="2.5" />
      <circle class="fig-dot" cx="114" cy="52" r="2.5" />
      <circle class="fig-dot" cx="114" cy="68" r="2.5" />
      <circle class="fig-dot" cx="114" cy="84" r="2.5" />
      <circle class="fig-dot" cx="114" cy="100" r="2.5" />
      <circle class="fig-dot" cx="130" cy="52" r="2.5" />
      <circle class="fig-dot" cx="130" cy="68" r="2.5" />
      <circle class="fig-dot" cx="130" cy="84" r="2.5" />
      <circle class="fig-dot" cx="130" cy="100" r="2.5" />
      <rect class="fig-part" x="44" y="24" width="10" height="10" />
      <rect class="fig-part" x="72" y="24" width="10" height="10" />
      <rect class="fig-part" x="100" y="24" width="10" height="10" />
      <rect class="fig-part" x="128" y="24" width="10" height="10" />
      <rect class="fig-part" x="44" y="114" width="10" height="10" />
      <rect class="fig-part" x="72" y="114" width="10" height="10" />
      <rect class="fig-part" x="100" y="114" width="10" height="10" />
      <rect class="fig-part" x="128" y="114" width="10" height="10" />
      <text class="fig-text" x="100" y="140" font-size="7" text-anchor="middle">端子は少なく、内部は多い</text>
    </svg>
    <span class="fig__name">限られた端子</span>
    <span class="fig__note">内部は外から見えない</span>
  </li>
</FigureFrame>
