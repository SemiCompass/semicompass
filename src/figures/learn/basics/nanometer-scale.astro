---
// 図：長さの単位と、大きさの比べ方（模式図）（仕様書 7章、8.18）
import FigureFrame from '../../../components/FigureFrame.astro';
---

<FigureFrame id="fig-nanometer-scale" columns={2} title="長さの単位と、大きさの比べ方（模式図）" caption="図：左は、長さの単位。千分の一ずつ小さくなる。右は、大きさの比べ方。髪の毛や細菌はマイクロメートルの単位、ウイルスはナノメートルの単位、原子はそれよりさらに小さい。目盛りのない模式図、本サイトで作成">
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 150" role="img" aria-label="ミリメートル、マイクロメートル、ナノメートル">
      <rect class="fig-film" x="50" y="8" width="100" height="30" />
      <text class="fig-text" x="100" y="28" font-size="7.5" text-anchor="middle">ミリメートル</text>
      <text class="fig-text" x="112" y="49" font-size="7" text-anchor="start">千分の一</text>
      <path class="fig-arrow" d="M100 38v10M96 44l4 6 4-6"/>
      <rect class="fig-film" x="50" y="60" width="100" height="30" />
      <text class="fig-text" x="100" y="80" font-size="7.5" text-anchor="middle">マイクロメートル</text>
      <text class="fig-text" x="112" y="101" font-size="7" text-anchor="start">千分の一</text>
      <path class="fig-arrow" d="M100 90v10M96 96l4 6 4-6"/>
      <rect class="fig-part" x="50" y="112" width="100" height="30" />
      <text class="fig-text" x="100" y="132" font-size="7.5" text-anchor="middle">ナノメートル</text>
    </svg>
    <span class="fig__name">長さの単位</span>
    <span class="fig__note">千分の一ずつ小さくなる</span>
  </li>
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 150" role="img" aria-label="髪の毛、細菌、ウイルス、原子の大きさの順">
      <text class="fig-text" x="10" y="16" font-size="6.5" text-anchor="start">大きい</text>
      <rect class="fig-film" x="10" y="22" width="150" height="18" />
      <text class="fig-text" x="165" y="35" font-size="6.5" text-anchor="start">髪の毛</text>
      <rect class="fig-film" x="10" y="46" width="60" height="18" />
      <text class="fig-text" x="75" y="59" font-size="6.5" text-anchor="start">細菌</text>
      <rect class="fig-part" x="10" y="70" width="20" height="18" />
      <text class="fig-text" x="35" y="83" font-size="6.5" text-anchor="start">ウイルス</text>
      <rect class="fig-part" x="10" y="94" width="6" height="18" />
      <text class="fig-text" x="21" y="107" font-size="6.5" text-anchor="start">原子</text>
      <text class="fig-text" x="100" y="138" font-size="7" text-anchor="middle">小さくなるほど短い</text>
    </svg>
    <span class="fig__name">大きさの比べ方</span>
    <span class="fig__note">髪の毛より、はるかに細かい</span>
  </li>
</FigureFrame>
