---
// 図：化合物半導体の元素の組み合わせ方と、材料の使い分け（模式図）（仕様書 7章、8.18）
import FigureFrame from '../../../components/FigureFrame.astro';
const uses = [
  { y: 8, mat: 'シリコン', use: '計算・記憶の部品' },
  { y: 42, mat: 'ヒ化ガリウムなど', use: '光の部品・高い周波数' },
  { y: 76, mat: '窒化ガリウム', use: '光の部品・電力' },
  { y: 110, mat: '炭化ケイ素', use: '電力の部品' },
];
---

<FigureFrame id="fig-compound" columns={2} title="化合物半導体の組み合わせと使い分け（模式図）" caption="図：左は、化合物半導体の元素の組み合わせ方。外側の電子が三つの元素と五つの元素を組み合わせると、平均して四つになり、シリコンと同じように隣の原子と手をつなげる。右は、材料と得意な用途の組み合わせの例。模式図、本サイトで作成">
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 150" role="img" aria-label="外側の電子が三つの元素と五つの元素を組み合わせると、平均して四つになる">
      <rect class="fig-part" x="10" y="30" width="50" height="40" />
      <text class="fig-strong" x="35" y="48" font-size="9" text-anchor="middle">Ga</text>
      <text class="fig-text" x="35" y="62" font-size="7.5" text-anchor="middle">電子が三つ</text>
      <text class="fig-strong" x="72" y="56" font-size="12" text-anchor="middle">＋</text>
      <rect class="fig-part" x="84" y="30" width="50" height="40" />
      <text class="fig-strong" x="109" y="48" font-size="9" text-anchor="middle">As・N</text>
      <text class="fig-text" x="109" y="62" font-size="7.5" text-anchor="middle">電子が五つ</text>
      <path class="fig-arrow" d="M140 50h16M150 44l6 6-6 6" />
      <rect class="fig-film" x="160" y="30" width="34" height="40" />
      <text class="fig-text" x="177" y="47" font-size="7" text-anchor="middle">平均</text>
      <text class="fig-text" x="177" y="59" font-size="7" text-anchor="middle">四つ</text>
      <rect class="fig-film" x="60" y="96" width="80" height="34" />
      <text class="fig-strong" x="100" y="112" font-size="9" text-anchor="middle">Si</text>
      <text class="fig-text" x="100" y="124" font-size="7.5" text-anchor="middle">電子が四つ</text>
      <text class="fig-text" x="100" y="88" font-size="7.5" text-anchor="middle">シリコンは一種類で四つ</text>
    </svg>
    <span class="fig__name">元素の組み合わせ方</span>
    <span class="fig__note">Gaはガリウム、Asはヒ素、Nは窒素、Siはケイ素</span>
  </li>
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 150" role="img" aria-label="材料と得意な用途：シリコンは計算と記憶、化合物半導体は光、高い周波数、電力">
      {uses.map((u, i) => (
        <>
          <rect class={i === 0 ? 'fig-part' : 'fig-film'} x="6" y={u.y} width="86" height="28" />
          <text class="fig-text" x="49" y={u.y + 18} font-size="7.5" text-anchor="middle">{u.mat}</text>
          <path class="fig-arrow" d={`M94 ${u.y + 14}h12M100 ${u.y + 10}l6 4-6 4`} />
          <text class="fig-text" x="110" y={u.y + 18} font-size="7.5">{u.use}</text>
        </>
      ))}
    </svg>
    <span class="fig__name">得意なことによる使い分け</span>
    <span class="fig__note">どちらが優れているかではなく、得意なことが違う</span>
  </li>
</FigureFrame>
