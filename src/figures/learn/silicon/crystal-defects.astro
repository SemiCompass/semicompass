---
// 図：結晶の欠陥と不純物（模式図）（仕様書 7章、8.18）
import FigureFrame from '../../../components/FigureFrame.astro';
---

<FigureFrame id="fig-crystal-defects" columns={2} title="結晶の欠陥と不純物（模式図）" caption="図：左は、原子の規則正しい並びと、原子が抜けた場所（空孔）、余分な原子、別の種類の原子。右は、並びが線に沿ってずれている欠陥（転位）。目盛りのない模式図、本サイトで作成">
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 150" role="img" aria-label="原子が抜けた場所、余分な原子、別の種類の原子">
      <circle class="fig-part" cx="28" cy="20" r="5" />
      <circle class="fig-part" cx="28" cy="56" r="5" />
      <circle class="fig-part" cx="28" cy="92" r="5" />
      <circle class="fig-part" cx="64" cy="20" r="5" />
      <circle class="fig-dash" cx="64" cy="56" r="5" />
      <circle class="fig-part" cx="64" cy="92" r="5" />
      <circle class="fig-part" cx="100" cy="20" r="5" />
      <circle class="fig-part" cx="100" cy="56" r="5" />
      <circle class="fig-part" cx="100" cy="92" r="5" />
      <circle class="fig-part" cx="136" cy="20" r="5" />
      <circle class="fig-part" cx="136" cy="56" r="5" />
      <circle class="fig-resist" cx="136" cy="92" r="5" />
      <circle class="fig-part" cx="172" cy="20" r="5" />
      <circle class="fig-part" cx="172" cy="56" r="5" />
      <circle class="fig-part" cx="172" cy="92" r="5" />
      <circle class="fig-strong" cx="100" cy="74" r="4" />
      <text class="fig-text" x="100" y="122" font-size="6.5" text-anchor="middle">破線：空孔　黒：余分な原子</text>
      <text class="fig-text" x="100" y="136" font-size="6.5" text-anchor="middle">色付き：別の種類の原子</text>
    </svg>
    <span class="fig__name">点の欠陥と不純物</span>
    <span class="fig__note">規則正しい並びが乱れる</span>
  </li>
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 150" role="img" aria-label="並びが線に沿ってずれている欠陥">
      <circle class="fig-part" cx="30" cy="24" r="5" />
      <circle class="fig-part" cx="30" cy="52" r="5" />
      <circle class="fig-part" cx="58" cy="24" r="5" />
      <circle class="fig-part" cx="58" cy="52" r="5" />
      <circle class="fig-part" cx="86" cy="24" r="5" />
      <circle class="fig-part" cx="86" cy="52" r="5" />
      <circle class="fig-part" cx="114" cy="24" r="5" />
      <circle class="fig-part" cx="114" cy="52" r="5" />
      <circle class="fig-part" cx="142" cy="24" r="5" />
      <circle class="fig-part" cx="142" cy="52" r="5" />
      <circle class="fig-part" cx="170" cy="24" r="5" />
      <circle class="fig-part" cx="170" cy="52" r="5" />
      <circle class="fig-part" cx="30" cy="78" r="5" />
      <circle class="fig-part" cx="58" cy="78" r="5" />
      <circle class="fig-part" cx="86" cy="78" r="5" />
      <circle class="fig-part" cx="114" cy="78" r="5" />
      <circle class="fig-part" cx="142" cy="78" r="5" />
      <circle class="fig-part" cx="170" cy="78" r="5" />
      <circle class="fig-part" cx="44" cy="100" r="5" />
      <circle class="fig-part" cx="72" cy="100" r="5" />
      <circle class="fig-part" cx="100" cy="100" r="5" />
      <circle class="fig-part" cx="128" cy="100" r="5" />
      <circle class="fig-part" cx="156" cy="100" r="5" />
      <text class="fig-text" x="100" y="128" font-size="7" text-anchor="middle">下の列が一つ少ない</text>
      <text class="fig-text" x="100" y="14" font-size="7" text-anchor="middle">列が途中で途切れる</text>
    </svg>
    <span class="fig__name">線の欠陥</span>
    <span class="fig__note">転位</span>
  </li>
</FigureFrame>
