---
// 図：保守の考え方と、装置の時間の使い方（模式図）（仕様書 7章、8.18）
import FigureFrame from '../../../components/FigureFrame.astro';
---

<FigureFrame id="fig-equipment-maintenance" columns={2} title="保守の考え方と、装置の時間の使い方（模式図）" caption="図：左は、保守の三つの考え方。壊れてから直す、決まった間隔で保守する、前触れを見て保守する。右は、装置の時間の内訳。動いている時間が長いほど稼働率が高い。保守と故障の時間は、動かない時間になる。目盛りのない模式図、本サイトで作成">
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 150" role="img" aria-label="壊れてから、決まった間隔で、前触れを見て">
      <rect class="fig-wafer" x="16" y="12" width="168" height="34" />
      <text class="fig-text" x="100" y="26" font-size="7.5" text-anchor="middle">壊れてから直す</text>
      <text class="fig-text" x="100" y="39" font-size="6.5" text-anchor="middle">突然止まる</text>
      <rect class="fig-film" x="16" y="58" width="168" height="34" />
      <text class="fig-text" x="100" y="72" font-size="7.5" text-anchor="middle">決まった間隔で保守する</text>
      <text class="fig-text" x="100" y="85" font-size="6.5" text-anchor="middle">定期的な保守</text>
      <rect class="fig-part" x="16" y="104" width="168" height="34" />
      <text class="fig-text" x="100" y="118" font-size="7.5" text-anchor="middle">前触れを見て保守する</text>
      <text class="fig-text" x="100" y="131" font-size="6.5" text-anchor="middle">予兆の保守</text>
    </svg>
    <span class="fig__name">保守の三つの考え方</span>
    <span class="fig__note">壊れる前に手を打つ</span>
  </li>
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 150" role="img" aria-label="動いている時間と、止まっている時間">
      <text class="fig-text" x="100" y="20" font-size="7.5" text-anchor="middle">装置の一定の期間</text>
      <rect class="fig-film" x="16" y="30" width="110" height="36" />
      <text class="fig-text" x="71" y="52" font-size="7.5" text-anchor="middle">動いている</text>
      <rect class="fig-wafer" x="126" y="30" width="28" height="36" />
      <text class="fig-text" x="140" y="52" font-size="6.5" text-anchor="middle">保守</text>
      <rect class="fig-resist" x="154" y="30" width="30" height="36" />
      <text class="fig-text" x="169" y="52" font-size="6.5" text-anchor="middle">故障</text>
      <path class="fig-dash" d="M16 80h110M16 76v8M126 76v8"/>
      <text class="fig-text" x="71" y="98" font-size="7" text-anchor="middle">動く時間の割合が稼働率</text>
      <text class="fig-text" x="100" y="128" font-size="7.5" text-anchor="middle">止まる時間を短くする</text>
    </svg>
    <span class="fig__name">装置の時間</span>
    <span class="fig__note">動く時間の割合が稼働率</span>
  </li>
</FigureFrame>
