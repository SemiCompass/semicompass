---
// 図：装置を揺れから切り離す方法と、管理する環境の要素（模式図）（仕様書 7章、8.18）
import FigureFrame from '../../../components/FigureFrame.astro';
---

<FigureFrame id="fig-environment-control" columns={2} title="装置を揺れから切り離す方法と、管理する環境の要素（模式図）" caption="図：左は、揺れを抑える方法。装置を、建物の床から切り離した基礎の上に置く。右は、工場が管理する四つの環境の要素。揺れ、温度と湿度、静電気、光である。目盛りのない模式図、本サイトで作成">
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 150" role="img" aria-label="建物の床と、装置の基礎が切り離されている">
      <rect class="fig-wafer" x="10" y="100" width="70" height="20" />
      <rect class="fig-wafer" x="120" y="100" width="70" height="20" />
      <rect class="fig-part" x="80" y="106" width="40" height="30" />
      <text class="fig-text" x="40" y="114" font-size="6.5" text-anchor="middle">建物の床</text>
      <text class="fig-text" x="160" y="114" font-size="6.5" text-anchor="middle">建物の床</text>
      <text class="fig-text" x="100" y="124" font-size="6.5" text-anchor="middle">基礎</text>
      <rect class="fig-film" x="70" y="50" width="60" height="50" />
      <text class="fig-text" x="100" y="72" font-size="7.5" text-anchor="middle">装置</text>
      <text class="fig-text" x="100" y="86" font-size="6.5" text-anchor="middle">揺れが届かない</text>
      <path class="fig-dash" d="M10 94h60M130 94h60"/>
      <text class="fig-text" x="100" y="22" font-size="7" text-anchor="middle">外からの揺れ</text>
      <path class="fig-arrow" d="M30 28v22M26 44l4 6 4-6"/>
    </svg>
    <span class="fig__name">揺れを抑える</span>
    <span class="fig__note">装置は、床から切り離した基礎に置く</span>
  </li>
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 150" role="img" aria-label="揺れ、温度と湿度、静電気、光">
      <rect class="fig-film" x="16" y="14" width="80" height="50" />
      <text class="fig-text" x="56" y="42" font-size="8" text-anchor="middle">揺れ</text>
      <rect class="fig-film" x="104" y="14" width="80" height="50" />
      <text class="fig-text" x="144" y="36" font-size="7.5" text-anchor="middle">温度と</text>
      <text class="fig-text" x="144" y="48" font-size="7.5" text-anchor="middle">湿度</text>
      <rect class="fig-film" x="16" y="78" width="80" height="50" />
      <text class="fig-text" x="56" y="106" font-size="8" text-anchor="middle">静電気</text>
      <rect class="fig-film" x="104" y="78" width="80" height="50" />
      <text class="fig-text" x="144" y="106" font-size="8" text-anchor="middle">光</text>
    </svg>
    <span class="fig__name">管理する四つの要素</span>
    <span class="fig__note">どれも、形のずれや不良につながる</span>
  </li>
</FigureFrame>
