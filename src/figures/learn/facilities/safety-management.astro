---
// 図：安全を守る段階と、排気の処理（模式図）（仕様書 7章、8.18）
import FigureFrame from '../../../components/FigureFrame.astro';
---

<FigureFrame id="fig-safety-management" columns={2} title="安全を守る段階と、排気の処理（模式図）" caption="図：左は、危険な薬品やガスに備える段階。漏らさない、見つける、止める、処理するの順に重ねる。右は、排気の処理。装置から出た排気は、除害の設備で害のないものにしてから、外へ出す。目盛りのない模式図、本サイトで作成">
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 150" role="img" aria-label="漏らさない、見つける、止める、処理する">
      <rect class="fig-film" x="30" y="8" width="140" height="28" />
      <text class="fig-text" x="100" y="26" font-size="7.5" text-anchor="middle">漏らさない（配管、保管）</text>
      <rect class="fig-film" x="30" y="42" width="140" height="28" />
      <text class="fig-text" x="100" y="60" font-size="7.5" text-anchor="middle">見つける（検知、警報）</text>
      <rect class="fig-film" x="30" y="76" width="140" height="28" />
      <text class="fig-text" x="100" y="94" font-size="7.5" text-anchor="middle">止める（自動で遮断）</text>
      <rect class="fig-film" x="30" y="110" width="140" height="28" />
      <text class="fig-text" x="100" y="128" font-size="7.5" text-anchor="middle">処理する（排気、廃液）</text>
    </svg>
    <span class="fig__name">備える段階</span>
    <span class="fig__note">段階を重ねて安全を守る</span>
  </li>
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 150" role="img" aria-label="装置から除害の設備を通って外へ">
      <rect class="fig-part" x="70" y="10" width="60" height="28" />
      <text class="fig-text" x="100" y="28" font-size="7.5" text-anchor="middle">装置</text>
      <path class="fig-arrow" d="M100 38v16M96 48l4 6 4-6"/>
      <text class="fig-text" x="135" y="50" font-size="6.5" text-anchor="start">有害な排気</text>
      <rect class="fig-film" x="55" y="54" width="90" height="36" />
      <text class="fig-text" x="100" y="70" font-size="7.5" text-anchor="middle">除害の設備</text>
      <text class="fig-text" x="100" y="82" font-size="6" text-anchor="middle">燃やす・溶かす・反応</text>
      <path class="fig-arrow" d="M100 90v16M96 100l4 6 4-6"/>
      <text class="fig-text" x="100" y="126" font-size="7.5" text-anchor="middle">害のないものを外へ</text>
    </svg>
    <span class="fig__name">排気の処理</span>
    <span class="fig__note">害のないものにしてから外へ</span>
  </li>
</FigureFrame>
