---
// 図：工場の電力を使う場所と、温室効果の強いガスと水の扱い（模式図）（仕様書 7章、8.18）
import FigureFrame from '../../../components/FigureFrame.astro';
const tools = ['露光装置', 'プラズマの装置', '熱する装置', '真空のポンプ'];
const env = ['空気を送る機械', '温度と湿度の設備', '超純水の設備', 'ガスの処理'];
---

<FigureFrame id="fig-energy" columns={2} title="工場の電力と、環境への工夫（模式図）" caption="図：左は、工場の電力を使う主な場所。製造の装置と、工場の環境を保つ設備に分かれる。右は、環境への影響を減らす工夫。温室効果の強いガスは、使った後に分解してから外へ出し、水は汚れの程度に応じて分けて、もう一度使う。模式図、本サイトで作成">
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 150" role="img" aria-label="工場の電力を使う場所：製造の装置と、工場の環境を保つ設備">
      <text class="fig-strong" x="52" y="16" font-size="8" text-anchor="middle">製造の装置</text>
      <text class="fig-strong" x="148" y="16" font-size="8" text-anchor="middle">環境を保つ設備</text>
      {tools.map((t, i) => (
        <>
          <rect class="fig-film" x="8" y={24 + i * 30} width="88" height="24" />
          <text class="fig-text" x="52" y={40 + i * 30} font-size="7.5" text-anchor="middle">{t}</text>
        </>
      ))}
      {env.map((t, i) => (
        <>
          <rect class="fig-part" x="104" y={24 + i * 30} width="88" height="24" />
          <text class="fig-text" x="148" y={40 + i * 30} font-size="7.5" text-anchor="middle">{t}</text>
        </>
      ))}
    </svg>
    <span class="fig__name">電力を使う場所</span>
    <span class="fig__note">どちらも、一日中動き続ける</span>
  </li>
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 150" role="img" aria-label="ガスは使った後に分解してから外へ出し、水は分けてもう一度使う">
      <rect class="fig-part" x="10" y="12" width="52" height="26" />
      <text class="fig-text" x="36" y="29" font-size="7.5" text-anchor="middle">装置</text>
      <rect class="fig-film" x="80" y="12" width="60" height="26" />
      <text class="fig-text" x="110" y="29" font-size="7.5" text-anchor="middle">分解する装置</text>
      <path class="fig-arrow" d="M62 25h18M74 21l6 4-6 4M140 25h40M174 21l6 4-6 4" />
      <text class="fig-text" x="186" y="48" font-size="7.5" text-anchor="end">外へ</text>
      <text class="fig-text" x="36" y="50" font-size="7.5" text-anchor="middle">使った後のガス</text>
      <rect class="fig-part" x="10" y="78" width="52" height="26" />
      <text class="fig-text" x="36" y="95" font-size="7.5" text-anchor="middle">使った水</text>
      <rect class="fig-film" x="80" y="78" width="60" height="26" />
      <text class="fig-text" x="110" y="95" font-size="7.5" text-anchor="middle">汚れで分ける</text>
      <path class="fig-arrow" d="M62 91h18M74 87l6 4-6 4" />
      <path class="fig-arrow" d="M110 78V68H36v10M32 72l4 6 4-6" />
      <text class="fig-text" x="73" y="64" font-size="7.5" text-anchor="middle">もう一度使う</text>
      <path class="fig-arrow" d="M140 91h40M174 87l6 4-6 4" />
      <text class="fig-text" x="190" y="116" font-size="7.5" text-anchor="end">処理して外へ</text>
    </svg>
    <span class="fig__name">ガスと水の扱い</span>
    <span class="fig__note">ガスは分解し、水はできるだけ使い回す</span>
  </li>
</FigureFrame>
