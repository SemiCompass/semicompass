---
// 図：設計ルールと、設計と製造の分担（模式図）（仕様書 7章、8.18）
import FigureFrame from '../../../components/FigureFrame.astro';
---

<FigureFrame id="fig-design-rules" columns={2} title="設計ルールと、設計と製造の分担（模式図）" caption="図：左は、設計する側と製造する側のつながり。製造する側が、設計ルールと部品の一覧を渡し、設計する側が、それに従って設計した図面を渡す。右は、設計ルールの例。線の幅と、線の間隔に、それぞれ下限がある。目盛りのない模式図、本サイトで作成">
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 150" role="img" aria-label="製造する側がルールを渡し、設計する側が図面を渡す">
      <rect class="fig-film" x="55" y="10" width="90" height="34" />
      <text class="fig-text" x="100" y="24" font-size="7.5" text-anchor="middle">製造する側</text>
      <text class="fig-text" x="100" y="37" font-size="6.5" text-anchor="middle">ファウンドリ</text>
      <rect class="fig-film" x="55" y="106" width="90" height="34" />
      <text class="fig-text" x="100" y="120" font-size="7.5" text-anchor="middle">設計する側</text>
      <text class="fig-text" x="100" y="133" font-size="6.5" text-anchor="middle">ファブレス</text>
      <path class="fig-arrow" d="M80 44v58M76 96l4 6 4-6"/>
      <text class="fig-text" x="70" y="70" font-size="6.5" text-anchor="end">ルール</text>
      <text class="fig-text" x="70" y="80" font-size="6.5" text-anchor="end">部品の一覧</text>
      <path class="fig-arrow" d="M120 106v-58M116 54l4-6 4 6"/>
      <text class="fig-text" x="130" y="70" font-size="6.5" text-anchor="start">図面</text>
    </svg>
    <span class="fig__name">設計と製造の分担</span>
    <span class="fig__note">共通の決まりでつながる</span>
  </li>
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 150" role="img" aria-label="線の幅と線の間隔に下限がある">
      <rect class="fig-metal" x="30" y="30" width="24" height="70" />
      <rect class="fig-metal" x="90" y="30" width="24" height="70" />
      <rect class="fig-metal" x="150" y="30" width="24" height="70" />
      <path class="fig-dash" d="M30 112h24M54 108v8M30 108v8"/>
      <text class="fig-text" x="42" y="128" font-size="7" text-anchor="middle">線の幅</text>
      <path class="fig-dash" d="M54 20h36M54 16v8M90 16v8"/>
      <text class="fig-text" x="72" y="12" font-size="7" text-anchor="middle">間隔</text>
    </svg>
    <span class="fig__name">設計ルールの例</span>
    <span class="fig__note">幅と間隔に下限がある</span>
  </li>
</FigureFrame>
