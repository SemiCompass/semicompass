---
// 図：記憶素子の間の計算と、経路の長さ（模式図）（仕様書 7章、8.18）
import FigureFrame from '../../../components/FigureFrame.astro';
---

<FigureFrame id="fig-clock-timing" columns={2} title="記憶素子の間の計算と、経路の長さ（模式図）" caption="図：左は、クロックで動く回路。記憶素子から出た値が計算の回路を通り、次のクロックで次の記憶素子に取り込まれる。右は、経路ごとの所要時間。最も遅い経路が、クロックの間隔の下限を決める。目盛りのない模式図、本サイトで作成">
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 150" role="img" aria-label="記憶素子、計算の回路、記憶素子の順につながる">
      <rect class="fig-part" x="10" y="50" width="40" height="40" />
      <text class="fig-text" x="30" y="74" font-size="7.5" text-anchor="middle">記憶</text>
      <rect class="fig-film" x="70" y="50" width="60" height="40" />
      <text class="fig-text" x="100" y="66" font-size="7.5" text-anchor="middle">計算の</text>
      <text class="fig-text" x="100" y="78" font-size="7.5" text-anchor="middle">回路</text>
      <rect class="fig-part" x="150" y="50" width="40" height="40" />
      <text class="fig-text" x="170" y="74" font-size="7.5" text-anchor="middle">記憶</text>
      <path class="fig-arrow" d="M50 70h20M130 70h20M146 66l4 4-4 4M66 66l4 4-4 4"/>
      <text class="fig-text" x="100" y="28" font-size="7.5" text-anchor="middle">共通の合図（クロック）</text>
      <path class="fig-dash" d="M30 34v16M170 34v16M30 34h140"/>
      <text class="fig-text" x="100" y="118" font-size="7" text-anchor="middle">計算に時間がかかる</text>
    </svg>
    <span class="fig__name">クロックで動く回路</span>
    <span class="fig__note">次のクロックまでに結果が届く</span>
  </li>
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 150" role="img" aria-label="経路ごとの所要時間と、クロックの間隔">
      <text class="fig-text" x="10" y="18" font-size="7" text-anchor="start">所要時間</text>
      <rect class="fig-film" x="30" y="30" width="60" height="14" />
      <text class="fig-text" x="100" y="41" font-size="6.5" text-anchor="start">短い経路</text>
      <rect class="fig-film" x="30" y="52" width="90" height="14" />
      <text class="fig-text" x="130" y="63" font-size="6.5" text-anchor="start">中くらい</text>
      <rect class="fig-part" x="30" y="74" width="130" height="14" />
      <text class="fig-text" x="100" y="85" font-size="6.5" text-anchor="middle">最も遅い経路</text>
      <path class="fig-dash" d="M170 24v76"/>
      <text class="fig-text" x="170" y="112" font-size="7" text-anchor="middle">クロックの間隔</text>
      <text class="fig-text" x="100" y="134" font-size="7" text-anchor="middle">最も遅い経路より長くする</text>
    </svg>
    <span class="fig__name">経路の長さ</span>
    <span class="fig__note">最も遅い経路が上限を決める</span>
  </li>
</FigureFrame>
