---
// 図：電力の二つの使われ方と、使わない部分を止める方法（模式図）（仕様書 7章、8.18）
import FigureFrame from '../../../components/FigureFrame.astro';
---

<FigureFrame id="fig-low-power" columns={2} title="電力の二つの使われ方と、使わない部分を止める方法（模式図）" caption="図：左は、チップの電力の二つの使われ方。回路が切り替わるときに使う電力と、止まっていても漏れる電力がある。右は、使わない部分を止める方法。使う部分だけを動かし、使わない部分はクロックを止めるか、電源を切る。目盛りのない模式図、本サイトで作成">
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 150" role="img" aria-label="動くときの電力と、漏れる電力">
      <rect class="fig-film" x="20" y="24" width="160" height="40" />
      <text class="fig-text" x="100" y="41" font-size="8" text-anchor="middle">動くときの電力</text>
      <text class="fig-text" x="100" y="55" font-size="7" text-anchor="middle">切り替わるたびに使う</text>
      <rect class="fig-part" x="20" y="80" width="160" height="40" />
      <text class="fig-text" x="100" y="97" font-size="8" text-anchor="middle">漏れる電力</text>
      <text class="fig-text" x="100" y="111" font-size="7" text-anchor="middle">止まっていても漏れる</text>
    </svg>
    <span class="fig__name">電力の二つの使われ方</span>
    <span class="fig__note">切り替わるときと、止まっていても</span>
  </li>
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 150" role="img" aria-label="使う部分は動かし、使わない部分は止める">
      <rect class="fig-film" x="20" y="20" width="70" height="40" />
      <text class="fig-text" x="55" y="44" font-size="7.5" text-anchor="middle">使う部分</text>
      <rect class="fig-film" x="110" y="20" width="70" height="40" />
      <text class="fig-text" x="145" y="44" font-size="7.5" text-anchor="middle">使う部分</text>
      <rect class="fig-wafer" x="20" y="76" width="70" height="40" />
      <text class="fig-text" x="55" y="93" font-size="7.5" text-anchor="middle">使わない部分</text>
      <text class="fig-text" x="55" y="106" font-size="6.5" text-anchor="middle">クロックを止める</text>
      <rect class="fig-wafer" x="110" y="76" width="70" height="40" />
      <text class="fig-text" x="145" y="93" font-size="7.5" text-anchor="middle">使わない部分</text>
      <text class="fig-text" x="145" y="106" font-size="6.5" text-anchor="middle">電源を切る</text>
      <text class="fig-text" x="100" y="136" font-size="7" text-anchor="middle">止めると電力が減る</text>
    </svg>
    <span class="fig__name">使わない部分を止める</span>
    <span class="fig__note">クロックを止める、電源を切る</span>
  </li>
</FigureFrame>
