---
// 図：DRAMとNAND型フラッシュメモリのセル（模式図）（仕様書 7章、8.18）
import FigureFrame from '../../../components/FigureFrame.astro';
const charges = [62, 74, 86, 98, 110];
const electrons = [76, 90, 104, 118];
---

<FigureFrame id="fig-memory" columns={2} title="メモリのセルの仕組み（模式図）" caption="図：左はDRAMのセル。トランジスタを扉にして、コンデンサーに電気をためるかどうかで0と1を覚える。右はNAND型フラッシュメモリのセルの断面。ゲートとチャネルの間の、絶縁膜で囲まれた層に電子を閉じ込めて覚える。模式図、本サイトで作成">
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 150" role="img" aria-label="DRAMのセル：トランジスタが扉になり、コンデンサーに電気がたまっていると1、たまっていないと0">
      <path class="fig-line" d="M14 30h172" />
      <text class="fig-text" x="18" y="24" font-size="9">読み書きの配線</text>
      <path class="fig-line" d="M70 30v18" />
      <rect class="fig-part" x="52" y="48" width="36" height="28" />
      <text class="fig-text" x="96" y="66" font-size="9">トランジスタ（扉）</text>
      <path class="fig-line" d="M70 76v20" />
      <path class="fig-line" d="M34 96h72M34 112h72" />
      {charges.map((x) => <circle class="fig-dot" cx={x - 20} cy="104" r="2.5" />)}
      <text class="fig-text" x="114" y="102" font-size="9">コンデンサー</text>
      <text class="fig-text" x="114" y="114" font-size="9">（電気をためる）</text>
      <path class="fig-line" d="M70 112v18M58 130h24M63 135h14" />
    </svg>
    <span class="fig__name">DRAM：ためた電気で覚える</span>
    <span class="fig__note">電気が漏れるので、一定の時間ごとに書き直す</span>
  </li>
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 150" role="img" aria-label="NAND型フラッシュメモリのセルの断面：ゲートとチャネルの間に、絶縁膜で囲まれた層があり、電子を閉じ込める">
      <rect class="fig-metal" x="40" y="20" width="70" height="20" />
      <text class="fig-text" x="116" y="34" font-size="9">ゲート</text>
      <rect class="fig-film" x="40" y="40" width="70" height="10" />
      <text class="fig-text" x="116" y="48" font-size="9">絶縁膜</text>
      <rect class="fig-resist" x="40" y="50" width="70" height="18" />
      {electrons.map((x) => <circle class="fig-dot" cx={x - 22} cy="59" r="2.5" />)}
      <text class="fig-text" x="116" y="63" font-size="9">電子をためる層</text>
      <rect class="fig-film" x="40" y="68" width="70" height="10" />
      <text class="fig-text" x="116" y="76" font-size="9">絶縁膜</text>
      <rect class="fig-wafer" x="10" y="78" width="180" height="56" />
      <rect class="fig-part" x="14" y="78" width="24" height="16" />
      <rect class="fig-part" x="112" y="78" width="24" height="16" />
      <text class="fig-text" x="75" y="92" font-size="9" text-anchor="middle">チャネル</text>
      <text class="fig-text" x="100" y="122" font-size="9" text-anchor="middle">基板</text>
    </svg>
    <span class="fig__name">NAND型：電子を閉じ込めて覚える</span>
    <span class="fig__note">絶縁膜に囲まれているので、電源を切っても電子が逃げにくい</span>
  </li>
</FigureFrame>
