---
// 図：AD変換（決まった間隔で測り、段階に当てはめる）と、増幅（形を保って大きくする）（模式図）（仕様書 7章、8.18）
import FigureFrame from '../../../components/FigureFrame.astro';
const n = 12;
const levels = 8;
const pts = Array.from({ length: n }, (_, i) => {
  const t = (i + 0.5) / n;
  const v = Math.sin(2 * Math.PI * t);
  const y = 70 - v * 46;
  const step = Math.round(((v + 1) / 2) * (levels - 1));
  const yq = 116 - step * (92 / (levels - 1));
  return { x: 24 + t * 160, y, yq };
});
const wave = (amp: number, y0: number, x0: number, w: number) =>
  Array.from({ length: 41 }, (_, k) => `${(x0 + (w * k) / 40).toFixed(1)},${(y0 - amp * Math.sin((4 * Math.PI * k) / 40)).toFixed(1)}`).join(' ');
---

<FigureFrame id="fig-analog" columns={2} title="変換と増幅（模式図）" caption="図：左は、AD変換。なめらかに変わる信号（線）を決まった間隔で測り、それぞれを決まった段階（点線）のどれかに当てはめる（四角）。段階の番号が0と1の並びになる。右は、増幅。小さな信号を、形を保ったまま大きくする。目盛りのない模式図、本サイトで作成">
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 140" role="img" aria-label="AD変換：なめらかな信号を決まった間隔で測り、段階に当てはめる">
      {Array.from({ length: levels }, (_, i) => <path class="fig-dash" d={`M24 ${(116 - i * (92 / (levels - 1))).toFixed(1)}h160`} />)}
      <polyline class="fig-line" points={Array.from({ length: 49 }, (_, k) => `${(24 + (160 * k) / 48).toFixed(1)},${(70 - 46 * Math.sin((2 * Math.PI * k) / 48)).toFixed(1)}`).join(' ')} />
      {pts.map((p) => <rect class="fig-film" x={p.x - 4} y={p.yq - 4} width="8" height="8" />)}
      <text class="fig-text" x="104" y="134" font-size="8" text-anchor="middle">決まった間隔で測る → 段階の番号にする</text>
    </svg>
    <span class="fig__name">AD変換</span>
    <span class="fig__note">測る間隔が短く、段階が多いほど、元の信号に近くなる</span>
  </li>
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 140" role="img" aria-label="増幅：小さな信号を、形を保ったまま大きくする">
      <polyline class="fig-line" points={wave(8, 70, 8, 60)} />
      <path class="fig-part" d="M80 46v48l40-24z" />
      <path class="fig-line" d="M68 70h12M120 70h8" />
      <polyline class="fig-arrow" points={wave(34, 70, 130, 62)} />
      <text class="fig-text" x="38" y="112" font-size="8" text-anchor="middle">小さな信号</text>
      <text class="fig-text" x="100" y="112" font-size="8" text-anchor="middle">増幅器</text>
      <text class="fig-text" x="161" y="122" font-size="8" text-anchor="middle">大きな信号</text>
    </svg>
    <span class="fig__name">増幅</span>
    <span class="fig__note">形を保ったまま、大きさだけを大きくする</span>
  </li>
</FigureFrame>
