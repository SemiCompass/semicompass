---
// 図：プラズマを作る装置の部屋と、イオンが真上から飛び込んで垂直に削る様子（模式図）（仕様書 7章、8.18）
import FigureFrame from '../../../components/FigureFrame.astro';
const ions = [64, 100, 136];
---

<FigureFrame id="fig-plasma-process" columns={2} title="プラズマを使う工程（模式図）" caption="図：左は、プラズマを作る装置の部屋。真空に近い部屋にガスを入れ、上下の電極に電圧をかけると、ガスがプラズマ（点線の囲み）になる。下の電極にウェーハを置く。右は、プラズマを使うエッチング。プラスの電気を帯びたイオン（矢印）が真上から飛び込み、溝の底を削るので、側面はあまり削られず、垂直に深く削れる。模式図、本サイトで作成">
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 150" role="img" aria-label="プラズマを作る部屋：ガスを入れ、上下の電極に電圧をかけてプラズマを作り、下の電極にウェーハを置く">
      <rect class="fig-line" x="20" y="14" width="160" height="122" />
      <rect class="fig-metal" x="40" y="26" width="120" height="8" />
      <text class="fig-text" x="100" y="22" font-size="7.5" text-anchor="middle">電極</text>
      <rect class="fig-plasma" x="44" y="44" width="112" height="44" />
      <text class="fig-text" x="100" y="70" font-size="8" text-anchor="middle">プラズマ</text>
      <rect class="fig-wafer" x="54" y="96" width="92" height="6" />
      <rect class="fig-metal" x="40" y="102" width="120" height="10" />
      <text class="fig-text" x="100" y="126" font-size="7.5" text-anchor="middle">電極（ウェーハを置く）</text>
      <path class="fig-arrow" d="M4 54h16M14 50l6 4-6 4" />
      <text class="fig-text" x="4" y="48" font-size="7">ガス</text>
      <path class="fig-arrow" d="M180 120h16M190 116l6 4-6 4" />
      <text class="fig-text" x="196" y="146" font-size="7" text-anchor="end">吸い出す</text>
    </svg>
    <span class="fig__name">プラズマを作る</span>
    <span class="fig__note">真空に近い部屋で、ガスに電圧をかける</span>
  </li>
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 150" role="img" aria-label="イオンが真上から飛び込み、溝の底を削るので、垂直に深く削れる">
      {ions.map((x) => <path class="fig-arrow" d={`M${x} 8v30M${x - 4} 32l4 6 4-6`} />)}
      <rect class="fig-resist" x="20" y="44" width="30" height="12" />
      <rect class="fig-resist" x="78" y="44" width="44" height="12" />
      <rect class="fig-resist" x="150" y="44" width="30" height="12" />
      <path class="fig-film" d="M20 56h30v50h28v-50h44v50h28v-50h30v60H20z" />
      <rect class="fig-wafer" x="20" y="116" width="160" height="20" />
      <text class="fig-text" x="100" y="50" font-size="7" text-anchor="middle">感光材</text>
      <text class="fig-text" x="64" y="98" font-size="7" text-anchor="middle">削れた溝</text>
      <text class="fig-text" x="100" y="146" font-size="7.5" text-anchor="middle">側面はあまり削られない</text>
    </svg>
    <span class="fig__name">垂直に削る</span>
    <span class="fig__note">感光材の形どおりに、深く削り出せる</span>
  </li>
</FigureFrame>
