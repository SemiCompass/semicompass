---
// 図：イオン注入（感光材で覆って場所を決める）と、熱処理の前後（模式図）（仕様書 7章、8.18）
import FigureFrame from '../../../components/FigureFrame.astro';
const ions = [70, 84, 98, 112, 126];
const grid = Array.from({ length: 40 }, (_, i) => ({ x: 24 + (i % 10) * 17, y: 66 + Math.floor(i / 10) * 16 }));
// 打ち込んだ直後：並びを少し乱す（決まった値で、毎回同じ図にする）
const jitter = [3, -4, 2, -3, 4, -2, 3, -4, 1, -3];
---

<FigureFrame id="fig-doping" columns={3} title="イオン注入と熱処理（模式図）" caption="図：左は、イオン注入。感光材で覆った場所にはイオンが入らず、覆っていない場所にだけ入る。中は、打ち込んだ直後の結晶。原子の並びが乱れ、ドーパント（縁取りの丸）も決まった位置に収まっていない。右は、熱処理の後。並びが整い、ドーパントが決まった位置に収まって働く。模式図、本サイトで作成">
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 150" role="img" aria-label="イオン注入：感光材で覆った場所にはイオンが入らず、覆っていない場所にだけ入る">
      {ions.map((x) => <path class="fig-arrow" d={`M${x} 12v30M${x - 4} 36l4 6 4-6`} />)}
      <path class="fig-arrow" d="M30 12v24M160 12v24" />
      <rect class="fig-resist" x="10" y="40" width="54" height="14" />
      <rect class="fig-resist" x="136" y="40" width="54" height="14" />
      <rect class="fig-wafer" x="10" y="54" width="180" height="70" />
      <rect class="fig-film" x="64" y="54" width="72" height="26" />
      <text class="fig-text" x="37" y="50" font-size="7" text-anchor="middle">感光材</text>
      <text class="fig-text" x="100" y="71" font-size="8" text-anchor="middle">入った領域</text>
      <text class="fig-text" x="100" y="140" font-size="8" text-anchor="middle">深さは加速の電圧で決まる</text>
    </svg>
    <span class="fig__name">イオン注入</span>
    <span class="fig__note">覆っていない場所にだけ、イオンが入る</span>
  </li>
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 150" role="img" aria-label="打ち込んだ直後：原子の並びが乱れ、ドーパントが決まった位置に収まっていない">
      {grid.map((p, i) => <circle class="fig-dot" cx={p.x + jitter[i % 10]} cy={p.y + jitter[(i + 3) % 10]} r="3" />)}
      <circle class="fig-dot-alt" cx="58" cy="90" r="4" />
      <circle class="fig-dot-alt" cx="132" cy="76" r="4" />
      <text class="fig-text" x="100" y="40" font-size="8" text-anchor="middle">打ち込んだ直後</text>
      <text class="fig-text" x="100" y="140" font-size="8" text-anchor="middle">並びが乱れている</text>
    </svg>
    <span class="fig__name">打ち込んだ直後</span>
    <span class="fig__note">ドーパントは、まだ働いていない</span>
  </li>
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 150" role="img" aria-label="熱処理の後：原子の並びが整い、ドーパントが決まった位置に収まる">
      {grid.map((p, i) => (i === 12 || i === 27 ? <circle class="fig-dot-alt" cx={p.x} cy={p.y} r="4" /> : <circle class="fig-dot" cx={p.x} cy={p.y} r="3" />))}
      <text class="fig-text" x="100" y="40" font-size="8" text-anchor="middle">熱処理の後</text>
      <text class="fig-text" x="100" y="140" font-size="8" text-anchor="middle">並びが整い、ドーパントが働く</text>
    </svg>
    <span class="fig__name">熱処理の後</span>
    <span class="fig__note">ドーパントが決まった位置に収まる</span>
  </li>
  <ul class="fig__legend" slot="legend" aria-hidden="true">
    <li><svg class="fig__key" viewBox="0 0 24 24"><circle class="fig-dot" cx="12" cy="12" r="5" /></svg>シリコンの原子</li>
    <li><svg class="fig__key" viewBox="0 0 24 24"><circle class="fig-dot-alt" cx="12" cy="12" r="6" /></svg>ドーパント</li>
  </ul>
</FigureFrame>
