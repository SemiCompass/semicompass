---
// 図：取り除く汚れと、洗浄の流れ（模式図）（仕様書 7章、8.18）
import FigureFrame from '../../../components/FigureFrame.astro';
---

<FigureFrame id="fig-cleaning-contamination" columns={2} title="取り除く汚れと、洗浄の流れ（模式図）" caption="図：左は、洗浄で取り除く汚れの種類。粒子、金属、有機物、自然の酸化膜。右は、洗浄の流れ。薬液で汚れを取り、純水ですすぎ、乾かす。目盛りのない模式図、本サイトで作成">
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 150" role="img" aria-label="粒子、金属、有機物、酸化膜">
      <rect class="fig-film" x="16" y="14" width="80" height="50" />
      <text class="fig-text" x="56" y="42" font-size="8" text-anchor="middle">粒子</text>
      <rect class="fig-film" x="104" y="14" width="80" height="50" />
      <text class="fig-text" x="144" y="42" font-size="8" text-anchor="middle">金属</text>
      <rect class="fig-film" x="16" y="78" width="80" height="50" />
      <text class="fig-text" x="56" y="106" font-size="8" text-anchor="middle">有機物</text>
      <rect class="fig-film" x="104" y="78" width="80" height="50" />
      <text class="fig-text" x="144" y="100" font-size="7.5" text-anchor="middle">自然の</text>
      <text class="fig-text" x="144" y="112" font-size="7.5" text-anchor="middle">酸化膜</text>
    </svg>
    <span class="fig__name">取り除く汚れ</span>
    <span class="fig__note">四つの種類がある</span>
  </li>
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 150" role="img" aria-label="薬液、純水、乾燥の順">
      <rect class="fig-part" x="50" y="10" width="100" height="30" />
      <text class="fig-text" x="100" y="29" font-size="7.5" text-anchor="middle">薬液で汚れを取る</text>
      <path class="fig-arrow" d="M100 40v14M96 48l4 6 4-6"/>
      <rect class="fig-part" x="50" y="54" width="100" height="30" />
      <text class="fig-text" x="100" y="73" font-size="7.5" text-anchor="middle">純水ですすぐ</text>
      <path class="fig-arrow" d="M100 84v14M96 92l4 6 4-6"/>
      <rect class="fig-part" x="50" y="98" width="100" height="30" />
      <text class="fig-text" x="100" y="117" font-size="7.5" text-anchor="middle">むらなく乾かす</text>
    </svg>
    <span class="fig__name">洗浄の流れ</span>
    <span class="fig__note">薬液、すすぎ、乾燥</span>
  </li>
</FigureFrame>
