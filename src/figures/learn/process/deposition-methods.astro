---
// 図：三つの成膜の方法と、溝への付き方（模式図）（仕様書 7章、8.18）
import FigureFrame from '../../../components/FigureFrame.astro';
---

<FigureFrame id="fig-deposition-methods" columns={2} title="三つの成膜の方法と、溝への付き方（模式図）" caption="図：左は、三つの成膜の方法の特徴。右は、深い溝への膜の付き方。スパッタは上面に厚く付き、溝の側面や底は薄い。原子層堆積は、ほぼ均一に付く。目盛りのない模式図、本サイトで作成">
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 150" role="img" aria-label="スパッタ、化学気相成長、原子層堆積の特徴">
      <rect class="fig-film" x="16" y="12" width="168" height="34" />
      <text class="fig-text" x="100" y="27" font-size="8" text-anchor="middle">スパッタ</text>
      <text class="fig-text" x="100" y="39" font-size="6.5" text-anchor="middle">粒をたたき出して付ける</text>
      <rect class="fig-film" x="16" y="58" width="168" height="34" />
      <text class="fig-text" x="100" y="73" font-size="8" text-anchor="middle">化学気相成長</text>
      <text class="fig-text" x="100" y="85" font-size="6.5" text-anchor="middle">ガスを反応させて付ける</text>
      <rect class="fig-film" x="16" y="104" width="168" height="34" />
      <text class="fig-text" x="100" y="119" font-size="8" text-anchor="middle">原子層堆積</text>
      <text class="fig-text" x="100" y="131" font-size="6.5" text-anchor="middle">一層ずつ付ける</text>
    </svg>
    <span class="fig__name">三つの成膜の方法</span>
    <span class="fig__note">付け方と得意なことが違う</span>
  </li>
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 150" role="img" aria-label="溝の上面、側面、底への膜の付き方">
      <rect class="fig-wafer" x="8" y="60" width="20" height="60" />
      <rect class="fig-wafer" x="68" y="60" width="20" height="60" />
      <rect class="fig-wafer" x="28" y="100" width="40" height="20" />
      <rect class="fig-film" x="8" y="50" width="20" height="10" />
      <rect class="fig-film" x="68" y="50" width="20" height="10" />
      <rect class="fig-film" x="28" y="112" width="40" height="8" />
      <text class="fig-text" x="48" y="138" font-size="7" text-anchor="middle">スパッタ</text>
      <rect class="fig-wafer" x="112" y="60" width="20" height="60" />
      <rect class="fig-wafer" x="172" y="60" width="20" height="60" />
      <rect class="fig-wafer" x="132" y="100" width="40" height="20" />
      <rect class="fig-film" x="112" y="56" width="20" height="4" />
      <rect class="fig-film" x="172" y="56" width="20" height="4" />
      <rect class="fig-film" x="132" y="116" width="40" height="4" />
      <rect class="fig-film" x="130" y="60" width="2" height="56" />
      <rect class="fig-film" x="172" y="60" width="2" height="56" />
      <text class="fig-text" x="152" y="138" font-size="7" text-anchor="middle">原子層堆積</text>
    </svg>
    <span class="fig__name">溝への付き方</span>
    <span class="fig__note">均一に付く方法が細かい部分に向く</span>
  </li>
</FigureFrame>
