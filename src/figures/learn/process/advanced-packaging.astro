---
// 図：チップを横に並べる形と、縦に重ねる形の断面（模式図）（仕様書 7章、8.18）
import FigureFrame from '../../../components/FigureFrame.astro';
const bumps = (x0: number, x1: number, y: number, step = 8) => Array.from({ length: Math.floor((x1 - x0) / step) + 1 }, (_, i) => x0 + i * step).map((x) => ({ x, y }));
const stack = [36, 52, 68, 84];
---

<FigureFrame id="fig-adv-pkg" columns={2} title="チップを並べる・重ねる（断面の模式図）" caption="図：左は、チップを横に並べる形。計算をするチップと、メモリのチップを、細かい配線を持つ中継の板の上に並べ、板の中の配線（線）でチップどうしを短くつなぐ。右は、チップを縦に重ねる形。薄く削ったチップを重ね、チップを上下に貫く電極（縦の線）でつなぐ。模式図、本サイトで作成">
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 150" role="img" aria-label="計算のチップとメモリのチップを、細かい配線の中継の板の上に並べてつなぐ">
      <rect class="fig-film" x="30" y="34" width="70" height="30" />
      <text class="fig-text" x="65" y="53" font-size="8" text-anchor="middle">計算のチップ</text>
      <rect class="fig-part" x="112" y="34" width="56" height="30" />
      <text class="fig-text" x="140" y="53" font-size="8" text-anchor="middle">メモリ</text>
      {bumps(34, 96, 68).concat(bumps(116, 164, 68)).map((b) => <circle class="fig-dot" cx={b.x} cy={b.y} r="2" />)}
      <rect class="fig-resist" x="22" y="71" width="156" height="18" />
      <path class="fig-arrow" d="M90 80h34" />
      <text class="fig-text" x="100" y="100" font-size="7.5" text-anchor="middle">細かい配線の中継の板</text>
      {bumps(30, 170, 106, 10).map((b) => <circle class="fig-dot" cx={b.x} cy={b.y} r="2.5" />)}
      <rect class="fig-wafer" x="10" y="110" width="180" height="20" />
      <text class="fig-text" x="100" y="124" font-size="8" text-anchor="middle">パッケージの基板</text>
    </svg>
    <span class="fig__name">横に並べる</span>
    <span class="fig__note">中継の板の細かい配線で、チップどうしを短くつなぐ</span>
  </li>
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 150" role="img" aria-label="薄く削ったチップを重ね、上下に貫く電極でつなぐ">
      {stack.map((y) => <rect class="fig-part" x="50" y={y} width="100" height="14" />)}
      <rect class="fig-film" x="50" y="100" width="100" height="16" />
      <text class="fig-text" x="100" y="111" font-size="8" text-anchor="middle">土台のチップ</text>
      {[70, 90, 110, 130].map((x) => <path class="fig-arrow" d={`M${x} 36v64`} />)}
      <rect class="fig-wafer" x="20" y="120" width="160" height="16" />
      <text class="fig-text" x="100" y="131" font-size="8" text-anchor="middle">パッケージの基板</text>
      <text class="fig-text" x="100" y="26" font-size="8" text-anchor="middle">薄く削って重ねたチップ</text>
      <text class="fig-text" x="156" y="70" font-size="7.5">貫く</text>
      <text class="fig-text" x="156" y="80" font-size="7.5">電極</text>
    </svg>
    <span class="fig__name">縦に重ねる</span>
    <span class="fig__note">チップを貫く電極で、上下を最短の距離でつなぐ</span>
  </li>
</FigureFrame>
