---
// 図：拡散距離 2√(Dt) の時間変化と、ホウ素とヒ素の1時間での距離（仕様書 7章、8.18）
import FigureFrame from '../../../components/FigureFrame.astro';
const k = 8.617333262e-5;
// ワシントン大学の講義資料の D0、Ea で、本サイトで計算
const dd = (d0: number, ea: number, c: number) => d0 * Math.exp(-ea / (k * (c + 273.15)));
const len = (d0: number, ea: number, c: number, h: number) => 2 * Math.sqrt(dd(d0, ea, c) * h * 3600) * 1e4; // μm
const B = (c: number, h: number) => len(1.0, 3.5, c, h);
const As = (c: number, h: number) => len(9.17, 3.99, c, h);
const tx = (h: number) => 40 + (h / 4) * 148;
const ly = (u: number) => 126 - (u / 0.3) * 110;
const curve = Array.from({ length: 41 }, (_, i) => i * 0.1)
  .map((h, i) => `${i === 0 ? 'M' : 'L'}${tx(h).toFixed(1)} ${ly(B(1000, h)).toFixed(1)}`)
  .join('');
const bars = [
  { name: 'B 1,000℃', v: B(1000, 1) },
  { name: 'As 1,000℃', v: As(1000, 1) },
  { name: 'B 1,100℃', v: B(1100, 1) },
  { name: 'As 1,100℃', v: As(1100, 1) },
];
const bx = (u: number) => 62 + (u / 0.5) * 112;
---

<FigureFrame id="fig-diffusion" columns={2} title="広がる距離は、時間の平方根で増える" caption="図：左は、1,000℃でのホウ素の拡散距離 2√(Dt) と時間の関係（時間を4倍にしても距離は2倍）。右は、1時間の熱処理での距離。係数はワシントン大学の講義資料（Chapter 7）、計算は本サイト">
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 160" role="img" aria-label="1,000℃でのホウ素の拡散距離は、1時間で約0.14 μm、4時間で約0.28 μm">
      <path class="fig-line" d="M40 12V126h150" />
      {[0, 0.1, 0.2, 0.3].map((u) => (
        <>
          <path class="fig-dash" d={`M40 ${ly(u)}h150`} />
          <text class="fig-text" x="36" y={ly(u) + 3} font-size="7" text-anchor="end">{u}</text>
        </>
      ))}
      {[0, 1, 2, 3, 4].map((h) => (
        <text class="fig-text" x={tx(h)} y="138" font-size="7" text-anchor="middle">{h}</text>
      ))}
      <text class="fig-text" x="190" y="152" font-size="7" text-anchor="end">時間（時間）</text>
      <text class="fig-text" x="4" y="8" font-size="7">μm</text>
      <path class="fig-arrow" d={curve} />
    </svg>
    <span class="fig__name">拡散距離と時間</span>
    <span class="fig__note">始めに大きく進み、あとは鈍る</span>
  </li>
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 160" role="img" aria-label={`1時間の熱処理での拡散距離：1,000℃でホウ素約${bars[0].v.toFixed(2)} μm、ヒ素約${bars[1].v.toFixed(3)} μm、1,100℃でホウ素約${bars[2].v.toFixed(2)} μm、ヒ素約${bars[3].v.toFixed(2)} μm`}>
      <path class="fig-line" d="M62 20V130h128" />
      {bars.map((b, i) => (
        <>
          <text class="fig-text" x="58" y={40 + i * 26} font-size="7" text-anchor="end">{b.name}</text>
          <rect class={i % 2 === 0 ? 'fig-film' : 'fig-wafer'} x="62" y={29 + i * 26} width={bx(b.v) - 62} height="14" />
          <text class="fig-text" x={bx(b.v) + 3} y={40 + i * 26} font-size="7">{b.v.toFixed(2)}</text>
        </>
      ))}
      <text class="fig-text" x="190" y="146" font-size="7" text-anchor="end">距離（μm）</text>
    </svg>
    <span class="fig__name">1時間での距離</span>
    <span class="fig__note">温度を上げると、約3倍に広がる</span>
  </li>
</FigureFrame>
