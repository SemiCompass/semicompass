---
// 図：低温シリコンのエピタキシーの成長速度の実測値と、温度依存の領域（仕様書 7章、8.18）
import FigureFrame from '../../../components/FigureFrame.astro';
// Chung ほか（Applied Physics Letters 92, 113506）の値（nm/分）
const pts = [
  { c: 600, v: 54 },
  { c: 650, v: 130 },
  { c: 700, v: 215 },
];
const tx = (c: number) => 40 + ((c - 580) / 140) * 148;
const ly = (v: number) => 126 - (v / 250) * 110;
const line = pts.map((p, i) => `${i === 0 ? 'M' : 'L'}${tx(p.c)} ${ly(p.v)}`).join('');
---

<FigureFrame id="fig-vapor-growth" columns={2} title="成長の速さは、温度が低いほど温度に敏感" caption="図：左は、低温のシリコンのエピタキシーの成長速度の実測値（原料はネオペンタシラン、分圧20 mtorr）。Chung ほか、Applied Physics Letters 92, 113506。右は、温度による成長の速さの変わり方の模式図で、縦は対数の目盛り（数値ではない）">
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 160" role="img" aria-label="成長の速さは600℃で約54、650℃で約130、700℃で約215 nm/分">
      <path class="fig-line" d="M40 12V126h150" />
      {[0, 100, 200].map((v) => (
        <>
          <path class="fig-dash" d={`M40 ${ly(v)}h150`} />
          <text class="fig-text" x="36" y={ly(v) + 3} font-size="7" text-anchor="end">{v}</text>
        </>
      ))}
      {[600, 650, 700].map((c) => (
        <text class="fig-text" x={tx(c)} y="138" font-size="7" text-anchor="middle">{c}</text>
      ))}
      <text class="fig-text" x="190" y="152" font-size="7" text-anchor="end">温度（℃）</text>
      <text class="fig-text" x="4" y="152" font-size="7">縦：nm/分</text>
      <path class="fig-arrow" d={line} />
      {pts.map((p) => (
        <>
          <circle class="fig-film" cx={tx(p.c)} cy={ly(p.v)} r="3.5" />
          <text class="fig-text" x={p.c === 700 ? tx(p.c) - 2 : tx(p.c) + 6} y={ly(p.v) + 12} font-size="7" text-anchor={p.c === 700 ? 'end' : 'start'}>{p.v}</text>
        </>
      ))}
    </svg>
    <span class="fig__name">成長速度の実測値</span>
    <span class="fig__note">100℃の上昇で約4倍</span>
  </li>
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 160" role="img" aria-label="模式図：低温側では温度とともに急に増え、高温側では増え方が小さくなって寝る">
      <path class="fig-line" d="M40 12V126h150" />
      <path class="fig-dash" d="M120 12V126" />
      <path class="fig-arrow" d="M44 118C70 112 96 80 120 52C140 36 164 32 186 30" />
      <text class="fig-text" x="42" y="146" font-size="7">低温</text>
      <text class="fig-text" x="188" y="146" font-size="7" text-anchor="end">高温</text>
      <text class="fig-text" x="46" y="30" font-size="7">表面の反応で決まる</text>
      <text class="fig-text" x="124" y="108" font-size="7">原料の供給で決まる</text>
      <text class="fig-text" x="4" y="8" font-size="7">縦：成長の速さ（対数）</text>
    </svg>
    <span class="fig__name">二つの領域（模式図）</span>
    <span class="fig__note">高温側は、温度にほとんど依存しない</span>
  </li>
</FigureFrame>
