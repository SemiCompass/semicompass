---
// 図：ドレイン電流の電圧依存（長チャネルの式）と、しきい値前後のゲート特性の模式図（仕様書 7章、8.18）
import FigureFrame from '../../../components/FigureFrame.astro';
// 仮定：tox 5 nm、W/L = 10、μ = 400 cm2/Vs。K = μ Cox W/L（A/V2）。本サイトで計算
const K = 400 * ((3.9 * 8.854e-14) / 5e-7) * 10;
const id = (vov: number, vds: number) =>
  vds < vov ? K * (vov - vds / 2) * vds : 0.5 * K * vov * vov; // A
const tx = (v: number) => 40 + (v / 2) * 148;
const ly = (a: number) => 126 - (a / 0.004) * 110;
const curve = (vov: number) =>
  Array.from({ length: 41 }, (_, i) => i * 0.05)
    .map((v, i) => `${i === 0 ? 'M' : 'L'}${tx(v).toFixed(1)} ${ly(id(vov, v) ).toFixed(1)}`)
    .join('');
---

<FigureFrame id="fig-mosfet-current" columns={2} title="しきい値を超えると電流は2乗で増え、下では指数で減る" caption="図：左は、VGS−VT が0.5 V、1 V、1.5 V のときのドレイン電流とドレイン電圧の関係（酸化膜5 nm、W/L=10、移動度400 cm²/(V·s)は仮定の値）。式は UCSB と MIT OpenCourseWare の資料、計算は本サイト。右は、ゲートの電圧と電流の関係の模式図（縦は対数。数値ではない）で、しきい値より下の傾きは室温で約60 mV/桁が下限（arXiv:1811.09146）">
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 160" role="img" aria-label="ドレイン電流はドレイン電圧とともに増えてから一定になり、VGS−VTが大きいほど大きな値で一定になる">
      <path class="fig-line" d="M40 12V126h150" />
      {[0, 2, 4].map((m) => (
        <>
          <path class="fig-dash" d={`M40 ${ly(m * 1e-3)}h150`} />
          <text class="fig-text" x="36" y={ly(m * 1e-3) + 3} font-size="7" text-anchor="end">{m}</text>
        </>
      ))}
      {[0, 1, 2].map((v) => (
        <text class="fig-text" x={tx(v)} y="138" font-size="7" text-anchor="middle">{v}</text>
      ))}
      <text class="fig-text" x="190" y="152" font-size="7" text-anchor="end">ドレインの電圧（V）</text>
      <text class="fig-text" x="4" y="8" font-size="7">ID（mA）</text>
      <path class="fig-line" d={curve(0.5)} />
      <path class="fig-arrow" d={curve(1)} />
      <path class="fig-line" d={curve(1.5)} />
      <text class="fig-text" x="146" y={ly(0.5 * K * 2.25) - 4} font-size="7">1.5 V</text>
      <text class="fig-text" x="146" y={ly(0.5 * K) - 4} font-size="7">1 V</text>
      <text class="fig-text" x="146" y={ly(0.5 * K * 0.25) - 4} font-size="7">0.5 V</text>
    </svg>
    <span class="fig__name">ドレイン電流と電圧</span>
    <span class="fig__note">曲線ごとに、VGS−VT が違う</span>
  </li>
  <li class="fig__panel">
    <svg class="fig__svg" viewBox="0 0 200 160" role="img" aria-label="ゲートの電圧がしきい値より下では電流が指数で減り、しきい値より上では2乗で増える模式図">
      <path class="fig-line" d="M40 12V126h150" />
      <path class="fig-dash" d="M110 12V126" />
      <path class="fig-arrow" d="M44 120L110 80C130 56 150 36 180 18" />
      <text class="fig-text" x="112" y="140" font-size="7">VT</text>
      <text class="fig-text" x="44" y="100" font-size="7">傾きの下限</text>
      <text class="fig-text" x="44" y="110" font-size="7">約60 mV/桁</text>
      <text class="fig-text" x="190" y="152" font-size="7" text-anchor="end">ゲートの電圧</text>
      <text class="fig-text" x="4" y="8" font-size="7">ID（対数）</text>
    </svg>
    <span class="fig__name">ゲートの電圧と電流（模式図）</span>
    <span class="fig__note">しきい値の前後で、形が変わる</span>
  </li>
</FigureFrame>
