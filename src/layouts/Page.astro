---
// ページの共通の並び（要件定義書 3.2、仕様書 6.2、8.1〜8.4）：パンくず → ページの頭 → （目次）→ 本文
// PC（1024px以上）：本文（最大40rem）と右の列（16rem）の2列。右の列に、ページ内の目次を置く
// スマートフォンとタブレット：1列。目次は、大見出しの後に、開閉式で置く
// lead スロット：大見出しの後、目次の前に置くもの（企業ページの「この会社のポイント」。要件定義書 3.4の順）
// head スロット：ページの頭（PageHead）の代わりに置くもの（企業ページの「企業の頭」。仕様書 8.8）。大見出しを必ず含める
// aside スロット：右の列に、目次の下に置くもの（正式公開で、広告の枠を置く）。目次と同じ流れの中に置き、目次と一緒に張り付く
import Breadcrumb from '../components/Breadcrumb.astro';
import PageHead from '../components/PageHead.astro';
import Toc from '../components/Toc.astro';
import Base from './Base.astro';
import { AUTHOR, breadcrumbLd, contentLd, type SchemaType } from '../lib/seo';

interface Props {
  title: string; // <title> に使う（例：「企業一覧｜SemiCompass」）
  heading?: string; // 大見出し。省略すると title
  description: string;
  breadcrumbs?: { label: string; href?: string }[];
  toc?: { id: string; label: string }[];
  publishedAt?: string;
  updatedAt?: string;
  author?: string;
  category?: string; // ニュースの種別（日付の行に出す）
  noindex?: boolean;
  wide?: boolean; // 右の列を持たないページ（トップ、一覧、検索）：外枠の幅いっぱいを使う
  schemaType?: SchemaType; // 解説のページの構造化データの種類（SE-03、NF-07）。付けると、作成者も表示する
}
const { title, heading, description, breadcrumbs = [], toc = [], publishedAt, updatedAt, category, noindex, wide = false, schemaType } =
  Astro.props;
// 作成者（SE-03）：解説のページでは運営者（/about/ へのリンク）
const author = Astro.props.author ?? (schemaType ? AUTHOR.name : undefined);
const site = Astro.site as URL;
const canonical = new URL(Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`, site).href;
const jsonLd = [
  ...(breadcrumbs.length > 0 ? [breadcrumbLd(breadcrumbs, canonical, site)] : []),
  ...(schemaType
    ? [contentLd(schemaType, { headline: heading ?? title, description, url: canonical, published: publishedAt, modified: updatedAt }, site)]
    : []),
];
const hasAside = !wide;
---

<Base title={title} description={description} noindex={noindex} jsonLd={jsonLd} ogType={schemaType && schemaType !== 'DefinedTerm' ? 'article' : 'website'} lastmod={updatedAt ?? publishedAt}>
  <div class="container page">
    {breadcrumbs.length > 0 && <Breadcrumb items={breadcrumbs} />}
    {Astro.slots.has('head') ? <slot name="head" /> : <PageHead title={heading ?? title} publishedAt={publishedAt} updatedAt={updatedAt} author={author} category={category} />}
    <slot name="lead" />
    {toc.length > 0 && <Toc items={toc} variant="fold" always={wide} />}
    <div class:list={['page__grid', { 'page__grid--two': hasAside }]}>
      <div class="page__body"><slot /></div>
      {hasAside && (
        <aside class="page__aside" aria-label="補足">
          <div class="page__aside-sticky">
            {toc.length > 0 && <Toc items={toc} variant="side" />}
            <slot name="aside" />
          </div>
        </aside>
      )}
    </div>
  </div>
</Base>

<style>
  @import "../styles/breakpoints.css";

  .page {
    padding-block: var(--space-5) var(--space-6);
  }
  .page__body {
    min-width: 0;
    max-width: var(--content-max-width);
  }
  .page__grid:not(.page__grid--two) .page__body {
    max-width: none;
  }
  @media (--pc) {
    .page__grid--two {
      display: grid;
      grid-template-columns: minmax(0, var(--content-max-width)) var(--aside-width);
      column-gap: var(--aside-gap);
    }
    /* 右の列は、本文と同じ高さに伸ばし、その中の1つのまとまり（目次と、その下の要素）を張り付ける。
       まとまりは、画面に収まる高さにし、収まらないときは、その中だけでスクロールする（下の要素と重ならない） */
    .page__aside-sticky {
      position: sticky;
      top: var(--toc-sticky-top);
      max-height: var(--aside-max-height);
      overflow-y: auto;
    }
  }
</style>
