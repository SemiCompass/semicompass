---
// すべてのページの共通の枠（要件定義書 3.2）：ヘッダー、本文（<main>）、フッター
import '../styles/global.css';
import { BUILD_ENV } from 'astro:env/server';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

interface Props {
  title: string;
  description: string;
  noindex?: boolean; // 検索に登録させない指定（プレビューのビルドでは、常に付く）
}

const { title, description, noindex = false } = Astro.props;

// 正規のURL：site とそのページのパスから作る。末尾はスラッシュに統一する（要件定義書3.1）
if (!Astro.site) {
  throw new Error('astro.config.mjs の site が設定されていない');
}
const canonicalPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonicalUrl = new URL(canonicalPath, Astro.site).href;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {(BUILD_ENV === 'preview' || noindex) && <meta name="robots" content="noindex, nofollow" />}
  </head>
  <body>
    <a class="skip-link" href="#main">本文へ移動</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
