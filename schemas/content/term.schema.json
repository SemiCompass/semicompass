{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/content/term.schema.json",
  "title": "用語（D15）の front matter",
  "description": "データ定義書（第1段階）6.1、6.6。content/glossary/{slug}.md の先頭の項目（front matter）だけを検査する。本文の決まり（200〜400字の目安、[S1]などの番号が sources にあること、sources の資料が本文で使われていること、元の文章を写さないこと）は、スキーマでは検査できないため、別の検査（V-12など）で行う。title は term から作るため、使わない。description の長さの目安（50〜120字、暫定）は、警告の検査（V-12）で行う。ファイル名と term の slug の関係、processes・companies・related_terms の参照先の存在、term と aliases の全体での重複（V-16）も、別の検査で行う。easy_body は公開後の項目で、第1段階では使わない。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "term",
    "reading",
    "short_definition",
    "processes",
    "description",
    "published_at",
    "ai_generated",
    "sources"
  ],
  "properties": {
    "term": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "reading": {
      "type": "string",
      "pattern": "^[\\u30A1-\\u30FA\\u30FB\\u30FC]+$",
      "minLength": 1,
      "maxLength": 80
    },
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "name_en": {
      "type": "string",
      "minLength": 1
    },
    "abbreviation_of": {
      "type": "string",
      "minLength": 1
    },
    "short_definition": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "processes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
        "minLength": 2,
        "maxLength": 60
      }
    },
    "companies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
        "minLength": 2,
        "maxLength": 60
      }
    },
    "related_terms": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
        "minLength": 2,
        "maxLength": 60
      }
    },
    "easy_body": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "published_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "format": "date"
    },
    "updated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "format": "date"
    },
    "draft": {
      "type": "boolean"
    },
    "ai_generated": {
      "type": "boolean"
    },
    "under_review": {
      "type": "boolean"
    },
    "corrections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "severity",
          "description"
        ],
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "format": "date"
          },
          "severity": {
            "enum": [
              "major",
              "normal"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "issue": {
            "type": "integer"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "publisher",
          "url",
          "accessed_on"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^S[0-9]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "publisher": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https?://\\S+$"
          },
          "published_on": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "format": "date"
          },
          "accessed_on": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "format": "date"
          },
          "doc_id": {
            "type": "string",
            "pattern": "^S100[0-9A-Z]{4}$"
          },
          "pages": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
