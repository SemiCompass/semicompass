{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/content/news.schema.json",
  "title": "ニュース（D11）の front matter",
  "description": "データ定義書（第1段階）6.2。content/news/{yyyy}-{mm}-{slug}.md の先頭の項目（front matter）だけを検査する。本文の決まり（3つの中見出しをこの順で置く、400〜700字の目安、海外のときの日本企業の記述、元記事の文章を写さない）、ファイル名と published_at の年月の一致、tags の参照先の存在は、別の検査で行う。元記事の本文は持たない（FR-402、要件7.12）。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "description",
    "published_at",
    "ai_generated",
    "category",
    "source_article",
    "score",
    "overseas",
    "tags"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "published_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "format": "date"
    },
    "updated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "format": "date"
    },
    "draft": {
      "type": "boolean"
    },
    "ai_generated": {
      "type": "boolean"
    },
    "under_review": {
      "type": "boolean"
    },
    "corrections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "severity",
          "description"
        ],
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "format": "date"
          },
          "severity": {
            "enum": [
              "major",
              "normal"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "issue": {
            "type": "integer"
          }
        }
      }
    },
    "category": {
      "enum": [
        "investment",
        "policy",
        "m_and_a",
        "earnings",
        "technology",
        "supply_demand"
      ],
      "description": "運用ルール書3.2。investment（投資）、policy（政策・規制）、m_and_a（M&A）、earnings（決算）、technology（技術）、supply_demand（供給・需要）。"
    },
    "source_article": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "publisher",
        "url",
        "published_on",
        "reporting"
      ],
      "description": "元記事。本文は持たない。",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "published_on": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "format": "date"
        },
        "reporting": {
          "enum": [
            "primary",
            "press",
            "speculative"
          ],
          "description": "primary（一次情報）、press（報道）、speculative（観測報道）。speculative のときは、本文に「報道によると」を書く。"
        }
      }
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "impact",
        "supply_chain",
        "novelty",
        "reliability"
      ],
      "description": "重要度の点（運用ルール書3.2）。合計は保存せず、表示のときに計算する。",
      "properties": {
        "impact": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "supply_chain": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "novelty": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "reliability": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      }
    },
    "overseas": {
      "type": "boolean"
    },
    "tags": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "companies",
        "processes",
        "themes"
      ],
      "properties": {
        "companies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          }
        },
        "unlisted_companies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "name_en": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "description": "企業マスタにない企業（FR-404）。公開後まで表示しない。"
        },
        "processes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          }
        },
        "themes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "description": "MVPでは []。"
        }
      }
    },
    "x_post": {
      "type": "string",
      "minLength": 1,
      "description": "Xの投稿文（AD-106、正式公開以降）。140字以内（URLは23字と数える）、ハッシュタグは2つまで。長さとハッシュタグの数は、別の検査で行う。"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "source_article": {
            "properties": {
              "reporting": {
                "const": "speculative"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "score": {
            "properties": {
              "reliability": {
                "maximum": 1
              }
            }
          }
        }
      }
    }
  ]
}
