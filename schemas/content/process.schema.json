{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/content/process.schema.json",
  "title": "工程（D14）の front matter",
  "description": "データ定義書（第1段階）6.1、6.5。content/processes/{slug}.md の先頭の項目（front matter）だけを検査する。本文の決まり（[S1]などの番号が sources にあること、sources の資料が本文で使われていること、元の文章を写さないこと）は、スキーマでは検査できないため、別の検査で行う。title の60字以内、description の50〜120字（どちらも暫定）は、警告の検査（V-12）で行う。ファイル名と process の一致、process が data/supply-chain.yaml の工程の slug にあること、terms の参照先の存在も、別の検査（V-02、V-04）で行う。関係する企業の一覧は企業マスタから自動で作るため、ここには書かない。easy_body は公開後の項目で、第1段階では使わない。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "process",
    "title",
    "description",
    "published_at",
    "ai_generated"
  ],
  "properties": {
    "process": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "minLength": 2,
      "maxLength": 60
    },
    "terms": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
        "minLength": 2,
        "maxLength": 60
      }
    },
    "easy_body": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "published_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "format": "date"
    },
    "updated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "format": "date"
    },
    "draft": {
      "type": "boolean"
    },
    "ai_generated": {
      "type": "boolean"
    },
    "under_review": {
      "type": "boolean"
    },
    "corrections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "severity",
          "description"
        ],
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "format": "date"
          },
          "severity": {
            "enum": [
              "major",
              "normal"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "issue": {
            "type": "integer"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "publisher"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^S[0-9]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "publisher": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https?://\\S+$"
          },
          "published_on": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "format": "date"
          },
          "accessed_on": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "format": "date"
          },
          "doc_id": {
            "type": "string",
            "pattern": "^S100[0-9A-Z]{4}$"
          },
          "pages": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "web",
              "government",
              "association",
              "book",
              "paper"
            ],
            "description": "出典の種類。book（書籍）は author と pages が必要。paper（論文）は author が必要（url は任意）。それ以外、または省略したときは url と accessed_on が必要。"
          },
          "author": {
            "type": "string",
            "minLength": 1
          },
          "edition": {
            "type": "string",
            "minLength": 1
          },
          "isbn": {
            "type": "string",
            "pattern": "^[0-9Xx-]{10,17}$"
          },
          "doi": {
            "type": "string",
            "pattern": "^10\\.[0-9]{4,9}/\\S+$"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "book"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "required": [
                "author",
                "pages"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "paper"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "required": [
                "author"
              ]
            }
          },
          {
            "if": {
              "not": {
                "properties": {
                  "kind": {
                    "enum": [
                      "book",
                      "paper"
                    ]
                  }
                },
                "required": [
                  "kind"
                ]
              }
            },
            "then": {
              "required": [
                "url",
                "accessed_on"
              ]
            }
          }
        ]
      }
    },
    "basis": {
      "type": "string",
      "enum": [
        "sources",
        "reviewed"
      ],
      "description": "解説の根拠。sources：公的機関などの公開資料から書く（既定）。reviewed：AIが一般的な説明を書き、運営者が確かめた（工程）。reviewed のときは、draft: true の間は reviewed_on と review_methods を省ける。公開（draft を外す）には、reviewed_on と review_methods が必要。"
    },
    "reviewed_on": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "format": "date",
      "description": "運営者が確かめた日（basis: reviewed で公開するとき必須）。"
    },
    "review_methods": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "book",
          "paper",
          "web",
          "operator_knowledge"
        ]
      },
      "description": "確かめた方法（複数可）。book：書籍、paper：論文、web：Webサイト、operator_knowledge：運営者の知識。operator_knowledge だけのとき（sources が空のとき）は、画面に「運営者の知識で確認」と示す。operator_knowledge を含まないときは、sources が1件以上必要。"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "basis": {
            "const": "reviewed"
          }
        },
        "required": [
          "basis"
        ]
      },
      "then": {
        "if": {
          "properties": {
            "draft": {
              "const": true
            }
          },
          "required": [
            "draft"
          ]
        },
        "else": {
          "required": [
            "reviewed_on",
            "review_methods"
          ],
          "properties": {
            "review_methods": {
              "minItems": 1
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "review_methods": {
                    "contains": {
                      "const": "operator_knowledge"
                    }
                  }
                },
                "required": [
                  "review_methods"
                ]
              },
              "else": {
                "required": [
                  "sources"
                ],
                "properties": {
                  "sources": {
                    "minItems": 1
                  }
                }
              }
            }
          ]
        }
      },
      "else": {
        "required": [
          "sources"
        ],
        "properties": {
          "sources": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
