{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/content/learn-path.schema.json",
  "title": "半導体を学ぶの体系（D17）",
  "description": "データ定義書（第1段階）6.8。content/learn/path.yaml。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fields"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "no",
          "slug",
          "title",
          "summary",
          "units"
        ],
        "properties": {
          "no": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "slug": {
            "enum": [
              "basics",
              "devices",
              "logic",
              "silicon",
              "process",
              "test",
              "facilities",
              "industry"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "units": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "ref"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "learn",
                    "process",
                    "term"
                  ]
                },
                "ref": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                }
              }
            }
          }
        }
      }
    }
  }
}
