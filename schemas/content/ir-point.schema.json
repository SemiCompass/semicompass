{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/content/ir-point.schema.json",
  "title": "IR重要ポイント（D12）",
  "description": "データ定義書（第1段階）6.3。content/ir-points/{企業のslug}/{fiscal_period_end}-q{quarter}.md の先頭の項目。本文は「## 業績の要点」「## 今期見通し」「## 注目材料」の3つの見出しで、字数の上限（要求定義書FR-307）と出典の発行元の許可（LG-06）は、プログラム（scripts/validate/）が確かめる。title と description は使わない。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "company",
    "fiscal_period_end",
    "quarter",
    "announced_on",
    "uses_quarterly_figures",
    "published_at",
    "ai_generated",
    "sources"
  ],
  "properties": {
    "company": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "企業のslug（詳細掲載で、外資系日本法人でない企業）"
    },
    "fiscal_period_end": {
      "description": "対象の決算期（年と月。例：2026-03）",
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
    },
    "quarter": {
      "description": "四半期（1〜4。4は通期）",
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "announced_on": {
      "description": "決算発表日。自動取得のデータの announcements（データ定義書5.6）と一致させる",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "format": "date"
    },
    "uses_quarterly_figures": {
      "description": "第1・第3四半期の数値を使ったか。業績のグラフの注記（FR-307）に使う",
      "type": "boolean"
    },
    "published_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "format": "date"
    },
    "updated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "format": "date"
    },
    "draft": {
      "type": "boolean"
    },
    "ai_generated": {
      "type": "boolean"
    },
    "under_review": {
      "type": "boolean"
    },
    "corrections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "severity",
          "description"
        ],
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "format": "date"
          },
          "severity": {
            "enum": [
              "major",
              "normal"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "issue": {
            "type": "integer"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "publisher"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^S[0-9]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "publisher": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https?://\\S+$"
          },
          "published_on": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "format": "date"
          },
          "accessed_on": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "format": "date"
          },
          "doc_id": {
            "type": "string",
            "pattern": "^S100[0-9A-Z]{4}$"
          },
          "pages": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "web",
              "government",
              "association",
              "book",
              "paper"
            ],
            "description": "出典の種類。book（書籍）は author と pages が必要。paper（論文）は author が必要（url は任意）。それ以外、または省略したときは url と accessed_on が必要。"
          },
          "author": {
            "type": "string",
            "minLength": 1
          },
          "edition": {
            "type": "string",
            "minLength": 1
          },
          "isbn": {
            "type": "string",
            "pattern": "^[0-9Xx-]{10,17}$"
          },
          "doi": {
            "type": "string",
            "pattern": "^10\\.[0-9]{4,9}/\\S+$"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "book"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "required": [
                "author",
                "pages"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "paper"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "required": [
                "author"
              ]
            }
          },
          {
            "if": {
              "not": {
                "properties": {
                  "kind": {
                    "enum": [
                      "book",
                      "paper"
                    ]
                  }
                },
                "required": [
                  "kind"
                ]
              }
            },
            "then": {
              "required": [
                "url",
                "accessed_on"
              ]
            }
          }
        ]
      },
      "minItems": 1
    }
  }
}
