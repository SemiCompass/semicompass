{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/data/segment-map.schema.json",
  "title": "セグメント対応表（D02）",
  "description": "データ定義書（第1段階）4.2。data/segments/{slug}.yaml。ファイル名と company の一致、xbrl_members と data/auto の突き合わせ、selection.sourceなどの出典の番号の整合は、スキーマでは検査できないため、別の検査で行う。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "company",
    "reviewed_on",
    "based_on",
    "segments",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "company": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 60
    },
    "reviewed_on": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "format": "date"
    },
    "based_on": {
      "type": "string",
      "pattern": "^S100[0-9A-Z]{4}$"
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "classification",
          "rationale"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "xbrl_members": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9]+$"
            }
          },
          "classification": {
            "enum": [
              "semiconductor",
              "partial",
              "excluded"
            ]
          },
          "rationale": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "pages"
            ],
            "properties": {
              "source": {
                "type": "string",
                "pattern": "^S[0-9]+$"
              },
              "pages": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "note": {
            "type": "string",
            "maxLength": 100
          },
          "renamed_from": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "reference_values": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fiscal_period_end",
          "period_type",
          "value_mjpy",
          "label",
          "source"
        ],
        "properties": {
          "fiscal_period_end": {
            "type": "string",
            "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
          },
          "period_type": {
            "enum": [
              "annual",
              "half"
            ]
          },
          "value_mjpy": {
            "type": "number"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "pattern": "^S[0-9]+$"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "publisher",
          "url",
          "accessed_on"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^S[0-9]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "publisher": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https?://\\S+$"
          },
          "published_on": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "format": "date"
          },
          "accessed_on": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "format": "date"
          },
          "doc_id": {
            "type": "string",
            "pattern": "^S100[0-9A-Z]{4}$"
          },
          "pages": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "corrections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "severity",
          "description"
        ],
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "format": "date"
          },
          "severity": {
            "enum": [
              "major",
              "normal"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "issue": {
            "type": "integer"
          }
        }
      }
    }
  }
}
