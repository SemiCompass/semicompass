{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/data/supply-chain.schema.json",
  "title": "工程・プロダクトの分類（D03）",
  "description": "データ定義書（第1段階）4.3。data/supply-chain.yaml。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "categories",
    "processes",
    "flow"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "categories": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slug",
          "name",
          "order"
        ],
        "properties": {
          "slug": {
            "enum": [
              "design",
              "front-end",
              "back-end",
              "materials",
              "equipment",
              "devices",
              "test"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "order": {
            "type": "integer"
          },
          "description": {
            "type": "string",
            "maxLength": 60
          }
        }
      }
    },
    "processes": {
      "type": "array",
      "minItems": 17,
      "maxItems": 17,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slug",
          "name",
          "stage",
          "order",
          "mvp",
          "short_description"
        ],
        "properties": {
          "slug": {
            "enum": [
              "circuit-design",
              "photomask",
              "wafer",
              "cleaning",
              "oxidation-diffusion",
              "deposition",
              "lithography",
              "etching",
              "ion-implantation",
              "cmp",
              "interconnect",
              "inspection-metrology",
              "dicing",
              "bonding",
              "packaging",
              "advanced-packaging",
              "final-test"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "stage": {
            "enum": [
              "design",
              "materials",
              "front-end",
              "back-end"
            ]
          },
          "order": {
            "type": "integer"
          },
          "mvp": {
            "type": "boolean"
          },
          "short_description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          }
        }
      }
    },
    "flow": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to"
        ],
        "properties": {
          "from": {
            "enum": [
              "circuit-design",
              "photomask",
              "wafer",
              "cleaning",
              "oxidation-diffusion",
              "deposition",
              "lithography",
              "etching",
              "ion-implantation",
              "cmp",
              "interconnect",
              "inspection-metrology",
              "dicing",
              "bonding",
              "packaging",
              "advanced-packaging",
              "final-test"
            ]
          },
          "to": {
            "enum": [
              "circuit-design",
              "photomask",
              "wafer",
              "cleaning",
              "oxidation-diffusion",
              "deposition",
              "lithography",
              "etching",
              "ion-implantation",
              "cmp",
              "interconnect",
              "inspection-metrology",
              "dicing",
              "bonding",
              "packaging",
              "advanced-packaging",
              "final-test"
            ]
          }
        }
      }
    }
  }
}
