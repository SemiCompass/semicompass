{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/data/events.schema.json",
  "title": "技術系のイベント（D08）",
  "description": "データ定義書（第1段階）4.6。data/events.yaml。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sources",
    "events"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "kind",
          "start_date",
          "end_date",
          "venue",
          "city",
          "organizer",
          "url",
          "source",
          "checked_on"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "exhibition",
              "conference",
              "seminar"
            ]
          },
          "start_date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "format": "date"
          },
          "end_date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "format": "date"
          },
          "venue": {
            "type": "string",
            "minLength": 1
          },
          "city": {
            "type": "string",
            "minLength": 1
          },
          "organizer": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https://\\S+$"
          },
          "source": {
            "type": "string",
            "pattern": "^S[0-9]+$"
          },
          "checked_on": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "format": "date"
          }
        }
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "publisher",
        "url",
        "accessed_on"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^S[0-9]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https?://\\S+$"
        },
        "published_on": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "format": "date"
        },
        "accessed_on": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "format": "date"
        },
        "doc_id": {
          "type": "string",
          "pattern": "^S100[0-9A-Z]{4}$"
        },
        "pages": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
