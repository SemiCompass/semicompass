{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/config/xbrl-map.schema.json",
  "title": "XBRLの対応（config/xbrl-map.yaml）",
  "description": "データ定義書（第1段階）7.8。要素の名前は、開発のときにEDINETのタクソノミで確かめて入れる。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "doc_types",
    "standards",
    "employees"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "doc_types": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[0-9]{3}$"
      },
      "additionalProperties": {
        "enum": [
          "annual_report",
          "amended_annual_report",
          "semiannual_report",
          "amended_semiannual_report"
        ]
      }
    },
    "standards": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jgaap",
        "ifrs",
        "usgaap"
      ],
      "properties": {
        "jgaap": {
          "$ref": "#/$defs/standard"
        },
        "ifrs": {
          "$ref": "#/$defs/standard"
        },
        "usgaap": {
          "$ref": "#/$defs/standard"
        }
      }
    },
    "employees": {
      "$ref": "#/$defs/candidates"
    }
  },
  "$defs": {
    "candidates": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "standard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "expected_absent"
      ],
      "properties": {
        "items": {
          "$ref": "#/$defs/candidates"
        },
        "expected_absent": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
