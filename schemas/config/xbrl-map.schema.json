{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/config/xbrl-map.schema.json",
  "title": "XBRLの対応（config/xbrl-map.yaml）",
  "description": "データ定義書（第1段階）7.8。要素の名前は、開発のときにEDINETのタクソノミで確かめて入れる。 deiは、書類の基本情報（jpdei_cor:）から、会計基準、連結の有無、期間を読むための対応（任意。7.8）。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "doc_types",
    "standards",
    "employees"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "doc_types": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[0-9]{3}$"
      },
      "additionalProperties": {
        "enum": [
          "annual_report",
          "amended_annual_report",
          "semiannual_report",
          "amended_semiannual_report"
        ]
      }
    },
    "standards": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jgaap",
        "ifrs",
        "usgaap"
      ],
      "properties": {
        "jgaap": {
          "$ref": "#/$defs/standard"
        },
        "ifrs": {
          "$ref": "#/$defs/standard"
        },
        "usgaap": {
          "$ref": "#/$defs/standard"
        }
      }
    },
    "company_exceptions": {
      "description": "企業ごとの例外（任意）。キーはEDINETコード。書類に項目がないことを確かめた企業だけを書く（例：営業利益を開示しないIFRSの企業）",
      "type": "object",
      "propertyNames": {
        "pattern": "^E[0-9]{5}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "expected_absent"
        ],
        "properties": {
          "expected_absent": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "operating_income",
                "ordinary_income",
                "net_income"
              ]
            }
          }
        }
      }
    },
    "employees": {
      "$ref": "#/$defs/candidates"
    },
    "dei": {
      "$ref": "#/$defs/dei"
    }
  },
  "$defs": {
    "candidates": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "standard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "expected_absent"
      ],
      "properties": {
        "items": {
          "$ref": "#/$defs/candidates"
        },
        "expected_absent": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "dei": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "elements",
        "accounting_standards",
        "period_types"
      ],
      "properties": {
        "elements": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "accounting_standard",
            "consolidated",
            "period_type",
            "fiscal_year_start",
            "period_end",
            "fiscal_year_end"
          ],
          "properties": {
            "accounting_standard": {
              "type": "string",
              "pattern": "^jpdei_cor:\\S+$"
            },
            "consolidated": {
              "type": "string",
              "pattern": "^jpdei_cor:\\S+$"
            },
            "period_type": {
              "type": "string",
              "pattern": "^jpdei_cor:\\S+$"
            },
            "fiscal_year_start": {
              "type": "string",
              "pattern": "^jpdei_cor:\\S+$"
            },
            "period_end": {
              "type": "string",
              "pattern": "^jpdei_cor:\\S+$"
            },
            "fiscal_year_end": {
              "type": "string",
              "pattern": "^jpdei_cor:\\S+$"
            }
          }
        },
        "accounting_standards": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "enum": [
              "jgaap",
              "ifrs",
              "usgaap"
            ]
          }
        },
        "period_types": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "enum": [
              "annual",
              "half"
            ]
          }
        }
      }
    }
  }
}
