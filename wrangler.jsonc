{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "semicompass",
  "compatibility_date": "2026-10-02",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "previews": {},
  "routes": [{ "pattern": "semicompass.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": true
}
